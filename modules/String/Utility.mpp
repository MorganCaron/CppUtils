export module CppUtils.String.Utility;

import std;

import CppUtils.Math;
import CppUtils.Type.Concept;
import CppUtils.Type.Specialization;
import CppUtils.String.Concept;

export namespace CppUtils::String
{
	template<StringView T>
	using StringFrom = std::basic_string<typename T::value_type>;

	template<String T>
	using StringViewFrom = std::basic_string_view<typename T::value_type>;

	[[nodiscard]] inline constexpr auto isEscapable(char c) noexcept -> bool
	{
		switch (c)
		{
		case '0': [[fallthrough]];
		case 'a': [[fallthrough]];
		case 'b': [[fallthrough]];
		case 'f': [[fallthrough]];
		case 'n': [[fallthrough]];
		case 'r': [[fallthrough]];
		case 't': [[fallthrough]];
		case 'v': return true;
		default: return false;
		}
	}

	static_assert(isEscapable('0'));
	static_assert(isEscapable('n'));
	static_assert(not isEscapable('A'));

	[[nodiscard]] inline constexpr auto escape(char c) noexcept -> char
	{
		switch (c)
		{
		case '0': return '\0';
		case 'a': return '\a';
		case 'b': return '\b';
		case 'f': return '\f';
		case 'n': return '\n';
		case 'r': return '\r';
		case 't': return '\t';
		case 'v': return '\v';
		default: return c;
		}
	}

	static_assert(escape('0') == '\0');
	static_assert(escape('n') == '\n');
	static_assert(escape('A') == 'A');

	[[nodiscard]] inline constexpr auto unescape(char c) noexcept -> char
	{
		switch (c)
		{
		case '\0': return '0';
		case '\a': return 'a';
		case '\b': return 'b';
		case '\f': return 'f';
		case '\n': return 'n';
		case '\r': return 'r';
		case '\t': return 't';
		case '\v': return 'v';
		default: return c;
		}
	}

	static_assert(unescape('\0') == '0');
	static_assert(unescape('\n') == 'n');
	static_assert(unescape('A') == 'A');

	[[nodiscard]] inline auto leftTrimString(std::string_view stringView) -> std::string_view
	{
		const auto it = std::ranges::find_if_not(stringView, [](const auto c) {
			return std::isspace(static_cast<unsigned char>(c));
		});
		stringView.remove_prefix(static_cast<std::size_t>(std::ranges::distance(std::ranges::begin(stringView), it)));
		return stringView;
	}

	[[nodiscard]] inline auto rightTrimString(std::string_view stringView) -> std::string_view
	{
		const auto it = std::ranges::find_if_not(std::ranges::rbegin(stringView), std::ranges::rend(stringView), [](const auto c) {
			return std::isspace(static_cast<unsigned char>(c));
		});
		stringView.remove_suffix(static_cast<std::size_t>(std::ranges::distance(std::ranges::rbegin(stringView), it)));
		return stringView;
	}

	[[nodiscard]] inline auto trimString(std::string_view stringView) -> std::string_view
	{
		return rightTrimString(leftTrimString(stringView));
	}

	[[nodiscard]] inline auto getPrintableChar(Type::Character auto c) -> std::string
	{
		using namespace std::literals;
		return std::isprint(c) ? ("'"s + c + '\'') : std::to_string(c);
	}

	[[nodiscard]] inline constexpr auto isUppercase(Type::Character auto c) noexcept -> bool
	{
		return (c >= 'A' and c <= 'Z');
	}

	[[nodiscard]] inline constexpr auto isLowercase(Type::Character auto c) noexcept -> bool
	{
		return (c >= 'a' and c <= 'z');
	}

	[[nodiscard]] inline constexpr auto toLowercase(Type::Character auto c) noexcept -> decltype(c)
	{
		return static_cast<decltype(c)>(isUppercase(c) ? c + ('a' - 'A') : c);
	}

	[[nodiscard]] inline constexpr auto toUppercase(Type::Character auto c) noexcept -> decltype(c)
	{
		return static_cast<decltype(c)>(isLowercase(c) ? c - ('a' - 'A') : c);
	}

	[[nodiscard]] inline constexpr auto toLowercase(GenericText auto&& originalString)
		-> std::basic_string<TextCharT<decltype(originalString)>>
	{
		using CharacterType = TextCharT<decltype(originalString)>;
		auto result = std::basic_string<CharacterType>{std::forward<decltype(originalString)>(originalString)};
		for (auto& character : result)
			character = toLowercase(character);
		return result;
	}

	[[nodiscard]] inline constexpr auto toUppercase(GenericText auto&& originalString)
		-> std::basic_string<TextCharT<decltype(originalString)>>
	{
		using CharacterType = TextCharT<decltype(originalString)>;
		auto result = std::basic_string<CharacterType>{std::forward<decltype(originalString)>(originalString)};
		for (auto& character : result)
			character = toUppercase(character);
		return result;
	}

	[[nodiscard]] inline auto formatValue(const auto& value) -> std::string
	{
		using namespace std::literals;
		using DecayedType = std::remove_cvref_t<decltype(value)>;

		const auto formatSubElement = [](const auto& element) -> std::string {
			using ElementType = std::remove_cvref_t<decltype(element)>;
			if constexpr (GenericText<ElementType>)
				return std::format("\"{}\"", element);
			else if constexpr (Type::Character<ElementType>)
				return std::format("'{}'", element);
			else
				return formatValue(element);
		};

		if constexpr (requires { std::variant_size<DecayedType>::value; })
		{
			if constexpr (ExtensivelyPrintable<DecayedType>)
			{
				return std::visit([](const auto& alternative) -> std::string {
					return formatValue(alternative);
				}, value);
			}
			else
			{
				return "<non printable>";
			}
		}
		else if constexpr (requires { typename std::tuple_size<DecayedType>::type; } and not std::ranges::input_range<DecayedType>)
		{
			if constexpr (ExtensivelyPrintable<DecayedType>)
			{
				auto formattedString = "("s;
				auto isFirst = true;
				std::apply([&](const auto&... elements) {
					const auto formatElement = [&](const auto& element) {
						if (not isFirst)
							formattedString += ", ";
						isFirst = false;
						formattedString += formatSubElement(element);
					};
					(formatElement(elements), ...);
				}, value);
				formattedString += ")";
				return formattedString;
			}
			else
			{
				return "<non printable>";
			}
		}
		else if constexpr (DirectlyPrintable<DecayedType>)
		{
			if constexpr (std::same_as<DecayedType, std::byte>)
				return std::format("0x{:02X}", std::to_integer<unsigned int>(value));
			else
				return std::format("{}", value);
		}
		else if constexpr (requires { static_cast<bool>(value); *value; } and not GenericText<DecayedType>)
		{
			using DereferencedType = std::remove_cvref_t<decltype(*value)>;
			if constexpr (ExtensivelyPrintable<DereferencedType>)
			{
				if (not static_cast<bool>(value))
				{
					if constexpr (std::is_pointer_v<DecayedType> or std::same_as<DecayedType, std::nullptr_t> or requires { value.get(); })
						return "nullptr";
					else if constexpr (requires { value.error(); })
						return std::format("<error: {}>", formatValue(value.error()));
					else
						return "nullopt";
				}
				return formatValue(*value);
			}
			else
			{
				return "<non printable>";
			}
		}
		else if constexpr (std::ranges::input_range<DecayedType> and not GenericText<DecayedType>)
		{
			if constexpr (not std::same_as<std::ranges::range_value_t<DecayedType>, DecayedType>
				and ExtensivelyPrintable<std::ranges::range_value_t<DecayedType>>)
			{
				auto formattedString = std::string{"["};
				auto isFirst = true;
				for (const auto& element : value)
				{
					if (not isFirst)
						formattedString += ", ";
					isFirst = false;
					formattedString += formatSubElement(element);
				}
				formattedString += "]";
				return formattedString;
			}
			else
			{
				return "<non printable>";
			}
		}
		else
		{
			return "<non printable>";
		}
	}

	[[nodiscard]] inline constexpr auto toAscii(const GenericText auto& string) -> std::string
	{
		auto asciiString = std::string{};
		std::ranges::transform(string, std::back_inserter(asciiString), [](auto c) -> char {
			return c < 128 ? static_cast<char>(c) : '?';
		});
		return asciiString;
	}

	// Todo: gérer les flottants
	[[nodiscard]] inline constexpr auto getNumberLength(std::integral auto number, std::size_t base = 10) -> std::size_t
	{
		if (number == 0)
			return 1uz;
		auto length = 0uz;
		if constexpr (std::signed_integral<decltype(number)>)
			if (number < 0)
				++length;
		for (auto unsignedNumber = Math::absolute(number); unsignedNumber; unsignedNumber /= base)
			++length;
		return length;
	}

	// Todo: gérer les flottants
	template<std::size_t base = 10, class CharT = char>
	requires (base > 1 and base < 37)
	[[nodiscard]] inline constexpr auto toString(std::integral auto number) -> std::basic_string<CharT>
	{
		if (number == 0)
			return std::basic_string<CharT>{"0"};
		auto digits = std::basic_string_view<CharT>{"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"};
		auto string = std::basic_string<CharT>(getNumberLength(number, base), ' ');
		if constexpr (std::signed_integral<decltype(number)>)
			if (number < 0)
				string[0] = '-';
		auto unsignedNumber = Math::absolute(number);
		for (auto i = std::ranges::size(string); unsignedNumber != 0; unsignedNumber /= base)
			string[--i] = digits[unsignedNumber % base];
		return string;
	}

	[[nodiscard]] inline auto split(std::string_view string, std::string_view separator) -> decltype(auto)
	{
		return string | std::ranges::views::split(separator) | std::ranges::to<std::vector<std::string>>();
	}

	template<std::size_t Size>
	struct FixedString final
	{
		char data[Size]{};

		constexpr FixedString(const char (&string)[Size]) noexcept
		{
			std::ranges::copy_n(string, Size, data);
		}

		template<std::size_t OtherSize>
		[[nodiscard]] constexpr auto operator+(const char (&other)[OtherSize]) const noexcept -> FixedString<Size + OtherSize - 1>
		{
			char result[Size + OtherSize - 1]{};
			std::ranges::copy_n(data, Size - 1, result);
			std::ranges::copy_n(other, OtherSize, result + Size - 1);
			return result;
		}

		[[nodiscard]] constexpr operator std::string_view() const noexcept
		{
			return {data, Size - 1};
		}
	};

	template<std::size_t Size>
	FixedString(const char (&)[Size]) -> FixedString<Size>;

	static_assert(std::string_view{FixedString{"foo"}} == "foo");
	static_assert(std::string_view{FixedString{"foo"} + "bar"} == "foobar");

	[[nodiscard]] inline constexpr auto excelColumnToPosition(std::string_view excelColumn) noexcept -> std::size_t
	{
		auto base = 26uz;
		auto position = 0uz;
		for (auto c : excelColumn)
			if (c >= 'A' and c <= 'Z')
				position = position * base + static_cast<std::size_t>(c - 'A') + 1;
			else if (c >= 'a' and c <= 'z')
				position = position * base + static_cast<std::size_t>(c - 'a') + 1;
		return position - 1;
	}

	namespace Literals
	{
		[[nodiscard]] inline constexpr auto operator""_excelColumn(const char* cString, std::size_t size) noexcept -> std::size_t
		{
			return excelColumnToPosition(std::string_view{cString, size});
		}

		static_assert("A"_excelColumn == 0);
		static_assert("B"_excelColumn == 1);
		static_assert("C"_excelColumn == 2);
		static_assert("Z"_excelColumn == 25);
		static_assert("AA"_excelColumn == 26);
		static_assert("AB"_excelColumn == 27);
		static_assert("BA"_excelColumn == 52);
	}

	[[nodiscard]] inline auto toHexString(std::span<const std::byte> data) -> std::string
	{
		auto result = std::string{};
		result.reserve(std::ranges::size(data) * 2);
		for (auto byte : data)
			result += std::format("{:02x}", static_cast<std::uint8_t>(byte));
		return result;
	}

	[[nodiscard]] inline auto toHexString(std::string_view string) -> std::string
	{
		return toHexString(std::as_bytes(std::span{string}));
	}

	[[nodiscard]] inline auto fromHexString(std::string_view string) -> std::vector<std::byte>
	{
		const auto stringLength = std::ranges::size(string);
		auto result = std::vector<std::byte>{};
		result.reserve(stringLength / 2);
		for (auto i = 0uz; i + 1 < stringLength; i += 2)
		{
			auto value = std::uint8_t{0};
			const auto [endPointer, errorCode] = std::from_chars(std::ranges::data(string) + i, std::ranges::data(string) + i + 2, value, 16);
			if (errorCode == std::errc{})
				result.push_back(static_cast<std::byte>(value));
		}
		return result;
	}
}
