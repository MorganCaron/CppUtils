module;

#include <CppUtils/System/Compiler.hpp>

export module CppUtils.Container.BidirectionalMap;

import std;
import CppUtils.Container.MultiKeyMap;

export namespace CppUtils::Container
{
	template<class Lhs, class Rhs>
	class BidirectionalMap final
	{
	public:
		using Pair = std::pair<Lhs, Rhs>;
		using Map = MultiKeyMap<
			TaggedKey<"Left", Lhs>,
			TaggedKey<"Right", Rhs>,
			void>;

		using value_type = typename Map::value_type;
		using size_type = std::size_t;
		using difference_type = std::ptrdiff_t;
		using reference = typename Map::reference;
		using const_reference = typename Map::const_reference;
		using pointer = typename Map::pointer;
		using const_pointer = typename Map::const_pointer;
		using iterator = typename Map::const_iterator;
		using const_iterator = typename Map::const_iterator;

		inline BidirectionalMap() = default;

		// Complexité : O(n) au runtime
		inline explicit BidirectionalMap(auto&&... pairs)
		requires (sizeof...(pairs) > 0 and (std::same_as<std::remove_cvref_t<decltype(pairs)>, Pair> and ...))
		{
			(insert(std::forward<decltype(pairs)>(pairs)), ...);
		}

		// Complexité : O(n) au runtime
		template<std::input_iterator InputIterator>
		inline BidirectionalMap(InputIterator first, InputIterator last)
		{
			for (; first != last; ++first)
				insert(*first);
		}

		// Complexité : O(n) au runtime
		explicit inline BidirectionalMap(std::initializer_list<Pair> values)
		{
			for (const auto& value : values)
				insert(value);
		}

		[[nodiscard]] inline constexpr auto begin(this auto&& self) noexcept -> decltype(auto)
		{
			return std::ranges::cbegin(self.m_map);
		}

		[[nodiscard]] inline constexpr auto cbegin() const noexcept -> decltype(auto)
		{
			return std::ranges::cbegin(m_map);
		}

		[[nodiscard]] inline constexpr auto end(this auto&& self) noexcept -> decltype(auto)
		{
			return std::ranges::cend(self.m_map);
		}

		[[nodiscard]] inline constexpr auto cend() const noexcept -> decltype(auto)
		{
			return std::ranges::cend(m_map);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline constexpr auto empty() const noexcept -> bool
		{
			return std::ranges::empty(m_map);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline constexpr auto size() const noexcept -> std::size_t
		{
			return std::ranges::size(m_map);
		}

		// Complexité : O(n) au runtime
		inline auto clear() noexcept -> void
		{
			m_map.clear();
		}

		// Complexité : O(1) au runtime
		inline auto insert(Lhs lhs, Rhs rhs) -> bool
		{
			return m_map.insert(std::move(lhs), std::move(rhs)).second;
		}

		// Complexité : O(1) au runtime
		inline auto insert(Pair value) -> bool
		{
			return insert(std::move(value.first), std::move(value.second));
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto findLeft(const Lhs& lhs) const noexcept -> const_iterator
		{
			return m_map.template find<"Left">(lhs);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto findRight(const Rhs& rhs) const noexcept -> const_iterator
		{
			return m_map.template find<"Right">(rhs);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto containsLeft(const Lhs& lhs) const noexcept -> bool
		{
			return m_map.template contains<"Left">(lhs);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto containsRight(const Rhs& rhs) const noexcept -> bool
		{
			return m_map.template contains<"Right">(rhs);
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto left(const Lhs& lhs) const -> const Rhs&
		{
			auto iterator = m_map.template find<"Left">(lhs);
			if (iterator == std::ranges::cend(m_map))
				throw std::runtime_error{"Missing key in BidirectionalMap"};
			return iterator->template key<1>();
		}

		// Complexité : O(1) au runtime
		[[nodiscard]] inline auto right(const Rhs& rhs) const -> const Lhs&
		{
			auto iterator = m_map.template find<"Right">(rhs);
			if (iterator == std::ranges::cend(m_map))
				throw std::runtime_error{"Missing key in BidirectionalMap"};
			return iterator->template key<0>();
		}

		// Complexité : O(1) au runtime
		inline auto eraseLeft(const Lhs& lhs) noexcept -> bool
		{
			return m_map.template erase<"Left">(lhs);
		}

		// Complexité : O(1) au runtime
		inline auto eraseRight(const Rhs& rhs) noexcept -> bool
		{
			return m_map.template erase<"Right">(rhs);
		}

	private:
		Map m_map;
	};
}
