export module CppUtils.Container.MeshNetwork;

import std;
import CppUtils.Container.FlatHashMap;
import CppUtils.Container.NetworkPtr;
import CppUtils.Container.SafeShared;
import CppUtils.Thread.SharedLocker;
import CppUtils.Thread.SharedPtr;
import CppUtils.Type.Utility;

export namespace CppUtils::Container
{
	/**
	 * @brief Thread-safe handle to a node in a non-hierarchical cyclic mesh graph.
	 * @tparam Key Branch key type.
	 * @tparam Value Payload value type stored inside each node.
	 * @tparam Policy Optional lazy-resolution policy type (e.g. `MeshPager::Policy`), or `void` when disabled.
	 */
	template<class Key, class Value, class Policy = void>
	class MeshNodePtr final
	{
	private:
		struct MeshNode;

	public:
		/// @brief Link entry stored inside a node's branch.
		struct Link final
		{
			using WeakPtr = SafeWeak<NetworkPtr<MeshNode>>;

			std::size_t targetId = 0; ///< Numeric identifier of the target node (0 when unassigned).
			mutable WeakPtr cache; ///< Weak reference cache to the in-memory target node.

			/// @brief Compares two links by numeric target identifier.
			[[nodiscard]] auto operator==(const Link& other) const noexcept -> bool
			{
				if (targetId != 0uz and other.targetId != 0uz)
					return targetId == other.targetId;
				return false;
			}
		};

	private:
		struct MeshNode final
		{
			using WeakPtr = SafeWeak<NetworkPtr<MeshNode>>;
			using VectorLocker = Thread::SharedLocker<std::vector<Link>>;
			using Branches = Container::FlatHashMap<Key, SafeShared<std::vector<Link>>>;

			std::size_t id = 0;
			Thread::SharedLocker<Value> value;
			Thread::SharedLocker<Branches> branches;
			[[no_unique_address]] std::conditional_t<std::is_void_v<Policy>, std::monostate, Policy> policy;

			explicit inline constexpr MeshNode(auto&&... args):
				value{std::forward<decltype(args)>(args)...}
			{}
		};

		using SharedPtr = SafeShared<NetworkPtr<MeshNode>>;
		using WeakPtr = MeshNode::WeakPtr;
		using VectorLocker = MeshNode::VectorLocker;
		using Branches = MeshNode::Branches;

	private:
		static constexpr auto attach(
			const MeshNodePtr& parent,
			Type::In<Key> key,
			const MeshNodePtr& child,
			SafeShared<std::vector<Link>> existingBranchLinks = nullptr) -> void
		{
			auto attachImplementation = [&](auto& parentNetworkPtr, auto& childNetworkPtr) {
				auto branchLinks = SafeShared<std::vector<Link>>{};
				{
					auto branchesAccessor = parentNetworkPtr.value.branches.uniqueAccess();
					auto& entry = branchesAccessor.value()[key];
					if (not entry)
						entry = existingBranchLinks ? existingBranchLinks : makeSafeShared<std::vector<Link>>();
					branchLinks = entry;
				}

				{
					auto vectorAccessor = branchLinks->uniqueAccess();
					if (std::ranges::none_of(vectorAccessor.value(), [&](const auto& link) {
						if (link.targetId != 0uz and childNetworkPtr.value.id != 0uz)
							return link.targetId == childNetworkPtr.value.id;
						return Thread::ownerEqual(link.cache, child.m_node);
					}))
						vectorAccessor->push_back(Link{childNetworkPtr.value.id, child.m_node});
				}
				parentNetworkPtr.attachChild(childNetworkPtr);
			};

			if (parent == child)
			{
				auto accessor = parent.m_node->uniqueAccess();
				attachImplementation(accessor.value(), accessor.value());
			}
			else
			{
				auto accessor = Thread::MultipleAccessor{*parent.m_node, *child.m_node};
				attachImplementation(std::get<0>(accessor.values), std::get<1>(accessor.values));
			}
		}

		static constexpr auto detach(const MeshNodePtr& parent, Type::In<Key> key, const MeshNodePtr& child) -> void
		{
			auto detachImplementation = [&](auto& parentNetworkPtr, auto& childNetworkPtr) {
				auto branchesAccessor = parentNetworkPtr.value.branches.uniqueAccess();
				if (auto branchIterator = branchesAccessor->find(key); branchIterator != std::ranges::cend(branchesAccessor.value()))
				{
					auto branchLinks = branchIterator->second;
					auto vectorAccessor = branchLinks->uniqueAccess();
					auto& vector = vectorAccessor.value();
					auto matches = [&](const auto& link) {
						if (link.targetId != 0uz and childNetworkPtr.value.id != 0uz)
							return link.targetId == childNetworkPtr.value.id;
						return Thread::ownerEqual(link.cache, child.m_node);
					};
					if (auto it = std::ranges::find_if(vector, matches); it != std::ranges::cend(vector))
					{
						vector.erase(it);
						parentNetworkPtr.detachChild(childNetworkPtr);
					}

					if (std::ranges::empty(vector))
						branchesAccessor->erase(branchIterator);
				}
			};

			if (parent == child)
			{
				auto accessor = parent.m_node->uniqueAccess();
				detachImplementation(accessor.value(), accessor.value());
			}
			else
			{
				auto accessor = Thread::MultipleAccessor{*parent.m_node, *child.m_node};
				detachImplementation(std::get<0>(accessor.values), std::get<1>(accessor.values));
			}
		}

		static constexpr auto detach(const MeshNodePtr& parent, Type::In<Key> key) -> void
		{
			auto children = std::vector<MeshNodePtr>{};
			{
				auto nodeAccessor = parent.m_node->sharedAccess();
				auto branchesAccessor = nodeAccessor->value.branches.sharedAccess();
				if (auto branchIterator = branchesAccessor->find(key); branchIterator != std::ranges::cend(branchesAccessor.value()))
					for (auto vectorAccessor = branchIterator->second->sharedAccess(); auto& link : vectorAccessor.value())
					{
						if (auto shared = link.cache.lock())
							children.push_back(MeshNodePtr{shared});
						else if constexpr (not std::is_void_v<Policy>)
							if (link.targetId != 0uz)
								if (auto resolved = nodeAccessor->value.policy.resolve(link.targetId))
									children.push_back(resolved);
					}
			}
			for (auto& child : children)
				detach(parent, key, child);
		}

		static constexpr auto attach(
			const Key& firstKey,
			const MeshNodePtr& firstNode,
			const Key& secondKey,
			const MeshNodePtr& secondNode,
			SafeShared<std::vector<Link>> firstNodeBranchLinks = nullptr,
			SafeShared<std::vector<Link>> secondNodeBranchLinks = nullptr) -> void
		{
			if (firstNode.m_node->sharedAccess()->getDistanceFromRoot() == std::numeric_limits<std::size_t>::max())
			{
				attach(secondNode, firstKey, firstNode, secondNodeBranchLinks);
				attach(firstNode, secondKey, secondNode, firstNodeBranchLinks);
			}
			else
			{
				attach(firstNode, secondKey, secondNode, firstNodeBranchLinks);
				attach(secondNode, firstKey, firstNode, secondNodeBranchLinks);
			}
		}

		static constexpr auto detach(const Key& firstKey, const MeshNodePtr& firstNode, const Key& secondKey, const MeshNodePtr& secondNode) -> void
		{
			detach(firstNode, secondKey, secondNode);
			detach(secondNode, firstKey, firstNode);
		}

	public:
		/**
		 * @brief Proxy view over a named branch of a `MeshNodePtr`, holding an RAII lock.
		 * @tparam IsConst `true` for read-only shared access (`ConstBranch`), `false` for mutable unique access (`MutableBranch`).
		 */
		template<bool IsConst>
		class Branch final
		{
		public:
			using VectorAccessor = std::conditional_t<IsConst,
				Thread::ReadOnlyAccessor<std::vector<Link>>,
				Thread::Accessor<std::vector<Link>, Thread::SharedMutex>>;

			/// @brief Constructs an empty, unbound branch proxy.
			constexpr Branch() = default;

			/// @brief Constructs a branch proxy bound to a parent node, key, and link vector accessor.
			constexpr Branch(MeshNodePtr parent, Key key, SafeShared<std::vector<Link>> branchLinks, VectorAccessor vectorAccessor):
				m_parent{std::move(parent)}, m_key{std::move(key)},
				m_branchLinks{std::move(branchLinks)},
				m_vectorAccessor{std::move(vectorAccessor)}
			{}

		private:
			[[nodiscard]] constexpr auto getVectorAccessor(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) -> auto&
			{
				if (not self.m_vectorAccessor) [[unlikely]]
				{
					if constexpr (IsConst)
						self.m_vectorAccessor = self.m_branchLinks->sharedAccess();
					else
						self.m_vectorAccessor = self.m_branchLinks->uniqueAccess();
				}
				return self.m_vectorAccessor.value();
			}

		public:
			/// @brief Returns the number of links currently stored on this branch.
			[[nodiscard]] constexpr auto size() const noexcept -> std::size_t
			{
				if (not m_branchLinks) [[unlikely]]
					return 0uz;
				return std::ranges::size(getVectorAccessor().value());
			}

			/// @brief Checks whether this branch has no links.
			[[nodiscard]] constexpr auto empty() const noexcept -> bool { return size() == 0uz; }

			/**
			 * @brief Checks whether `node` is linked on this branch.
			 * @param node Target node to search for.
			 * @return `true` if `node` is present on this branch.
			 */
			[[nodiscard]] constexpr auto contains(const MeshNodePtr& node) const -> bool
			{
				if (not m_branchLinks) [[unlikely]]
					return false;
				return std::ranges::any_of(getVectorAccessor().value(), [&](const auto& link) {
					if (link.targetId != 0uz and node.getId() != 0uz)
						return link.targetId == node.getId();
					return Thread::ownerEqual(link.cache, node.m_node);
				});
			}

			/// @brief Detaches all target nodes from this branch.
			constexpr auto clear() -> void
			requires (not IsConst)
			{
				m_vectorAccessor.reset();
				MeshNodePtr::detach(m_parent, m_key);
			}

			/**
			 * @brief Retrieves the target node at `index`, resolving via `Policy` if unloaded.
			 * @param index Position in the branch.
			 * @return The target `MeshNodePtr` on success, or an error message if invalid/out of bounds/expired.
			 */
			[[nodiscard]] constexpr auto operator[](std::size_t index) const -> std::expected<MeshNodePtr, std::string_view>
			{
				using namespace std::literals;
				if (not m_branchLinks) [[unlikely]]
					return std::unexpected{"Branch is no longer valid"sv};
				auto& vectorAccessor = getVectorAccessor();
				if (index >= std::ranges::size(vectorAccessor.value())) [[unlikely]]
					return std::unexpected{"Branch index out of bounds"sv};
				const auto& link = vectorAccessor.value()[index];
				if (auto sharedNode = link.cache.lock())
					return MeshNodePtr{sharedNode};

				if constexpr (not std::is_void_v<Policy>)
				{
					if (m_parent.m_node and link.targetId != 0uz)
					{
						auto nodeAccessor = m_parent.m_node->sharedAccess();
						if (auto resolved = nodeAccessor->value.policy.resolve(link.targetId))
						{
							link.cache = resolved.m_node;
							return resolved;
						}
					}
				}
				return std::unexpected{"Failed to lock weak pointer for branch. Node might have been deleted"sv};
			}

			/**
			 * @brief Creates a link from this branch to `other`.
			 * @param other Target child node to attach.
			 * @return Reference to `other`, for chained linking.
			 * @throws std::logic_error if the parent node is not connected to any root.
			 */
			constexpr auto operator>>(const MeshNodePtr& other) -> const MeshNodePtr&
			requires (not IsConst)
			{
				auto branchLinks = m_branchLinks;
				m_vectorAccessor.reset();
				MeshNodePtr::attach(m_parent, m_key, other, branchLinks);
				return other;
			}

			/**
			 * @brief Creates a link from this branch to the parent node of `other`.
			 * @param other Target branch whose parent node is attached.
			 * @return Rvalue reference to `other` for chained branch linking.
			 */
			constexpr auto operator>>(Branch<false>&& other) -> Branch<false>&&
			requires (not IsConst)
			{
				auto branchLinks = m_branchLinks;
				m_vectorAccessor.reset();
				MeshNodePtr::attach(m_parent, m_key, other.m_parent, branchLinks);
				return std::move(other);
			}

			/**
			 * @brief Detaches a specific target node `other` from this branch.
			 * @param other Target node to disconnect.
			 */
			constexpr auto operator-(const MeshNodePtr& other) -> void
			requires (not IsConst)
			{
				m_vectorAccessor.reset();
				MeshNodePtr::detach(m_parent, m_key, other);
			}

			/**
			 * @brief Creates reciprocal bidirectional links between this branch and `other`.
			 * @param other Target branch to link with.
			 */
			template<bool OtherIsConst>
			constexpr auto operator&(const Branch<OtherIsConst>& other) -> void
			requires (not IsConst)
			{
				auto branchLinks = m_branchLinks;
				auto otherBranchLinks = other.m_branchLinks;
				m_vectorAccessor.reset();
				other.m_vectorAccessor.reset();
				MeshNodePtr::attach(other.m_key, m_parent, m_key, other.m_parent, otherBranchLinks, branchLinks);
			}

			/**
			 * @brief Detaches reciprocal bidirectional links between this branch and `other`.
			 * @param other Target branch to detach from.
			 */
			template<bool OtherIsConst>
			constexpr auto operator/(const Branch<OtherIsConst>& other) -> void
			requires (not IsConst)
			{
				m_vectorAccessor.reset();
				other.m_vectorAccessor.reset();
				MeshNodePtr::detach(other.m_key, m_parent, m_key, other.m_parent);
			}

			/// @brief Returns the first node on this branch, or an error if empty/expired.
			[[nodiscard]] constexpr auto front() const -> std::expected<MeshNodePtr, std::string_view> { return (*this)[0]; }

			/// @brief Returns the last node on this branch, or an error if empty/expired.
			[[nodiscard]] constexpr auto back() const -> std::expected<MeshNodePtr, std::string_view> { return (*this)[size() - 1]; }

			/// @brief Random-access iterator yielding `MeshNodePtr` handles along a branch.
			struct Iterator final
			{
				using iterator_category = std::random_access_iterator_tag;
				using value_type = MeshNodePtr;
				using difference_type = std::ptrdiff_t;
				using pointer = void;
				using reference = MeshNodePtr;

				const Branch* branch = nullptr;
				std::size_t index = 0uz;

				[[nodiscard]] constexpr auto operator*() const -> MeshNodePtr { return (*branch)[index].value_or(MeshNodePtr{}); }

				constexpr auto operator++() -> Iterator&
				{
					++index;
					return *this;
				}
				constexpr auto operator++(int) -> Iterator
				{
					auto oldValue = *this;
					++index;
					return oldValue;
				}
				constexpr auto operator--() -> Iterator&
				{
					--index;
					return *this;
				}
				constexpr auto operator--(int) -> Iterator
				{
					auto oldValue = *this;
					--index;
					return oldValue;
				}

				constexpr auto operator+=(difference_type n) -> Iterator&
				{
					index = static_cast<std::size_t>(static_cast<difference_type>(index) + n);
					return *this;
				}
				constexpr auto operator-=(difference_type n) -> Iterator&
				{
					index = static_cast<std::size_t>(static_cast<difference_type>(index) - n);
					return *this;
				}

				[[nodiscard]] friend constexpr auto operator+(Iterator it, difference_type n) -> Iterator
				{
					it += n;
					return it;
				}
				[[nodiscard]] friend constexpr auto operator+(difference_type n, Iterator it) -> Iterator
				{
					it += n;
					return it;
				}
				[[nodiscard]] friend constexpr auto operator-(Iterator it, difference_type n) -> Iterator
				{
					it -= n;
					return it;
				}
				[[nodiscard]] friend constexpr auto operator-(const Iterator& lhs, const Iterator& rhs) -> difference_type
				{
					return static_cast<difference_type>(lhs.index) - static_cast<difference_type>(rhs.index);
				}

				[[nodiscard]] constexpr auto operator[](difference_type n) const -> MeshNodePtr { return *(*this + n); }

				[[nodiscard]] constexpr auto operator<=>(const Iterator& other) const = default;
			};

			static_assert(std::random_access_iterator<Iterator>);

			/// @brief Returns an iterator to the first link on this branch.
			[[nodiscard]] constexpr auto begin() const [[clang::lifetimebound, msvc::lifetimebound]] { return Iterator{this, 0uz}; }

			/// @brief Returns a sentinel iterator past the last link on this branch.
			[[nodiscard]] constexpr auto end() const [[clang::lifetimebound, msvc::lifetimebound]] { return Iterator{this, size()}; }

		private:
			MeshNodePtr m_parent;
			Key m_key;
			SafeShared<std::vector<Link>> m_branchLinks;
			mutable std::optional<VectorAccessor> m_vectorAccessor;

			friend class MeshNodePtr;
		};

		/// @brief Read-write branch proxy holding a unique lock.
		using MutableBranch = Branch<false>;

		/// @brief Read-only branch proxy holding a shared lock.
		using ConstBranch = Branch<true>;

		/**
		 * @brief Creates a root node that keeps reachable subgraphs alive.
		 * @param args Arguments forwarded to construct `Value`.
		 * @return Handle to the newly created root node.
		 */
		[[nodiscard]] static constexpr auto makeRoot(auto&&... args) -> MeshNodePtr
		{
			return MeshNodePtr{NetworkPtr<MeshNode>::makeRoot(std::forward<decltype(args)>(args)...)};
		}

		/**
		 * @brief Creates a standalone node (unattached until linked from a rooted node).
		 * @param args Arguments forwarded to construct `Value`.
		 * @return Handle to the newly created node.
		 */
		[[nodiscard]] static constexpr auto make(auto&&... args) -> MeshNodePtr
		{
			return MeshNodePtr{NetworkPtr<MeshNode>::make(std::forward<decltype(args)>(args)...)};
		}

		/// @brief Constructs an empty (null) `MeshNodePtr`.
		constexpr MeshNodePtr() = default;

		/// @brief Constructs a `MeshNodePtr` from an existing underlying `SharedPtr`.
		explicit constexpr MeshNodePtr(SharedPtr node): m_node{std::move(node)} {}

		/// @brief Checks instance identity (whether both handles point to the same node in memory).
		[[nodiscard]] constexpr auto operator==(const MeshNodePtr& other) const noexcept -> bool
		{
			return Thread::ownerEqual(m_node, other.m_node);
		}

		/// @brief Returns `true` if this handle references a valid node.
		explicit constexpr operator bool() const noexcept { return m_node != nullptr; }

		/**
		 * @brief Accesses the branch identified by `key`.
		 * @details Creates the branch if absent on a mutable handle (`MutableBranch`), or performs a read-only lookup on a `const` handle (`ConstBranch`).
		 * @param key Branch identifier.
		 * @return A `Branch` proxy holding an RAII lock on the branch.
		 * @throws std::runtime_error if the handle is null, or `std::out_of_range` on a `const` handle when `key` is missing.
		 */
		[[nodiscard]] constexpr auto operator[](this auto&& self, Type::In<Key> key)
		{
			using SelfType = std::remove_reference_t<decltype(self)>;
			if (not self.m_node)
				throw std::runtime_error{"MeshNodePtr::operator[]: Invalid MeshNodePtr"};

			if constexpr (std::is_const_v<SelfType>)
			{
				auto mapAccessor = self.m_node->sharedAccess()->value.branches.sharedAccess();
				auto branchLinksPtr = mapAccessor->at(key);
				return ConstBranch{self, key, branchLinksPtr, branchLinksPtr->sharedAccess()};
			}
			auto branchLinksPtr = SafeShared<std::vector<Link>>{};
			{
				auto nodeAccessor = self.m_node->uniqueAccess();
				auto mapAccessor = nodeAccessor->value.branches.uniqueAccess();
				auto& entry = mapAccessor.value()[key];
				if (not entry)
					entry = makeSafeShared<std::vector<Link>>();
				branchLinksPtr = entry;
			}
			return MutableBranch{self, key, branchLinksPtr, branchLinksPtr->uniqueAccess()};
		}

		/**
		 * @brief Safely looks up a read-only branch without throwing on missing keys.
		 * @param key Branch identifier.
		 * @return `ConstBranch` on success, or an error string if the handle is invalid or `key` is absent.
		 */
		[[nodiscard]] constexpr auto at(Type::In<Key> key) const -> std::expected<ConstBranch, std::string_view>
		{
			using namespace std::literals;

			if (not m_node)
				return std::unexpected{"MeshNodePtr::at(): Invalid MeshNodePtr"sv};

			auto branchesAccessor = m_node->sharedAccess()->value.branches.sharedAccess();
			if (auto branchIterator = branchesAccessor->find(key); branchIterator != std::ranges::cend(branchesAccessor.value())) [[likely]]
			{
				auto branchLinksPtr = branchIterator->second;
				return ConstBranch{*this, key, branchLinksPtr, branchLinksPtr->sharedAccess()};
			}

			return std::unexpected{"MeshNodePtr::at(): Key not found"sv};
		}

		/// @brief Checks whether a branch with `key` exists on this node.
		[[nodiscard]] constexpr auto contains(Type::In<Key> key) const -> bool
		{
			if (not m_node)
				return false;
			auto nodeAccessor = m_node->sharedAccess();
			return nodeAccessor->value.branches.sharedAccess()->contains(key);
		}

		/// @brief Returns the shortest hop distance from any root node (or `std::numeric_limits<std::size_t>::max()` if unreachable).
		[[nodiscard]] constexpr auto getDistanceFromRoot() const -> std::size_t
		{
			if (not m_node)
				return std::numeric_limits<std::size_t>::max();
			return m_node->sharedAccess()->getDistanceFromRoot();
		}

		/// @brief Returns the numeric identifier assigned to this node (0 if unassigned).
		[[nodiscard]] constexpr auto getId() const noexcept -> std::size_t
		{
			if (not m_node)
				return 0;
			return m_node->sharedAccess()->value.id;
		}

		/// @brief Assigns a numeric identifier to this node.
		constexpr auto setId(std::size_t newId) const -> void
		{
			if (m_node)
				m_node->uniqueAccess()->value.id = newId;
		}

		/// @brief Attaches or updates the lazy-resolution policy on this node.
		constexpr auto setPolicy(std::conditional_t<std::is_void_v<Policy>, int, Policy> policy) const -> void
		requires (not std::is_void_v<Policy>)
		{
			if (m_node)
				m_node->uniqueAccess()->value.policy = std::move(policy);
		}

		/// @brief Provides pointer-like access to the underlying `SharedLocker<NetworkPtr<MeshNode>>`.
		[[nodiscard]] constexpr auto operator->(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]])
		{
			return std::addressof(std::forward_like<decltype(self)>(*self.m_node));
		}

		/// @brief Dereferences the underlying `SharedLocker<NetworkPtr<MeshNode>>`.
		[[nodiscard]] constexpr auto operator*(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) -> decltype(auto)
		{
			return std::forward_like<decltype(self)>(*self.m_node);
		}

		/// @brief Updates the node's payload value in a thread-safe manner.
		constexpr auto setValue(auto&& newValue) const -> void
		{
			auto nodeAccessor = m_node->uniqueAccess();
			auto& meshNode = nodeAccessor->value;
			meshNode.value.uniqueAccess().value() = std::forward<decltype(newValue)>(newValue);
		}

		/// @brief Acquires a shared read-only RAII accessor to the node's payload value.
		[[nodiscard]] constexpr auto getValue() const -> Thread::ReadOnlyAccessor<Value>
		{
			auto nodeAccessor = m_node->sharedAccess();
			return nodeAccessor->value.value.sharedAccess();
		}

		/// @brief Acquires a shared read-only RAII accessor to the node's branch map.
		[[nodiscard]] constexpr auto getBranches() const -> Thread::ReadOnlyAccessor<Branches>
		{
			auto nodeAccessor = m_node->sharedAccess();
			return nodeAccessor->value.branches.sharedAccess();
		}

		/// @brief Detaches all outgoing branches from this node.
		constexpr auto clearBranches() const -> void
		{
			if (not m_node)
				return;

			auto branchKeys = std::vector<Key>{};
			{
				auto nodeAccessor = m_node->sharedAccess();
				auto branchesAccessor = nodeAccessor->value.branches.sharedAccess();
				for (const auto& [key, _] : branchesAccessor.value())
					branchKeys.push_back(key);
			}
			for (const auto& key : branchKeys)
				detach(*this, key);
		}

	private:
		SharedPtr m_node = nullptr;
	};
}
