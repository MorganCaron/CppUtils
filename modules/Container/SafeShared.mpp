export module CppUtils.Container.SafeShared;

import std;
import CppUtils.Thread.SharedLocker;
export import CppUtils.Thread.SharedPtr;

export namespace CppUtils::Container
{
	template<class T>
	using SafeShared = Thread::SharedPtr<Thread::SharedLocker<T>>;

	template<class T>
	using SafeWeak = Thread::WeakPtr<Thread::SharedLocker<T>>;

	template<class T>
	[[nodiscard]] inline constexpr auto makeSafeShared(auto&&... arguments) -> SafeShared<T>
	{
		return Thread::makeShared<Thread::SharedLocker<T>>(std::forward<decltype(arguments)>(arguments)...);
	}
}
