export module CppUtils.Container.NetworkPtr;

import std;
import CppUtils.Container.SafeShared;
import CppUtils.Thread.SharedLocker;
import CppUtils.Thread.SharedPtr;

export namespace CppUtils::Container
{
	/**
	 * @brief Graph node wrapper managing cyclic references deterministically via root-distance tracking.
	 * @tparam T Payload type stored inside the node.
	 */
	template<class T>
	class NetworkPtr final
	{
	public:
		using Value = T;
		using SharedPtr = SafeShared<NetworkPtr<T>>;
		using WeakPtr = SafeWeak<NetworkPtr<T>>;
		using Accessor = Thread::Accessor<NetworkPtr<T>, Thread::SharedMutex>;

	private:
		explicit inline constexpr NetworkPtr(auto&&... args):
			value{std::forward<decltype(args)>(args)...}
		{}

		friend class Thread::SharedLocker<NetworkPtr<T>>;

	public:
		/// @brief Detaches all children and parents upon destruction.
		inline constexpr ~NetworkPtr()
		{
			detachChildren();
			detachParents();
		}

		/**
		 * @brief Allocates a non-root node wrapped in a `SafeShared`.
		 * @param args Arguments forwarded to construct `T`.
		 */
		[[nodiscard]] static inline constexpr auto make(auto&&... args) -> SharedPtr
		{
			auto pointer = makeSafeShared<NetworkPtr<T>>(std::forward<decltype(args)>(args)...);
			{
				auto accessor = pointer->uniqueAccess();
				accessor->setWeakThis(pointer);
			}
			return pointer;
		}

		/**
		 * @brief Allocates a root node wrapped in a `SafeShared`.
		 * @param args Arguments forwarded to construct `T`.
		 */
		[[nodiscard]] static inline constexpr auto makeRoot(auto&&... args) -> SharedPtr
		{
			auto pointer = makeSafeShared<NetworkPtr<T>>(std::forward<decltype(args)>(args)...);
			{
				auto accessor = pointer->uniqueAccess();
				accessor->setWeakThis(pointer);
				accessor->setRoot(true);
			}
			return pointer;
		}

		/// @brief Returns `true` if this node is marked as a root.
		[[nodiscard]] inline constexpr auto isRoot() const noexcept -> bool
		{
			return m_isRoot;
		}

		/// @brief Returns `true` if this node is neither a root nor attached to any parent.
		[[nodiscard]] inline constexpr auto isTemporary() const noexcept -> bool
		{
			return not m_isRoot and std::ranges::empty(m_parents);
		}

		/// @brief Marks or unmarks this node as a root.
		inline constexpr auto setRoot(bool isRoot) noexcept -> void
		{
			m_isRoot = isRoot;
			if (m_isRoot)
				m_distanceFromRoot = 0;
		}

		/// @brief Stores the weak self-reference used when registering parent/child links.
		inline constexpr auto setWeakThis(WeakPtr pointer) noexcept -> void
		{
			m_weakThis = std::move(pointer);
		}

		/// @brief Returns the shortest hop distance from any root node (or `max()` if unreachable).
		[[nodiscard]] inline constexpr auto getDistanceFromRoot() const noexcept -> std::size_t
		{
			return m_distanceFromRoot;
		}

		/**
		 * @brief Attaches `childValue` as a child of this node, promoting or demoting the link strength based on root distance.
		 * @throws std::logic_error if the child handle is expired or this parent has no root path.
		 */
		inline constexpr auto attachChild(NetworkPtr& childValue) -> void
		{
			auto childPtr = childValue.m_weakThis.lock();
			if (not childPtr)
				throw std::logic_error{"Child node not found"};
			if (m_distanceFromRoot == std::numeric_limits<std::size_t>::max())
				throw std::logic_error{"Root node not found"};

			childValue.m_parents.push_back(m_weakThis);
			childValue.updateDistance(m_weakThis, m_distanceFromRoot);

			if (childValue.m_distanceFromRoot > m_distanceFromRoot)
				m_children.push_back(childPtr);
			else
				m_children.push_back(WeakPtr{childPtr});
		}

		/**
		 * @brief Detaches `childValue` from this node and updates root distances across affected descendants.
		 * @param childValue Child node to unlink from this parent.
		 */
		inline constexpr auto detachChild(NetworkPtr& childValue) -> void
		{
			auto childPtr = childValue.m_weakThis.lock();
			if (not childPtr)
				return;
			if (auto thisPtr = m_weakThis.lock(); thisPtr)
			{
				const auto children = m_children | std::views::reverse;
				if (auto childIt = std::ranges::find_if(children, [&childPtr](const auto& child) -> bool {
					return std::visit([&childPtr](const auto& child) -> bool {
						return Thread::ownerEqual(childPtr, child);
					}, child);
				});
					childIt != std::ranges::end(children))
				{
					auto baseIt = std::ranges::prev(childIt.base());
					auto needsDistanceUpdate = std::holds_alternative<SharedPtr>(*baseIt);
					m_children.erase(baseIt);
					auto& parents = childValue.m_parents;
					if (auto parentIt = std::ranges::find_if(parents, [&thisPtr](const auto& parentWeak) -> bool {
						return Thread::ownerEqual(parentWeak, thisPtr);
					});
						parentIt != std::ranges::cend(parents))
					{
						parents.erase(parentIt);
						if (needsDistanceUpdate)
							childValue.updateDistance(m_weakThis, m_distanceFromRoot);
					}
				}
			}
		}

		/// @brief Detaches all children from this node and updates root distances across affected descendants.
		inline constexpr auto detachChildren() -> void
		{
			for (auto children = std::move(m_children); auto& child : children)
			{
				const auto needsDistanceUpdate = std::holds_alternative<SharedPtr>(child);
				if (auto childPointer = std::visit([](auto&& pointer) -> SharedPtr {
					if constexpr (std::is_same_v<std::decay_t<decltype(pointer)>, SharedPtr>)
						return pointer;
					else
						return pointer.lock();
				}, child))
				{
					if (not childPointer)
						continue;
					auto accessor = childPointer->uniqueAccess();
					auto& parents = accessor->m_parents;
					if (auto parentIterator = std::ranges::find_if(parents, [this](const auto& parentWeak) -> bool {
						return Thread::ownerEqual(parentWeak, m_weakThis);
					});
						parentIterator != std::ranges::cend(parents))
					{
						parents.erase(parentIterator);
						if (needsDistanceUpdate)
							accessor->updateDistance(m_weakThis, m_distanceFromRoot);
					}
				}
			}
		}

		/**
		 * @brief Detaches this node from `parent`.
		 * @param parent Parent node handle to unlink from.
		 */
		inline constexpr auto detachParent(SharedPtr& parent) -> void
		{
			if (auto thisPtr = m_weakThis.lock(); thisPtr)
			{
				auto accessor = Thread::MultipleAccessor{*parent, *thisPtr};
				auto& parentRef = std::get<0>(accessor.values);
				auto& childRef = std::get<1>(accessor.values);
				parentRef.detachChild(childRef);
			}
		}

		/// @brief Removes all back-references to this node from its registered parents.
		inline constexpr auto detachParents() -> void
		{
			for (auto parents = std::move(m_parents); const auto& parentWeak : parents)
			{
				if (auto parent = parentWeak.lock())
				{
					auto accessor = parent->uniqueAccess();
					auto& children = accessor->m_children;
					if (auto childIterator = std::ranges::find_if(children, [this](const auto& child) -> bool {
						return std::visit([this](const auto& childPointer) -> bool {
							return Thread::ownerEqual(m_weakThis, childPointer);
						}, child);
					});
						childIterator != std::ranges::end(children))
					{
						children.erase(childIterator);
					}
				}
			}
		}

	private:
		static inline constexpr auto getChildAccessor(auto& child) -> std::optional<Accessor>
		{
			auto sharedPtr = SharedPtr{};
			if (std::holds_alternative<SharedPtr>(child))
				sharedPtr = std::get<SharedPtr>(child);
			else
				sharedPtr = SharedPtr{std::get<WeakPtr>(child)};
			if (not sharedPtr)
				return std::nullopt;
			return sharedPtr->uniqueAccess();
		}

		struct LockedAncestorFrame final
		{
			const WeakPtr* node = nullptr;
			const LockedAncestorFrame* parentFrame = nullptr;

			[[nodiscard]] inline constexpr auto contains(const auto& target) const noexcept -> bool
			{
				for (const auto* current = this; current != nullptr; current = current->parentFrame)
					if (current->node and Thread::ownerEqual(*current->node, target))
						return true;
				return false;
			}
		};

		inline constexpr auto updateDistance(
			const WeakPtr& lockedParentWeak = {},
			std::size_t lockedParentDistance = std::numeric_limits<std::size_t>::max(),
			const LockedAncestorFrame* lockedAncestors = nullptr) -> void
		{
			const auto oldDistanceFromRoot = m_distanceFromRoot;

			m_distanceFromRoot = m_isRoot ? 0 : std::numeric_limits<std::size_t>::max();
			if (not m_isRoot)
			{
				for (const auto& parentWeak : m_parents)
				{
					auto parentDistance = std::numeric_limits<std::size_t>::max();
					if (Thread::ownerEqual(parentWeak, lockedParentWeak))
						parentDistance = lockedParentDistance;
					else if (lockedAncestors and lockedAncestors->contains(parentWeak))
						continue;
					else if (auto parent = parentWeak.lock())
					{
						auto accessor = parent->sharedAccess();
						parentDistance = accessor->getDistanceFromRoot();
					}

					if (parentDistance != std::numeric_limits<std::size_t>::max() and parentDistance + 1 < m_distanceFromRoot)
						m_distanceFromRoot = parentDistance + 1;
				}
			}

			if (m_distanceFromRoot == oldDistanceFromRoot)
				return;

			const auto thisFrame = LockedAncestorFrame{std::addressof(m_weakThis), lockedAncestors};
			const auto parentFrame = LockedAncestorFrame{lockedParentWeak.lock() ? std::addressof(lockedParentWeak) : nullptr, std::addressof(thisFrame)};
			const auto* nextAncestors = parentFrame.node ? std::addressof(parentFrame) : std::addressof(thisFrame);

			for (auto& child : m_children)
			{
				const auto* shared = std::get_if<SharedPtr>(&child);
				if (not shared)
					continue;

				if (nextAncestors->contains(*shared))
					continue;

				auto accessor = (*shared)->uniqueAccess();
				accessor->updateDistance(m_weakThis, m_distanceFromRoot, nextAncestors);
			}
		}

	public:
		T value;

	private:
		bool m_isRoot = false;
		std::size_t m_distanceFromRoot = std::numeric_limits<std::size_t>::max();
		WeakPtr m_weakThis;
		std::vector<std::variant<SharedPtr, WeakPtr>> m_children;
		std::vector<WeakPtr> m_parents;
	};

	/// @brief Creates a directed link from `from` to `to` and returns `to` for chaining.
	template<class T>
	inline constexpr auto operator>>(
		SafeShared<NetworkPtr<T>>& from,
		SafeShared<NetworkPtr<T>>& to) -> SafeShared<NetworkPtr<T>>&
	{
		auto accessor = Thread::MultipleAccessor{*from, *to};
		auto& fromValue = std::get<0>(accessor.values);
		auto& toValue = std::get<1>(accessor.values);
		fromValue.attachChild(toValue);
		return to;
	}

	/// @brief Creates a bidirectional link between `lhs` and `rhs` and returns `rhs`.
	template<class T>
	inline constexpr auto operator&(
		SafeShared<NetworkPtr<T>>& lhs,
		SafeShared<NetworkPtr<T>>& rhs) -> SafeShared<NetworkPtr<T>>&
	{
		auto accessor = Thread::MultipleAccessor{*lhs, *rhs};
		auto& value1 = std::get<0>(accessor.values);
		auto& value2 = std::get<1>(accessor.values);
		value1.attachChild(value2);
		value2.attachChild(value1);
		return rhs;
	}

	/// @brief Detaches the directed link from `from` to `to` and returns `to`.
	template<class T>
	inline constexpr auto operator-(
		SafeShared<NetworkPtr<T>>& from,
		SafeShared<NetworkPtr<T>>& to) -> SafeShared<NetworkPtr<T>>&
	{
		auto accessor = Thread::MultipleAccessor{*from, *to};
		auto& fromValue = std::get<0>(accessor.values);
		auto& toValue = std::get<1>(accessor.values);
		fromValue.detachChild(toValue);
		return to;
	}

	/// @brief Detaches the bidirectional link between `lhs` and `rhs` and returns `rhs`.
	template<class T>
	inline constexpr auto operator/(
		SafeShared<NetworkPtr<T>>& lhs,
		SafeShared<NetworkPtr<T>>& rhs) -> SafeShared<NetworkPtr<T>>&
	{
		auto accessor = Thread::MultipleAccessor{*lhs, *rhs};
		auto& value1 = std::get<0>(accessor.values);
		auto& value2 = std::get<1>(accessor.values);
		value1.detachChild(value2);
		value2.detachChild(value1);
		return rhs;
	}
}
