export module CppUtils.Execution.EventDispatcher;

import std;
import CppUtils.Type.Callable;
import CppUtils.String.Hash;
import CppUtils.Container.MultiKeyMap;

export namespace CppUtils::Execution
{
	class EventDispatcher final
	{
		using Key = std::pair<Type::Hash, std::type_index>;

	public:
		// clang-format off
		enum class SubscriptionIdentifier : std::size_t {};
		// clang-format on

		template<String::Hasher eventName = Type::Hash{}, class... Args>
		inline auto emit(const Args&... args) -> void
		{
			emit(static_cast<Type::Hash>(eventName), args...);
		}

		template<class... Args>
		inline auto emit(Type::Hash eventName, const Args&... args) -> void
		{
			auto lockGuard = std::shared_lock{m_mutex};
			using Tuple = std::tuple<std::decay_t<Args>...>;
			const auto key = std::make_pair(eventName, std::type_index{typeid(Tuple)});
			if (const auto subscribers = m_subscribers.find(key);
				not std::ranges::empty(subscribers))
			{
				auto payload = std::make_tuple(args...);
				for (const auto& subscriber : subscribers)
					subscriber.value(std::addressof(payload));
			}
		}

		inline auto subscribe(Type::Hash eventHash, auto&& function) -> SubscriptionIdentifier
		{
			using FunctionType = std::decay_t<decltype(function)>;
			using ArgumentsTypes = typename Type::CallableTrait<FunctionType>::ArgumentsTypes;
			return [&]<class... Args>(std::tuple<Args...>*) -> SubscriptionIdentifier {
				using Tuple = std::tuple<std::decay_t<Args>...>;
				auto lockGuard = std::unique_lock{m_mutex};
				const auto subscriptionIdentifier = static_cast<SubscriptionIdentifier>(++m_nextSubscriptionIdentifier);
				const auto key = std::make_pair(eventHash, std::type_index{typeid(Tuple)});
				m_subscribers.emplace(
					key,
					subscriptionIdentifier,
					[function = std::forward<decltype(function)>(function)](const void* payload) mutable -> void {
					const auto& args = *static_cast<const Tuple*>(payload);
					std::apply(function, args);
				});
				return subscriptionIdentifier;
			}(static_cast<ArgumentsTypes*>(nullptr));
		}

		template<String::Hasher... eventNames>
		inline auto subscribe(auto&& function)
		{
			if constexpr (sizeof...(eventNames) == 0)
				return subscribe(Type::Hash{}, std::forward<decltype(function)>(function));
			else if constexpr (sizeof...(eventNames) == 1)
				return subscribe((static_cast<Type::Hash>(eventNames), ...), std::forward<decltype(function)>(function));
			else
			{
				auto subscriptionIdentifiers = std::vector<SubscriptionIdentifier>{};
				(subscriptionIdentifiers.push_back(subscribe(static_cast<Type::Hash>(eventNames), function)), ...);
				return subscriptionIdentifiers;
			}
		}

		inline auto unsubscribe(SubscriptionIdentifier subscriptionIdentifier) -> bool
		{
			auto lockGuard = std::unique_lock{m_mutex};
			return m_subscribers.erase(subscriptionIdentifier);
		}

		inline auto unsubscribe(Type::Hash eventHash) -> bool
		{
			auto lockGuard = std::unique_lock{m_mutex};
			auto removed = false;
			for (auto iterator = std::ranges::begin(m_subscribers); iterator != std::ranges::end(m_subscribers);)
				if (iterator->template key<Key>().first == eventHash)
				{
					iterator = m_subscribers.erase(iterator);
					removed = true;
				}
				else
					++iterator;
			return removed;
		}

		template<String::Hasher... eventNames>
		inline auto unsubscribe() -> bool
		{
			if constexpr (sizeof...(eventNames) == 0)
				return unsubscribe(Type::Hash{});
			else if constexpr (sizeof...(eventNames) == 1)
				return (unsubscribe(static_cast<Type::Hash>(eventNames)), ...);
			else
			{
				const auto results = std::array{unsubscribe(static_cast<Type::Hash>(eventNames))...};
				return std::ranges::any_of(results, std::identity{});
			}
		}

		inline auto clearSubscribers() -> void
		{
			auto lockGuard = std::unique_lock{m_mutex};
			m_subscribers.clear();
		}

	private:
		struct PairHasher final
		{
			[[nodiscard]] inline auto operator()(const Key& key) const noexcept -> std::size_t
			{
				return std::hash<Type::Hash>{}(key.first) ^ (key.second.hash_code() << 1);
			}
		};

		using Subscribers = Container::MultiKeyMap<
			Container::NonUnique<Key, PairHasher>,
			SubscriptionIdentifier,
			std::function<void(const void*)>>;

		std::shared_mutex m_mutex;
		std::size_t m_nextSubscriptionIdentifier = 0;
		Subscribers m_subscribers;
	};
}
