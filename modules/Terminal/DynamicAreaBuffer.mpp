module;

#include <cassert>

export module CppUtils.Terminal.Area:DynamicAreaBuffer;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.AreaBuffer;
import CppUtils.Terminal.CharCell;
import CppUtils.Thread.SharedLocker;

export namespace CppUtils::Terminal
{
	class DynamicAreaBufferStorage final: public AreaBuffer
	{
	public:
		using Line = std::vector<CharCell>;
		using Buffer = std::vector<Line>;

		inline DynamicAreaBufferStorage(const Container::Size2<>& size, Buffer&& buffer):
			m_size{size},
			m_buffer{std::move(buffer)}
		{}

		inline DynamicAreaBufferStorage(const Container::Size2<>& size = {0, 0}, CharCell defaultCell = {}):
			DynamicAreaBufferStorage{size, Buffer(size.height(), Line(size.width(), defaultCell))}
		{}

		inline DynamicAreaBufferStorage(const Container::Size2<>& size, char defaultChar):
			DynamicAreaBufferStorage{size, CharCell{defaultChar}}
		{}

		inline auto setSize(const Container::Size2<>& size) noexcept -> void
		{
			m_size = size;
			m_buffer = Buffer(m_size.height(), Line(m_size.width()));
		}

		[[nodiscard]] inline auto getSize() const noexcept -> Container::Size2<> final
		{
			return m_size;
		}

		[[nodiscard]] inline auto getChar(const Container::Size2<>& position) const noexcept -> const CharCell& final
		{
			assert(position.x() < m_size.width() and position.y() < m_size.height());
			return m_buffer[position.y()][position.x()];
		}

		inline auto setChar(const Container::Size2<>& position, const CharCell& c) noexcept -> void final
		{
			if (position.x() >= m_size.width() or position.y() >= m_size.height())
				return;

			if (position.x() + 1 == m_size.width() and c.displayWidth == 2)
				return;

			if (auto& oldChar = m_buffer[position.y()][position.x()];
				oldChar.displayWidth == 2)
			{
				if (position.x() + 1 < m_size.width())
					if (auto& nextChar = m_buffer[position.y()][position.x() + 1];
						nextChar.displayWidth == 0)
						nextChar = CharCell{' '};
			}
			else if (oldChar.displayWidth == 0)
			{
				if (position.x() > 0)
					if (auto& previousChar = m_buffer[position.y()][position.x() - 1];
						previousChar.displayWidth == 2)
						previousChar = CharCell{' '};
			}

			m_buffer[position.y()][position.x()] = c;
		}

		[[nodiscard]] inline auto getBuffer() const noexcept [[clang::lifetimebound, msvc::lifetimebound]] -> const Buffer&
		{
			return m_buffer;
		}

	private:
		Container::Size2<> m_size;
		Buffer m_buffer;
	};

	using DynamicAreaBuffer = Thread::SharedLocker<DynamicAreaBufferStorage>;
}
