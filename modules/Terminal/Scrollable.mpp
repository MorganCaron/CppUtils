export module CppUtils.Terminal.Scrollable;

import std;
import CppUtils.Container.Size;
export import CppUtils.Terminal.Area;
import CppUtils.Terminal.CharCell;
import CppUtils.Terminal.TextColor;
import CppUtils.Terminal.BackgroundColor;
import CppUtils.Terminal.Mouse;

export namespace CppUtils::Terminal
{
	struct ScrollbarStyle final
	{
		CharCell verticalTrack = {U'│', TextColor::TextColorEnum::White};
		CharCell verticalThumb = {U'█', TextColor::TextColorEnum::White};
		CharCell horizontalTrack = {U'─', TextColor::TextColorEnum::White};
		CharCell horizontalThumb = {U'█', TextColor::TextColorEnum::White};
		CharCell corner = {U'┘', TextColor::TextColorEnum::White};
	};

	class Scrollable: public Area
	{
	public:
		enum ScrollbarMode : std::uint8_t
		{
			None = 0b00,
			Vertical = 0b01,
			Horizontal = 0b10,
			Both = Vertical | Horizontal
		};

		inline Scrollable(const Container::Size2& viewportSize, const Container::Size2& fullContentSize):
			Area{viewportSize},
			m_fullContentArea{fullContentSize}
		{}

		template<std::derived_from<Widget> T>
		inline auto addWidget(std::unique_ptr<T> widget) -> T&
		{
			return m_fullContentArea.addWidget(std::move(widget));
		}

		inline auto setScroll(const Container::Size2& position) noexcept -> void
		{
			m_scrollPosition = position;
			requestUpdate(std::chrono::milliseconds{10});
		}

		[[nodiscard]] inline auto getScroll() const noexcept -> Container::Size2
		{
			return m_scrollPosition;
		}

		[[nodiscard]] inline auto getContentArea() noexcept -> Area&
		{
			return m_fullContentArea;
		}

		inline auto showScrollbars(std::uint8_t mode = ScrollbarMode::Both) noexcept -> void
		{
			m_scrollbarMode = mode;
		}

		[[nodiscard]] inline auto getScrollbarMode() const noexcept -> std::uint8_t
		{
			return m_scrollbarMode;
		}

		inline auto setScrollbarStyle(const ScrollbarStyle& style) noexcept -> void
		{
			m_scrollbarStyle = style;
			requestUpdate();
		}

		[[nodiscard]] inline auto getScrollbarStyle() const noexcept -> const ScrollbarStyle&
		{
			return m_scrollbarStyle;
		}

		inline void setWidgetManager(WidgetManager& widgetManager) noexcept override
		{
			Area::setWidgetManager(widgetManager);
			m_fullContentArea.setWidgetManager(widgetManager);
		}

		inline auto onMouseEvent(const Mouse::Event& event) -> bool override
		{
			const auto viewportSize = getSize();
			const auto& contentSize = m_fullContentArea.getSize();

			const bool showVertical = (m_scrollbarMode & ScrollbarMode::Vertical) and (contentSize.height() > viewportSize.height());
			const bool showHorizontal = (m_scrollbarMode & ScrollbarMode::Horizontal) and (contentSize.width() > viewportSize.width());

			const auto maxScrollX = (contentSize.width() > viewportSize.width()) ? contentSize.width() - viewportSize.width() : 0;
			const auto maxScrollY = (contentSize.height() > viewportSize.height()) ? contentSize.height() - viewportSize.height() : 0;

			if (event.button == Mouse::Button::Left)
			{
				if (event.pressed)
				{
					if (showVertical and event.position.x() == viewportSize.width() - 1)
						if (const auto heightForBar = showHorizontal ? viewportSize.height() - 1 : viewportSize.height();
							event.position.y() < heightForBar)
						{
							const auto [thumbY, thumbHeight] = getCurrentThumbPosition(heightForBar, contentSize.height(), m_scrollPosition.y(), maxScrollY);
							if (event.position.y() >= thumbY and event.position.y() < thumbY + thumbHeight)
								m_dragOffsetVertical = event.position.y() - thumbY;
							else
								m_dragOffsetVertical = thumbHeight / 2;

							m_isDraggingVertical = true;
							updateVerticalScroll(event.position.y(), heightForBar, contentSize.height(), maxScrollY);
							return true;
						}

					if (showHorizontal and event.position.y() == viewportSize.height() - 1)
						if (const auto widthForBar = showVertical ? viewportSize.width() - 1 : viewportSize.width();
							event.position.x() < widthForBar)
						{
							const auto [thumbX, thumbWidth] = getCurrentThumbPosition(widthForBar, contentSize.width(), m_scrollPosition.x(), maxScrollX);
							if (event.position.x() >= thumbX and event.position.x() < thumbX + thumbWidth)
								m_dragOffsetHorizontal = event.position.x() - thumbX;
							else
								m_dragOffsetHorizontal = thumbWidth / 2;

							m_isDraggingHorizontal = true;
							updateHorizontalScroll(event.position.x(), widthForBar, contentSize.width(), maxScrollX);
							return true;
						}
				}
				else
				{
					m_isDraggingVertical = false;
					m_isDraggingHorizontal = false;
				}
			}

			if (event.dragging)
			{
				if (m_isDraggingVertical)
				{
					const auto heightForBar = showHorizontal ? viewportSize.height() - 1 : viewportSize.height();
					updateVerticalScroll(event.position.y(), heightForBar, contentSize.height(), maxScrollY);
					return true;
				}
				if (m_isDraggingHorizontal)
				{
					const auto widthForBar = showVertical ? viewportSize.width() - 1 : viewportSize.width();
					updateHorizontalScroll(event.position.x(), widthForBar, contentSize.width(), maxScrollX);
					return true;
				}
			}

			if (event.button == Mouse::Button::ScrollUp)
			{
				if (m_scrollPosition.y() > 0)
				{
					--m_scrollPosition.y();
					requestUpdate();
					return true;
				}
			}
			else if (event.button == Mouse::Button::ScrollDown)
			{
				if (m_scrollPosition.y() < maxScrollY)
				{
					++m_scrollPosition.y();
					requestUpdate();
					return true;
				}
			}

			auto translatedEvent = event;
			translatedEvent.position += m_scrollPosition;
			return m_fullContentArea.onMouseEvent(translatedEvent);
		}

		inline auto draw(WritableAreaView& view) noexcept -> void override
		{
			{
				auto fullContentAreaView = m_fullContentArea.getWritableView();
				m_fullContentArea.draw(fullContentAreaView);
			}

			const auto& contentSize = m_fullContentArea.getSize();
			const auto viewportSize = getSize();

			const auto maxScrollX = (contentSize.width() > viewportSize.width()) ? contentSize.width() - viewportSize.width() : 0;
			const auto maxScrollY = (contentSize.height() > viewportSize.height()) ? contentSize.height() - viewportSize.height() : 0;

			if (m_scrollPosition.x() > maxScrollX)
				m_scrollPosition.x() = maxScrollX;
			if (m_scrollPosition.y() > maxScrollY)
				m_scrollPosition.y() = maxScrollY;

			Viewport{viewportSize}.forEach([&](const auto& position) {
				const auto sourcePosition = position + m_scrollPosition;

				if (sourcePosition.x() < contentSize.width() and sourcePosition.y() < contentSize.height())
					setChar(position, m_fullContentArea.getChar(sourcePosition));
				else
					setChar(position, CharCell{U' '});
			});

			if (m_scrollbarMode != ScrollbarMode::None)
			{
				auto internalView = WritableAreaView{*this};
				drawScrollbars(internalView, contentSize, viewportSize, maxScrollX, maxScrollY);
			}

			view.applyArea(*this);
			drawFinished();
		}

	private:
		[[nodiscard]] inline auto getCurrentThumbPosition(std::size_t visibleLength, std::size_t contentLength, std::size_t currentScrollPosition, std::size_t maxScroll) const noexcept -> std::pair<std::size_t, std::size_t>
		{
			if (visibleLength == 0 or contentLength == 0)
				return {0, 0};
			const auto ratio = static_cast<double>(visibleLength) / static_cast<double>(contentLength);
			const auto thumbSize = std::ranges::max(1uz, static_cast<std::size_t>(ratio * static_cast<double>(visibleLength)));
			const auto maxThumbPosition = (visibleLength > thumbSize) ? visibleLength - thumbSize : 0;
			const auto scrollRatio = (maxScroll > 0) ? static_cast<double>(currentScrollPosition) / static_cast<double>(maxScroll) : 0.0;
			const auto thumbPosition = static_cast<std::size_t>(scrollRatio * static_cast<double>(maxThumbPosition));
			return {thumbPosition, thumbSize};
		}

		inline auto updateScrollOnAxis(std::size_t clickPosition, std::size_t dragOffset, std::size_t visibleLength, std::size_t contentLength, std::size_t& scrollPosition, std::size_t maxScroll) -> void
		{
			if (visibleLength == 0)
				return;
			const auto ratio = static_cast<double>(visibleLength) / static_cast<double>(contentLength);
			const auto thumbSize = std::ranges::max(1uz, static_cast<std::size_t>(ratio * static_cast<double>(visibleLength)));

			const auto targetThumb = (clickPosition > dragOffset) ? clickPosition - dragOffset : 0;
			const auto maxThumbPosition = (visibleLength > thumbSize) ? visibleLength - thumbSize : 0;

			const auto finalThumb = std::ranges::min(targetThumb, maxThumbPosition);
			const auto scrollRatio = (maxThumbPosition > 0) ? static_cast<double>(finalThumb) / static_cast<double>(maxThumbPosition) : 0.0;

			scrollPosition = static_cast<std::size_t>(scrollRatio * static_cast<double>(maxScroll));
			requestUpdate();
		}

		inline auto updateVerticalScroll(std::size_t y, std::size_t heightForBar, std::size_t contentHeight, std::size_t maxScrollY) -> void
		{
			updateScrollOnAxis(y, m_dragOffsetVertical, heightForBar, contentHeight, m_scrollPosition.y(), maxScrollY);
		}

		inline auto updateHorizontalScroll(std::size_t x, std::size_t widthForBar, std::size_t contentWidth, std::size_t maxScrollX) -> void
		{
			updateScrollOnAxis(x, m_dragOffsetHorizontal, widthForBar, contentWidth, m_scrollPosition.x(), maxScrollX);
		}

		inline auto drawScrollbars(WritableAreaView& view, const Container::Size2& contentSize, const Container::Size2& viewSize, std::size_t maxScrollX, std::size_t maxScrollY) -> void
		{
			const bool showVertical = (m_scrollbarMode & ScrollbarMode::Vertical) and (contentSize.height() > viewSize.height());
			const bool showHorizontal = (m_scrollbarMode & ScrollbarMode::Horizontal) and (contentSize.width() > viewSize.width());

			if (showVertical)
			{
				const auto barX = viewSize.width() - 1;
				const auto heightForBar = showHorizontal ? viewSize.height() - 1 : viewSize.height();

				for (auto y = 0uz; y < heightForBar; ++y)
					view.setChar({barX, y}, m_scrollbarStyle.verticalTrack);

				const auto [thumbY, thumbHeight] = getCurrentThumbPosition(heightForBar, contentSize.height(), m_scrollPosition.y(), maxScrollY);

				for (auto i = 0uz; i < thumbHeight; ++i)
					view.setChar({barX, thumbY + i}, m_scrollbarStyle.verticalThumb);
			}

			if (showHorizontal)
			{
				const auto barY = viewSize.height() - 1;
				const auto widthForBar = showVertical ? viewSize.width() - 1 : viewSize.width();

				for (auto x = 0uz; x < widthForBar; ++x)
					view.setChar({x, barY}, m_scrollbarStyle.horizontalTrack);

				const auto [thumbX, thumbWidth] = getCurrentThumbPosition(widthForBar, contentSize.width(), m_scrollPosition.x(), maxScrollX);

				for (auto i = 0uz; i < thumbWidth; ++i)
					view.setChar({thumbX + i, barY}, m_scrollbarStyle.horizontalThumb);
			}

			if (showVertical and showHorizontal)
				view.setChar({viewSize.width() - 1, viewSize.height() - 1}, m_scrollbarStyle.corner);
		}

		std::uint8_t m_scrollbarMode = ScrollbarMode::Both;
		Container::Size2 m_scrollPosition{0, 0};
		Area m_fullContentArea;
		ScrollbarStyle m_scrollbarStyle;
		bool m_isDraggingVertical = false;
		bool m_isDraggingHorizontal = false;
		std::size_t m_dragOffsetVertical = 0;
		std::size_t m_dragOffsetHorizontal = 0;
	};
}
