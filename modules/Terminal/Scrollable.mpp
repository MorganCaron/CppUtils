export module CppUtils.Terminal.Scrollable;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.Area;
import CppUtils.Terminal.AreaBuffer;
import CppUtils.Terminal.CharAttributes;
import CppUtils.Terminal.CharCell;
import CppUtils.Terminal.Mouse;

export namespace CppUtils::Terminal
{
	struct ScrollbarStyle final
	{
		CharCell verticalTrack = {U'│'};
		CharCell verticalThumb = {U'█'};
		CharCell horizontalTrack = {U'─'};
		CharCell horizontalThumb = {U'█'};
		CharCell corner = {U'┘'};
	};

	class Scrollable final: public Area
	{
	public:
		enum ScrollbarMode : std::uint8_t
		{
			None = 0b00,
			Vertical = 0b01,
			Horizontal = 0b10,
			Both = Vertical | Horizontal
		};

		inline Scrollable(
			const Container::Size2<>& viewportSize,
			const Container::Size2<>& fullContentSize):
			Area{viewportSize},
			m_fullContentArea{fullContentSize}
		{}

		template<std::derived_from<Widget> T>
		inline auto addWidget(std::unique_ptr<T> widget) -> T&
		{
			return m_fullContentArea.addWidget(std::move(widget));
		}

	protected:
		inline auto onWidgetManagerSet(WidgetManager& widgetManager) noexcept -> void override
		{
			m_fullContentArea.setWidgetManager(widgetManager);
		}

	public:
		inline auto setScroll(this auto&& self, const Container::Size2<>& position) noexcept -> decltype(auto)
		{
			self.m_scrollPosition = position;
			self.requestUpdate(std::chrono::milliseconds{10});
			return self;
		}

		[[nodiscard]] inline auto getScroll() const noexcept -> Container::Size2<>
		{
			return m_scrollPosition;
		}

		[[nodiscard]] inline auto getContentArea() noexcept -> Area&
		{
			return m_fullContentArea;
		}

		inline auto showScrollbars(this auto&& self, std::uint8_t mode = ScrollbarMode::Both) noexcept -> decltype(auto)
		{
			self.m_scrollbarMode = mode;
			return self;
		}

		inline auto setScrollbarStyle(this auto&& self, const ScrollbarStyle& style) noexcept -> decltype(auto)
		{
			self.m_scrollbarStyle = style;
			self.requestUpdate();
			return self;
		}

		[[nodiscard]] inline auto getScrollbarStyle() const noexcept -> const ScrollbarStyle&
		{
			return m_scrollbarStyle;
		}

		inline auto onMouseEvent(const Mouse::Event& event) -> bool override
		{
			const auto viewportSize = getSize();
			auto contentAreaAccessor = m_fullContentArea.getBuffer().sharedAccess();
			const auto contentSize = contentAreaAccessor->getSize();

			const bool showVertical = (m_scrollbarMode & ScrollbarMode::Vertical) and (contentSize.height() > viewportSize.height());
			const bool showHorizontal = (m_scrollbarMode & ScrollbarMode::Horizontal) and (contentSize.width() > viewportSize.width());

			const auto maxScrollX = (contentSize.width() > viewportSize.width()) ? contentSize.width() - viewportSize.width() : 0;
			const auto maxScrollY = (contentSize.height() > viewportSize.height()) ? contentSize.height() - viewportSize.height() : 0;

			if (event.button == Mouse::Button::Left)
			{
				if (event.pressed)
				{
					if (showVertical and event.relativePosition.x() == viewportSize.width() - 1)
						if (const auto heightForBar = showHorizontal ? viewportSize.height() - 1 : viewportSize.height();
							event.relativePosition.y() < heightForBar)
						{
							m_isDraggingVertical = true;

							const auto [thumbY, thumbHeight] = getCurrentThumbPosition(heightForBar, contentSize.height(), m_scrollPosition.y(), maxScrollY);
							if (event.relativePosition.y() >= thumbY and event.relativePosition.y() < thumbY + thumbHeight)
								m_dragOffsetVertical = event.relativePosition.y() - thumbY;
							else
								m_dragOffsetVertical = thumbHeight / 2;

							updateVerticalScroll(event.relativePosition.y(), heightForBar, contentSize.height(), maxScrollY);
							return true;
						}

					if (showHorizontal and event.relativePosition.y() == viewportSize.height() - 1)
						if (const auto widthForBar = showVertical ? viewportSize.width() - 1 : viewportSize.width();
							event.relativePosition.x() < widthForBar)
						{
							m_isDraggingHorizontal = true;

							const auto [thumbX, thumbWidth] = getCurrentThumbPosition(widthForBar, contentSize.width(), m_scrollPosition.x(), maxScrollX);
							if (event.relativePosition.x() >= thumbX and event.relativePosition.x() < thumbX + thumbWidth)
								m_dragOffsetHorizontal = event.relativePosition.x() - thumbX;
							else
								m_dragOffsetHorizontal = thumbWidth / 2;

							updateHorizontalScroll(event.relativePosition.x(), widthForBar, contentSize.width(), maxScrollX);
							return true;
						}
				}
				else
				{
					m_isDraggingVertical = false;
					m_isDraggingHorizontal = false;
				}
			}

			if (m_isDraggingVertical)
			{
				const auto heightForBar = showHorizontal ? viewportSize.height() - 1 : viewportSize.height();
				updateVerticalScroll(event.relativePosition.y(), heightForBar, contentSize.height(), maxScrollY);
				return true;
			}

			if (m_isDraggingHorizontal)
			{
				const auto widthForBar = showVertical ? viewportSize.width() - 1 : viewportSize.width();
				updateHorizontalScroll(event.relativePosition.x(), widthForBar, contentSize.width(), maxScrollX);
				return true;
			}

			if (event.button == Mouse::Button::ScrollUp)
			{
				if (m_scrollPosition.y() > 0)
				{
					--m_scrollPosition.y();
					requestUpdate();
					return true;
				}
			}
			else if (event.button == Mouse::Button::ScrollDown)
			{
				if (m_scrollPosition.y() < maxScrollY)
				{
					++m_scrollPosition.y();
					requestUpdate();
					return true;
				}
			}

			auto translatedEvent = event;
			translatedEvent.relativePosition += m_scrollPosition;
			return m_fullContentArea.onMouseEvent(translatedEvent);
		}

		inline auto draw(WritableAreaView& view) noexcept -> void override
		{
			auto fullContentAreaView = m_fullContentArea.getWritableView();
			m_fullContentArea.draw(fullContentAreaView);

			const auto contentSize = fullContentAreaView.getSize();
			const auto viewportSize = getSize();

			const auto maxScrollX = (contentSize.width() > viewportSize.width()) ? contentSize.width() - viewportSize.width() : 0;
			const auto maxScrollY = (contentSize.height() > viewportSize.height()) ? contentSize.height() - viewportSize.height() : 0;

			if (m_scrollPosition.x() > maxScrollX)
				m_scrollPosition.x() = maxScrollX;
			if (m_scrollPosition.y() > maxScrollY)
				m_scrollPosition.y() = maxScrollY;

			Viewport{viewportSize}.forEach([&](const auto& position) {
				const auto sourcePosition = position + m_scrollPosition;

				if (sourcePosition.x() < contentSize.width() and sourcePosition.y() < contentSize.height())
					view.setChar(position, fullContentAreaView.getChar(sourcePosition));
				else
					view.setChar(position, CharCell{U' '});
			});

			if (m_scrollbarMode != ScrollbarMode::None)
				drawScrollbars(view, contentSize, viewportSize, maxScrollX, maxScrollY);

			drawFinished();
		}

	private:
		struct Thumb final
		{
			std::size_t position = 0uz;
			std::size_t size = 0uz;
		};

		[[nodiscard]] inline auto getCurrentThumbPosition(std::size_t visibleLength, std::size_t contentLength, std::size_t currentScrollPosition, std::size_t maxScroll) const noexcept -> Thumb
		{
			if (visibleLength == 0 or contentLength == 0)
				return {};

			const auto thumbSize = std::clamp((visibleLength * visibleLength) / contentLength, 1uz, visibleLength);

			if (maxScroll == 0)
				return {0uz, visibleLength};

			const auto availableTrackSpace = visibleLength - thumbSize;
			const auto thumbPosition = (currentScrollPosition * availableTrackSpace) / maxScroll;

			return {thumbPosition, thumbSize};
		}

		inline auto updateScrollOnAxis(
			std::size_t mousePosition,
			std::size_t dragOffset,
			std::size_t visibleLength,
			std::size_t contentLength,
			std::size_t maxScroll,
			std::size_t& scrollPosition) -> void
		{
			const auto [thumbPosition, thumbSize] = getCurrentThumbPosition(visibleLength, contentLength, scrollPosition, maxScroll);
			const auto maxThumbPosition = (visibleLength > thumbSize) ? visibleLength - thumbSize : 0uz;
			if (maxThumbPosition == 0uz or maxScroll == 0uz)
				return;

			const auto targetThumb = (mousePosition >= dragOffset) ? mousePosition - dragOffset : 0uz;
			const auto finalThumb = std::ranges::min(targetThumb, maxThumbPosition);

			scrollPosition = (finalThumb * maxScroll) / maxThumbPosition;
			requestUpdate();
		}

		inline auto updateVerticalScroll(std::size_t y, std::size_t heightForBar, std::size_t contentHeight, std::size_t maxScrollY) -> void
		{
			updateScrollOnAxis(y, m_dragOffsetVertical, heightForBar, contentHeight, maxScrollY, m_scrollPosition.y());
		}

		inline auto updateHorizontalScroll(std::size_t x, std::size_t widthForBar, std::size_t contentWidth, std::size_t maxScrollX) -> void
		{
			updateScrollOnAxis(x, m_dragOffsetHorizontal, widthForBar, contentWidth, maxScrollX, m_scrollPosition.x());
		}

		inline auto drawScrollbars(WritableAreaView& view, const Container::Size2<>& contentSize, const Container::Size2<>& viewSize, std::size_t maxScrollX, std::size_t maxScrollY) noexcept -> void
		{
			const bool showVertical = (m_scrollbarMode & ScrollbarMode::Vertical) and (contentSize.height() > viewSize.height());
			const bool showHorizontal = (m_scrollbarMode & ScrollbarMode::Horizontal) and (contentSize.width() > viewSize.width());

			if (showVertical)
			{
				const auto heightForBar = showHorizontal ? viewSize.height() - 1 : viewSize.height();
				const auto [thumbY, thumbHeight] = getCurrentThumbPosition(heightForBar, contentSize.height(), m_scrollPosition.y(), maxScrollY);

				for (auto y = 0uz; y < heightForBar; ++y)
					if (y >= thumbY and y < thumbY + thumbHeight)
						view.setChar({viewSize.width() - 1, y}, m_scrollbarStyle.verticalThumb);
					else
						view.setChar({viewSize.width() - 1, y}, m_scrollbarStyle.verticalTrack);
			}

			if (showHorizontal)
			{
				const auto widthForBar = showVertical ? viewSize.width() - 1 : viewSize.width();
				const auto [thumbX, thumbWidth] = getCurrentThumbPosition(widthForBar, contentSize.width(), m_scrollPosition.x(), maxScrollX);

				for (auto x = 0uz; x < widthForBar; ++x)
					if (x >= thumbX and x < thumbX + thumbWidth)
						view.setChar({x, viewSize.height() - 1}, m_scrollbarStyle.horizontalThumb);
					else
						view.setChar({x, viewSize.height() - 1}, m_scrollbarStyle.horizontalTrack);
			}

			if (showVertical and showHorizontal)
				view.setChar({viewSize.width() - 1, viewSize.height() - 1}, m_scrollbarStyle.corner);
		}

		std::uint8_t m_scrollbarMode = ScrollbarMode::Both;
		Container::Size2<> m_scrollPosition{0, 0};
		Area m_fullContentArea;
		ScrollbarStyle m_scrollbarStyle;
		bool m_isDraggingVertical = false;
		bool m_isDraggingHorizontal = false;
		std::size_t m_dragOffsetVertical = 0;
		std::size_t m_dragOffsetHorizontal = 0;
	};
}
