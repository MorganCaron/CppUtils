export module CppUtils.Terminal.Area:Widget;

import std;

import CppUtils.Container.Vec;

import :WidgetManager;
import :WritableAreaView;
import CppUtils.Chrono.Concept;
import CppUtils.Thread.Scheduler;
import CppUtils.Terminal.Mouse;

export namespace CppUtils::Terminal
{
	enum class Alignment : std::uint8_t
	{
		Begin,
		Center,
		End
	};

	struct Alignments: Container::Vec<2, Alignment>
	{
		inline constexpr Alignments() = default;
		explicit inline constexpr Alignments(Alignment horizontal, Alignment vertical = Alignment::Begin):
			Container::Vec<2, Alignment>{horizontal, vertical}
		{}

		[[nodiscard]] inline constexpr auto horizontal(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) noexcept -> decltype(auto) { return self[0]; }
		[[nodiscard]] inline constexpr auto vertical(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) noexcept -> decltype(auto) { return self[1]; }
	};

	class Widget
	{
	public:
		virtual inline ~Widget() noexcept
		{
			clearWidgetManager();
		}

		inline auto clearWidgetManager() noexcept -> void
		{
			if (hasWidgetManager())
			{
				getWidgetManager().scheduler.cancelOwner(this);
				m_widgetManagerRef = std::nullopt;
			}
		}
		[[nodiscard]] virtual auto getSize() const noexcept -> Container::Size2<> = 0;
		virtual auto draw(WritableAreaView& view) noexcept -> void = 0;

		inline virtual auto onMouseEvent([[maybe_unused]] const Mouse::Event& event) -> bool
		{
			return false;
		}

		template<std::derived_from<Widget> T, class... Args>
		inline auto newWidget(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]], Args&&... args) -> T&
		{
			return self.addWidget(std::make_unique<T>(std::forward<Args>(args)...));
		}

		inline auto drawFinished() noexcept -> void
		{
			m_needUpdate = false;
		}

		[[nodiscard]] inline auto needUpdate() const noexcept -> bool
		{
			return m_needUpdate;
		}

		inline auto setWidgetManager(WidgetManager& widgetManager) noexcept -> void
		{
			m_widgetManagerRef = widgetManager;
			onWidgetManagerSet(widgetManager);
		}

		[[nodiscard]] inline auto getWidgetManager() -> WidgetManager&
		{
			return m_widgetManagerRef.value().get();
		}

		[[nodiscard]] inline auto hasWidgetManager() const noexcept -> bool
		{
			return m_widgetManagerRef.has_value();
		}

		inline auto requestUpdate() -> void
		{
			requestUpdate(std::chrono::milliseconds{10});
		}

		inline auto requestUpdate(Chrono::Duration auto delay) -> void
		{
			requestUpdateImpl(std::chrono::duration_cast<Thread::Scheduler::Clock::duration>(delay));
		}

	protected:
		virtual inline auto onWidgetManagerSet([[maybe_unused]] WidgetManager& widgetManager) noexcept -> void {}

	private:
		inline auto requestUpdateImpl(Thread::Scheduler::Clock::duration delay) -> void
		{
			if (not hasWidgetManager())
				return;
			getWidgetManager().scheduler.schedule([this]() -> void {
				m_needUpdate = true;
				if (hasWidgetManager())
					getWidgetManager().eventDispatcher.emit<"RequestUpdate">();
			}, delay, this);
		}

		std::optional<std::reference_wrapper<WidgetManager>> m_widgetManagerRef = std::nullopt;
		std::atomic_bool m_needUpdate = true;
	};
}
