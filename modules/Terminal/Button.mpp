export module CppUtils.Terminal.Button;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.Area;
import CppUtils.Terminal.CharCell;
import CppUtils.Terminal.CharAttributes;
import CppUtils.Terminal.TextColor;
import CppUtils.Terminal.BackgroundColor;
import CppUtils.Terminal.Mouse;
import CppUtils.Terminal.Element;
import CppUtils.Terminal.Container;

export namespace CppUtils::Terminal
{
	struct ButtonStyle final
	{
		CharAttributes normal = {TextColor::TextColorEnum::White, BackgroundColor::BackgroundColorEnum::Blue};
		CharAttributes hovered = {TextColor::TextColorEnum::White, BackgroundColor::BackgroundColorEnum::Cyan};
		CharAttributes pressed = {TextColor::TextColorEnum::White, BackgroundColor::BackgroundColorEnum::Black};
	};

	class Button final: public Container
	{
	public:
		explicit inline Button(
			const CppUtils::Container::Size2<>& size,
			std::unique_ptr<Widget> widget = nullptr,
			std::function<void()> onClick = {},
			Margin margin = {},
			Padding padding = {},
			BorderStyle borderStyle = {}):
			Container{size, std::move(widget), PositionType::Relative, margin, padding, borderStyle},
			m_onClick{std::move(onClick)}
		{
			if (m_widget)
				m_widget->requestUpdate();
		}

		inline auto setStyle(this auto&& self, const ButtonStyle& style) noexcept -> decltype(auto)
		{
			self.m_style = style;
			self.requestUpdate();
			return self;
		}

		[[nodiscard]] inline auto getStyle() const noexcept -> const ButtonStyle&
		{
			return m_style;
		}

		inline auto setOnClick(this auto&& self, std::function<void()> onClick) noexcept -> decltype(auto)
		{
			self.m_onClick = std::move(onClick);
			return self;
		}

		inline auto draw(WritableAreaView& view) noexcept -> void override
		{
			const auto size = getSize();
			if (size.width() == 0uz or size.height() == 0uz)
			{
				drawFinished();
				return;
			}

			auto attributes = m_style.normal;
			if (m_isPressed)
				attributes = m_style.pressed;
			else if (m_isHovered)
				attributes = m_style.hovered;

			view.fill(attributes);

			Container::draw(view);

			for (auto y = 0uz; y < size.height(); ++y)
				for (auto x = 0uz; x < size.width(); ++x)
				{
					auto cell = view.getChar({x, y});
					cell.attributes = attributes;
					view.setChar({x, y}, cell);
				}

			drawFinished();
		}

		inline auto onMouseEvent(const Mouse::Event& event) -> bool override
		{
			const auto wasHovered = m_isHovered;
			const auto wasPressed = m_isPressed;

			const auto size = getSize();
			m_isHovered = (event.relativePosition.x() < size.width() and event.relativePosition.y() < size.height());

			if (m_isHovered)
			{
				if (event.button == Mouse::Button::Left)
				{
					if (event.pressed)
						m_isPressed = true;
					else if (m_isPressed)
					{
						m_isPressed = false;
						if (m_onClick)
							m_onClick();
					}
				}
			}
			else
				m_isPressed = false;

			Container::onMouseEvent(event);

			if (wasHovered != m_isHovered or wasPressed != m_isPressed)
				requestUpdate();

			return m_isHovered;
		}

	private:
		std::function<void()> m_onClick;
		ButtonStyle m_style;
		bool m_isHovered = false;
		bool m_isPressed = false;
	};
}
