module;

#include <cstdio>

export module CppUtils.Terminal.Canvas;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.Utility;
import CppUtils.String.Encoding;
import CppUtils.Terminal.Size;
import CppUtils.Terminal.Cursor;
import CppUtils.Terminal.Area;
import CppUtils.Terminal.Mouse;
import CppUtils.Terminal.CharAttributes;
import CppUtils.Terminal.TextStyle;
import CppUtils.Terminal.TextColor;
import CppUtils.Terminal.BackgroundColor;

export namespace CppUtils::Terminal
{
	class Canvas final: public Area
	{
		using Area::draw;

	public:
		explicit inline Canvas(
			const Container::Size2<>& size = getTerminalSize(),
			const std::optional<Viewport>& optionalViewport = std::nullopt,
			bool clearOnClose = false):
			Area{size, optionalViewport.value_or(Viewport{size, {0, 0}})},
			m_clearOnClose{clearOnClose},
			m_previousBuffer{size}
		{
			m_widgetManager.eventDispatcher.subscribe<"RequestUpdate">([this] {
				print();
			});
			setWidgetManager(m_widgetManager);
			setConsoleOutputUTF8();
			enableAnsi();
		}

		inline ~Canvas() noexcept
		{
			if (m_clearOnClose and not m_firstPrint)
			{
				const auto terminalSize = getTerminalSize();
				const auto viewportSize = m_viewport.getSize();
				const auto startLine = terminalSize.height() > viewportSize.height() ? terminalSize.height() - viewportSize.height() - 1 : 0;
				for (auto y = 0uz; y < viewportSize.height(); ++y)
				{
					setCursorPosition({0, startLine + y});
					std::print("\x1b[2K");
				}
				setCursorPosition({0, startLine});
				std::fflush(stdout);
			}
		}

		inline auto applyDifferences() noexcept -> void
		{
			using namespace std::literals;
			std::fwrite(std::ranges::data(TextStyle::Ansi::EscapeCode::Reset), sizeof(char), std::ranges::size(TextStyle::Ansi::EscapeCode::Reset), stdout);

			const auto terminalSize = getTerminalSize();
			const auto viewportSize = m_viewport.getSize();
			if (viewportSize.width() == 0 or viewportSize.height() == 0)
				return;

			const auto startLine = terminalSize.height() > viewportSize.height() ? terminalSize.height() - viewportSize.height() - 1 : 0;
			auto stringBuffer = ""s;
			auto needFlush = false;
			auto lastAttributes = CharAttributes{};
			auto previousAccessor = m_previousBuffer.uniqueAccess();
			auto currentAccessor = m_buffer.sharedAccess();

			auto flushBuffer = [&]() noexcept {
				if (std::ranges::empty(stringBuffer))
					return;
				std::fwrite(std::ranges::data(stringBuffer), sizeof(decltype(stringBuffer)::value_type), std::ranges::size(stringBuffer), stdout);
				stringBuffer.clear();
				needFlush = true;
			};

			m_viewport.forEach([&](const auto& position) noexcept {
				const auto& currentChar = currentAccessor->getChar(position);
				const auto& previousChar = previousAccessor->getChar(position);

				const auto& currentAttributes = currentChar.attributes;
				const auto& previousAttributes = previousChar.attributes;

				const auto cellChanged = currentChar.character != previousChar.character
					or currentChar.displayWidth != previousChar.displayWidth
					or currentAttributes.textStyle != previousAttributes.textStyle
					or currentAttributes.textColor != previousAttributes.textColor
					or currentAttributes.backgroundColor != previousAttributes.backgroundColor;

				if (cellChanged)
				{
					if (std::ranges::empty(stringBuffer) or position.x() == 0)
					{
						flushBuffer();
						setCursorPosition({position.x(), startLine + position.y()});
					}

					const auto needUpdateTextStyle = currentAttributes.textStyle != lastAttributes.textStyle;
					const auto needUpdateTextColor = currentAttributes.textColor != lastAttributes.textColor;
					const auto needUpdateBackgroundColor = currentAttributes.backgroundColor != lastAttributes.backgroundColor;

					if (needUpdateTextStyle)
					{
						stringBuffer += TextStyle::getTextStyleCode(currentAttributes.textStyle);
						lastAttributes.textStyle = currentAttributes.textStyle;
					}
					if (needUpdateTextColor)
					{
						stringBuffer += TextColor::Ansi::getTextColorCode(currentAttributes.textColor);
						lastAttributes.textColor = currentAttributes.textColor;
					}
					if (needUpdateBackgroundColor)
					{
						stringBuffer += BackgroundColor::Ansi::getBackgroundColorCode(currentAttributes.backgroundColor);
						lastAttributes.backgroundColor = currentAttributes.backgroundColor;
					}
					if (currentChar.displayWidth > 0)
						stringBuffer = String::toUtf8(currentChar.character, std::move(stringBuffer));
					previousAccessor->setChar(position, currentChar);
				}
				else
					flushBuffer();
			});

			flushBuffer();
			if (needFlush)
				std::fflush(stdout);

			if (const auto endLine = startLine + viewportSize.height();
				endLine < terminalSize.height())
				setCursorPosition({0, endLine});
			else
			{
				const auto terminalHeight = getTerminalSize().height();
				setCursorPosition({0, terminalHeight > 0 ? terminalHeight - 1 : 0});
				std::fwrite("\n", sizeof(char), 1, stdout);
				std::fflush(stdout);
			}
		}

		inline auto print() noexcept -> void
		{
			if (m_viewport.getSize().width() == 0 or m_viewport.getSize().height() == 0)
				return;

			auto lock = std::scoped_lock{m_printMutex};
			if (m_widget)
			{
				auto view = getWritableView();
				m_widget->draw(view);
			}
			if (m_firstPrint)
			{
				std::print("{}", std::string(m_viewport.getSize().height(), '\n'));
				m_firstPrint = false;
			}
			applyDifferences();
		}

		inline auto wait() noexcept -> void
		{
			print();
			m_stopEvent.wait(false);
		}

		inline auto close() noexcept -> void
		{
			m_stopEvent.store(true, std::memory_order_release);
			m_stopEvent.notify_all();
		}

		[[nodiscard]] inline auto toString() const -> std::string
		{
			using namespace std::literals;

			auto result = ""s;
			const auto size = getSize();
			auto accessor = m_buffer.sharedAccess();
			for (auto y = 0uz; y < size.height(); ++y)
			{
				for (auto x = 0uz; x < size.width(); ++x)
				{
					const auto cell = accessor->getChar({x, y});
					if (cell.displayWidth > 0)
						result = String::toUtf8(cell.character, std::move(result));
				}
				result += '\n';
			}
			return result;
		}

		[[nodiscard]] inline auto getAbsolutePosition() const noexcept -> Container::Size2<>
		{
			const auto terminalSize = getTerminalSize();
			const auto viewportSize = m_viewport.getSize();
			const auto startLine = terminalSize.height() > viewportSize.height() ? terminalSize.height() - viewportSize.height() - 1 : 0;
			return {m_viewport.getPosition().x(), startLine + m_viewport.getPosition().y()};
		}

		inline auto onMouseEvent(const Mouse::Event& event) -> bool override
		{
			const auto canvasViewport = Viewport{getSize(), getAbsolutePosition()};
			if (not canvasViewport.contains(event.absolutePosition))
				return false;

			auto translatedEvent = event;
			translatedEvent.relativePosition = event.absolutePosition - canvasViewport.getPosition();
			return Area::onMouseEvent(translatedEvent);
		}

	private:
		std::mutex m_printMutex;
		bool m_firstPrint = true;
		std::atomic_bool m_stopEvent = false;
		bool m_clearOnClose = false;
		DynamicAreaBuffer m_previousBuffer;
		WidgetManager m_widgetManager;
	};
}
