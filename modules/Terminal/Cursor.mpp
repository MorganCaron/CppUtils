module;

#include <cstdio>

#include <CppUtils/System/Windows.hpp>

export module CppUtils.Terminal.Cursor;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.RawTerminal;
import CppUtils.Terminal.TextModifier;
import CppUtils.Terminal.Handle;

export namespace CppUtils::Terminal
{
#if defined(OS_WINDOWS)
	[[nodiscard]] inline auto getCursorPosition() -> std::expected<Container::Size2, std::string_view>
	{
		auto consoleScreenBufferInfo = CONSOLE_SCREEN_BUFFER_INFO{};
		GetConsoleScreenBufferInfo(getTerminalHandle(stdout), std::addressof(consoleScreenBufferInfo));
		return Container::Size2{
			consoleScreenBufferInfo.dwCursorPosition.X,
			consoleScreenBufferInfo.dwCursorPosition.Y};
	}
#elif defined(OS_LINUX) or defined(OS_MACOS)
	[[nodiscard]] inline auto getCursorPosition() -> std::expected<Container::Size2, std::string_view>
	{
		using namespace std::literals;

		auto rawTerminal = RawTerminal{};
		std::print("{}", Ansi::EscapeCode::GetCursorPosition);
		std::fflush(stdout);

		const auto [response, sentinel] = rawTerminal.read('R');
		if (sentinel == '\0')
			return std::unexpected{"Cursor position retrieval failure"sv};

		auto rows = 0, columns = 0;
		if (std::sscanf(std::ranges::data(response), "\x1b[%d;%d", std::addressof(rows), std::addressof(columns)) == 2)
			return Container::Size2{static_cast<std::size_t>(columns - 1), static_cast<std::size_t>(rows - 1)};
		return std::unexpected{"Cursor position retrieval failure"sv};
	}
#endif

#if defined(OS_WINDOWS)
	inline auto setCursorPosition(Container::Size2 position) -> void
	{
		SetConsoleCursorPosition(getTerminalHandle(stdout), COORD{static_cast<SHORT>(position.x()), static_cast<SHORT>(position.y())});
	}
#elif defined(OS_LINUX) or defined(OS_MACOS)
	inline auto setCursorPosition(Container::Size2 position) -> void
	{
		std::print(Ansi::EscapeCode::SetCursorPosition, position.y() + 1, position.x() + 1);
	}
#endif
}
