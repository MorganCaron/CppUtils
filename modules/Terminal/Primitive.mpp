export module CppUtils.Terminal.Primitive;

import std;
import CppUtils.Terminal.Area;
import CppUtils.Terminal.CharAttributes;
import CppUtils.Terminal.CharCell;
import CppUtils.Container.Size;

export namespace CppUtils::Terminal
{
	enum class PrimitiveStyle
	{
		Outline,
		Filled
	};

	inline auto drawLine(WritableAreaView& view, const Container::Size2<>& start, const Container::Size2<>& end, const CharCell& c) -> void
	{
		{
			const auto startX = start.x();
			const auto startY = start.y();
			const auto endX = end.x();
			const auto endY = end.y();

			if (startY == endY)
			{
				const auto minX = std::ranges::min(startX, endX);
				const auto maxX = std::ranges::max(startX, endX);
				for (auto x = minX; x <= maxX; ++x)
					view.setChar({x, startY}, c);
				return;
			}

			if (startX == endX)
			{
				const auto minY = std::ranges::min(startY, endY);
				const auto maxY = std::ranges::max(startY, endY);
				for (auto y = minY; y <= maxY; ++y)
					view.setChar({startX, y}, c);
				return;
			}
		}

		auto startX = static_cast<int>(start.x());
		auto startY = static_cast<int>(start.y());
		const auto endX = static_cast<int>(end.x());
		const auto endY = static_cast<int>(end.y());

		// https://fr.wikipedia.org/wiki/Algorithme_de_trac%C3%A9_de_segment_de_Bresenham
		const auto deltaX = std::abs(endX - startX);
		const auto deltaY = -std::abs(endY - startY);
		const auto stepX = startX < endX ? 1 : -1;
		const auto stepY = startY < endY ? 1 : -1;
		auto drift = deltaX + deltaY;

		while (true)
		{
			if (startX >= 0 and startY >= 0)
				view.setChar({static_cast<std::size_t>(startX), static_cast<std::size_t>(startY)}, c);

			if (startX == endX and startY == endY)
				break;
			const auto doubleDrift = 2 * drift;
			if (doubleDrift >= deltaY)
			{
				drift += deltaY;
				startX += stepX;
			}
			if (doubleDrift <= deltaX)
			{
				drift += deltaX;
				startY += stepY;
			}
		}
	}

	inline auto drawRectangle(WritableAreaView& view, const Container::Size2<>& topLeft, const Container::Size2<>& size, PrimitiveStyle style, const CharCell& c) -> void
	{
		if (size.width() == 0 or size.height() == 0)
			return;

		const auto x = topLeft.x();
		const auto y = topLeft.y();
		const auto width = size.width();
		const auto height = size.height();

		if (style == PrimitiveStyle::Outline)
		{
			const auto topRight = Container::Size2{x + width - 1, y};
			const auto bottomLeft = Container::Size2{x, y + height - 1};
			const auto bottomRight = Container::Size2{x + width - 1, y + height - 1};

			drawLine(view, topLeft, topRight, c);
			drawLine(view, bottomLeft, bottomRight, c);
			drawLine(view, topLeft, bottomLeft, c);
			drawLine(view, topRight, bottomRight, c);
		}
		else
			for (auto currentY = y; currentY < y + height; ++currentY)
				for (auto currentX = x; currentX < x + width; ++currentX)
					view.setChar({currentX, currentY}, c);
	}

	inline auto drawCircle(WritableAreaView& view, const Container::Size2<>& center, std::size_t radius, PrimitiveStyle style, const CharCell& c) -> void
	{
		// https://fr.wikipedia.org/wiki/Algorithme_de_trac%C3%A9_d%27arc_de_cercle_de_Bresenham
		auto centerX = static_cast<int>(center.x());
		auto centerY = static_cast<int>(center.y());
		auto signedRadius = static_cast<int>(radius);

		auto x = 0;
		auto y = signedRadius;
		auto drift = 3 - 2 * signedRadius;

		auto drawPoint = [&](int px, int py) {
			if (px >= 0 and py >= 0)
				view.setChar({static_cast<std::size_t>(px), static_cast<std::size_t>(py)}, c);
		};

		while (y >= x)
		{
			if (style == PrimitiveStyle::Outline)
			{
				drawPoint(centerX + x, centerY + y);
				drawPoint(centerX - x, centerY + y);
				drawPoint(centerX + x, centerY - y);
				drawPoint(centerX - x, centerY - y);
				drawPoint(centerX + y, centerY + x);
				drawPoint(centerX - y, centerY + x);
				drawPoint(centerX + y, centerY - x);
				drawPoint(centerX - y, centerY - x);
			}
			else
			{
				for (auto i = centerX - x; i <= centerX + x; ++i)
				{
					drawPoint(i, centerY + y);
					drawPoint(i, centerY - y);
				}
				for (auto i = centerX - y; i <= centerX + y; ++i)
				{
					drawPoint(i, centerY + x);
					drawPoint(i, centerY - x);
				}
			}

			x++;
			if (drift > 0)
			{
				y--;
				drift = drift + 4 * (x - y) + 10;
			}
			else
				drift = drift + 4 * x + 6;
		}
	}

	inline auto drawEllipse(WritableAreaView& view, const Container::Size2<>& start, const Container::Size2<>& end, PrimitiveStyle style, const CharCell& c) -> void
	{
		// https://fr.wikipedia.org/wiki/Algorithme_de_trac%C3%A9_d%27arc_de_cercle_de_Bresenham
		auto startX = static_cast<int>(start.x());
		auto startY = static_cast<int>(start.y());
		auto endX = static_cast<int>(end.x());
		auto endY = static_cast<int>(end.y());

		if (startX > endX)
			std::ranges::swap(startX, endX);
		if (startY > endY)
			std::ranges::swap(startY, endY);

		auto width = std::abs(endX - startX);
		auto height = std::abs(endY - startY);
		auto isHeightOdd = height & 1;

		auto deltaX = 4 * (1.0 - width) * height * height;
		auto deltaY = 4.0 * (isHeightOdd + 1) * width * width;
		auto drift = deltaX + deltaY + isHeightOdd * width * width;
		auto doubleDrift = 0.0;

		startY += (height + 1) / 2;
		endY = startY - isHeightOdd;
		width *= 8 * width;
		isHeightOdd = 8 * height * height;

		auto drawPoint = [&](int px, int py) {
			if (px >= 0 and py >= 0)
				view.setChar({static_cast<std::size_t>(px), static_cast<std::size_t>(py)}, c);
		};

		do
		{
			if (style == PrimitiveStyle::Outline)
			{
				drawPoint(endX, startY);
				drawPoint(startX, startY);
				drawPoint(startX, endY);
				drawPoint(endX, endY);
			}
			else
				for (auto x = startX; x <= endX; ++x)
				{
					drawPoint(x, startY);
					drawPoint(x, endY);
				}

			doubleDrift = 2 * drift;
			if (doubleDrift <= deltaY)
			{
				++startY;
				--endY;
				drift += deltaY += width;
			}
			if (doubleDrift >= deltaX || 2 * drift > deltaY)
			{
				++startX;
				--endX;
				drift += deltaX += isHeightOdd;
			}
		}
		while (startX <= endX);

		while (startY - endY < height)
		{
			if (style == PrimitiveStyle::Outline)
			{
				drawPoint(startX - 1, startY);
				drawPoint(endX + 1, startY++);
				drawPoint(startX - 1, endY);
				drawPoint(endX + 1, endY--);
			}
			else
			{
				for (auto x = startX - 1; x <= endX + 1; ++x)
				{
					drawPoint(x, startY);
					drawPoint(x, endY);
				}
				++startY;
				--endY;
			}
		}
	}
}
