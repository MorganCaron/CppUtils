export module CppUtils.Terminal.AreaBuffer;

import std;
import CppUtils.Container.Size;
import CppUtils.Terminal.CharAttributes;
import CppUtils.Terminal.CharCell;
import CppUtils.String.Encoding;

export namespace CppUtils::Terminal
{
	class AreaBuffer
	{
	public:
		[[nodiscard]] virtual auto getChar(const Container::Size2& position) const noexcept -> const CharCell& = 0;
		virtual auto setChar(const Container::Size2& position, const CharCell& c) noexcept -> void = 0;
		[[nodiscard]] virtual auto getSize() const noexcept -> Container::Size2 = 0;

		[[nodiscard]] inline virtual auto toString() const -> std::string
		{
			auto result = std::string{};
			for (auto y = 0uz; y < getSize().height(); ++y)
			{
				for (auto x = 0uz; x < getSize().width(); ++x)
				{
					const auto& charCell = getChar(Container::Size2{x, y});
					if (charCell.displayWidth > 0)
						result += String::toUtf8(charCell.character);
				}
				result += '\n';
			}
			return result;
		}

		inline auto printText(Container::Size2 position, std::string_view text, const CharAttributes& style = {}) noexcept -> void
		{
			for (auto i = 0uz; i < std::ranges::size(text);)
			{
				if (position.x() >= getSize().width())
				{
					position.x() = 0;
					++position.y();
				}
				if (position.y() >= getSize().height())
					return;

				auto bytesConsumed = 0uz;
				const auto cell = CharCell{text.substr(i), style, bytesConsumed};
				setChar(position, cell);

				if (cell.displayWidth == 2 and position.x() + 1 < getSize().width())
					setChar(Container::Size2{position.x() + 1, position.y()}, CharCell{U' ', style, 0});
				position.x() += cell.displayWidth;
				i += bytesConsumed;
			}
		}
	};
}
