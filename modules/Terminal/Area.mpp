export module CppUtils.Terminal.Area;

import std;
import CppUtils.Container.Size;
export import CppUtils.Terminal.CharAttributes;
export import CppUtils.Terminal.CharCell;
export import :DynamicAreaBuffer;
export import :Viewport;
export import :Widget;
export import :WidgetManager;
export import :WritableAreaView;

export namespace CppUtils::Terminal
{
	class Area: public Widget
	{
	public:
		inline Area(const Container::Size2<>& size, const Viewport& viewport = {{0, 0}, {0, 0}}):
			m_buffer{size},
			m_viewport{(viewport.getSize().width() == 0 or viewport.getSize().height() == 0) ? Viewport{size} : viewport}
		{}

		template<std::derived_from<Widget> T>
		inline auto addWidget(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]], std::unique_ptr<T> widget) -> T&
		{
			self.m_widget = std::move(widget);
			if (self.hasWidgetManager())
				self.m_widget->setWidgetManager(self.getWidgetManager());
			self.requestUpdate();
			return dynamic_cast<T&>(*self.m_widget);
		}

		inline auto setViewport(const Viewport& viewport) noexcept -> void
		{
			m_viewport = viewport;
		}

	protected:
		inline auto onWidgetManagerSet(WidgetManager& widgetManager) noexcept -> void override
		{
			if (m_widget)
				m_widget->setWidgetManager(widgetManager);
		}

	public:
		[[nodiscard]] inline auto getSize() const noexcept -> Container::Size2<> override
		{
			return m_viewport.getSize();
		}

		[[nodiscard]] inline auto getViewport(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) noexcept -> decltype(auto)
		{
			return (self.m_viewport);
		}

		[[nodiscard]] inline auto getWritableView(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]], std::optional<Viewport> viewport = std::nullopt) -> WritableAreaView
		{
			return WritableAreaView{self.m_buffer, viewport.value_or(self.m_viewport)};
		}

		inline auto draw(WritableAreaView& view) noexcept -> void override
		{
			if (m_widget)
				m_widget->draw(view);
		}

		inline auto onMouseEvent(const Mouse::Event& event) -> bool override
		{
			if (not m_widget)
				return false;
			return m_widget->onMouseEvent(event);
		}

		[[nodiscard]] inline auto getBuffer(this auto&& self [[clang::lifetimebound, msvc::lifetimebound]]) noexcept -> decltype(auto)
		{
			return (self.m_buffer);
		}

	protected:
		DynamicAreaBuffer m_buffer;
		Viewport m_viewport;
		std::unique_ptr<Widget> m_widget;
	};
}
