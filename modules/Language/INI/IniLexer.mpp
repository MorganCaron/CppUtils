export module CppUtils.Language.Ini;

import std;
import CppUtils.Type;
import CppUtils.String;
import CppUtils.Container.Tree;
import CppUtils.Language.Lexer;

export namespace CppUtils::Language::Ini
{
	class IniLexer final
	{
	public:
		inline IniLexer()
		{
			using namespace std::literals;
			using namespace String::Literals;

			m_grammarLexer.addParsingFunction("spaceParser"_token, Lexer::spaceParser<Type::Token, bool, float>);
			m_grammarLexer.addParsingFunction("commentParser"_token, commentParser);
			m_grammarLexer.addParsingFunction("sectionIdentifierParser"_token, sectionIdentifierParser);
			m_grammarLexer.addParsingFunction("keyIdentifierParser"_token, keyIdentifierParser);
			m_grammarLexer.addParsingFunction("booleanParser"_token, Lexer::booleanParser<Type::Token, bool, float>);
			m_grammarLexer.addParsingFunction("floatParser"_token, Lexer::floatParser<Type::Token, bool, float>);
			m_grammarLexer.addParsingFunction("stringParser"_token, stringParser);

			static constexpr auto grammarSrc = R"(
			main: (line >= 0) spaceParser;
			!line: spaceParser (comment || section || assignment);
			!sectionName: sectionIdentifierParser;
			!keyName: keyIdentifierParser;
			!comment: spaceParser commentParser;
			section: '[' spaceParser [sectionName] spaceParser ']' ~comment assignments;
			!assignments: (_assignment >= 0) ~comment;
			assignment: _assignment;
			!_assignment: spaceParser [keyName] '=' value ~comment;
			!value: spaceParser (boolean || float || string);
			boolean: booleanParser;
			float: floatParser;
			string: stringParser;
			)"sv;
			m_grammarLexer.parseGrammar(grammarSrc);
		}

		[[nodiscard]] inline auto parse(std::string_view src) const -> Container::Tree::VariantNode<Type::Token, bool, float>
		{
			using namespace String::Literals;
			return m_grammarLexer.parseLanguage("main"_token, src);
		}

	private:
		[[nodiscard]] static inline auto identifierParser(Lexer::Context<Type::Token, bool, float>& context, char delimiter) -> bool
		{
			auto& [cursor, parentNode, firstChildPosition, parsingErrors] = context;
			const auto string = std::string{String::trimString(String::getStringAndSkipIf(cursor, [delimiter](char character) -> bool
			{
				return character != delimiter and character != ';' and character != '[' and character != ']' and (std::isspace(static_cast<unsigned char>(character)) or std::isgraph(static_cast<unsigned char>(character)));
			}))};
			if (std::ranges::empty(string))
				return false;
			auto stringToken = Type::hash(string);
			parentNode.get().nodes.emplace_back(stringToken);
			return true;
		}

		[[nodiscard]] static inline auto commentParser(Lexer::Context<Type::Token, bool, float>& context) -> bool
		{
			auto& [cursor, parentNode, firstChildPosition, parsingErrors] = context;
			if (String::isEndOfString(cursor) or String::getChar(cursor) != ';')
				return false;
			++cursor.position;
			while (not String::isEndOfString(cursor) and String::getChar(cursor) != '\n')
				++cursor.position;
			if (not String::isEndOfString(cursor))
				++cursor.position;
			return true;
		}

		[[nodiscard]] static inline auto sectionIdentifierParser(Lexer::Context<Type::Token, bool, float>& context) -> bool
		{
			return identifierParser(context, ']');
		}

		[[nodiscard]] static inline auto keyIdentifierParser(Lexer::Context<Type::Token, bool, float>& context) -> bool
		{
			return identifierParser(context, '=');
		}

		[[nodiscard]] static inline auto stringParser(Lexer::Context<Type::Token, bool, float>& context) -> bool
		{
			return identifierParser(context, '\n');
		}

		Lexer::GrammarLexer<Type::Token, bool, float> m_grammarLexer;
	};

	[[nodiscard]] inline auto parse(std::string_view src) -> Container::Tree::VariantNode<Type::Token, bool, float>
	{
		static const auto iniLexer = IniLexer{};
		return iniLexer.parse(src);
	}

	namespace Literals
	{
		[[nodiscard]] inline auto operator""_ini(const char* cstring, std::size_t) -> Container::Tree::VariantNode<Type::Token, bool, float>
		{
			return parse(cstring);
		}
	}
}
