export module CppUtils.Language.Xml;

import std;
import CppUtils.Type;
import CppUtils.String;
import CppUtils.Container.Tree;
import CppUtils.Language.Lexer;

export namespace CppUtils::Language::Xml
{
	class XmlLexer final
	{
	public:
		inline XmlLexer()
		{
			using namespace std::literals;
			using namespace String::Literals;

			m_grammarLexer.addParsingFunction("spaceParser"_token, Lexer::spaceParser<Type::Token, std::string>);
			m_grammarLexer.addParsingFunction("keywordParser"_token, Lexer::keywordParser<Type::Token, std::string>);
			m_grammarLexer.addParsingFunction("quoteParser"_token, Lexer::quoteParser<Type::Token, std::string>);
			m_grammarLexer.addParsingFunction("textParser"_token, textParser);
			m_grammarLexer.addParsingFunction("openingTagParser"_token, openingTagParser);
			m_grammarLexer.addParsingFunction("closingTagValidator"_token, closingTagValidator);

			static constexpr auto grammarSrc = R"(
			main: tags spaceParser;
			!tags: (tag >= 0);
			!tag: [openingTag] content closingTag;
			!openingTag: spaceParser openingTagParser [tagName] ~attributes spaceParser '>';
			!closingTag: spaceParser "</" tagName closingTagValidator spaceParser '>';
			!tagName: spaceParser keywordParser;
			attributes: (attribute >= 1);
			!attribute: spaceParser [attributeName] spaceParser '=' attributeValue;
			!attributeName: spaceParser keywordParser;
			!attributeValue: spaceParser quoteParser;
			!content: (text || tag) ~content;
			!text: spaceParser textParser;
			)"sv;
			m_grammarLexer.parseGrammar(grammarSrc);
		}

		[[nodiscard]] inline auto parse(std::string_view src) const -> Container::Tree::VariantNode<Type::Token, std::string>
		{
			using namespace String::Literals;
			return m_grammarLexer.parseLanguage("main"_token, src);
		}

	private:
		[[nodiscard]] static inline auto textParser(Lexer::Context<Type::Token, std::string>& context) -> bool
		{
			auto& [cursor, parentNode, firstChildPosition, parsingErrors] = context;
			const auto string = std::string{String::trimString(String::getStringAndSkipIf(cursor, [](char character) -> bool
			{
				return character != '<';
			}))};
			if (std::ranges::empty(string))
				return false;
			parentNode.get().nodes.emplace_back(std::move(string));
			return true;
		}

		[[nodiscard]] static inline auto openingTagParser(Lexer::Context<Type::Token, std::string>& context) -> bool
		{
			auto& [cursor, parentNode, firstChildPosition, parsingErrors] = context;
			return (not String::isEndOfString(cursor) and String::getCharAndSkip(cursor) == '<' and not String::isEndOfString(cursor) and String::getChar(cursor) != '/');
		}

		[[nodiscard]] static inline auto closingTagValidator(Lexer::Context<Type::Token, std::string>& context) -> bool
		{
			auto& parentNode = context.parentNode.get();
			if (std::ranges::empty(parentNode.nodes))
				return false;
			const auto& closingTag = parentNode.nodes.back().value;
			if (closingTag != parentNode.value)
				return false;
			parentNode.nodes.pop_back();
			return true;
		}

		Lexer::GrammarLexer<Type::Token, std::string> m_grammarLexer;
	};

	[[nodiscard]] inline auto parse(std::string_view src) -> Container::Tree::VariantNode<Type::Token, std::string>
	{
		static const auto xmlLexer = XmlLexer{};
		return xmlLexer.parse(src);
	}

	namespace Literals
	{
		[[nodiscard]] inline auto operator""_xml(const char* cstring, std::size_t) -> Container::Tree::VariantNode<Type::Token, std::string>
		{
			return parse(cstring);
		}
	}
}
