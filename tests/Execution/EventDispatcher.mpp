export module CppUtils.UnitTests.Execution.EventDispatcher;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Execution::EventDispatcher
{
	auto _ = TestSuite{
		"Execution/EventDispatcher", {"Logger"}, [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::String::Literals;
		using Logger = TestSuite::Logger;

		suite.addTest("Empty", [&] {
			auto _ = CppUtils::Execution::EventDispatcher{};
		});

		suite.addTest("Subscribe", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<>([&suite](const std::string& message) -> void {
				Logger::print("{}", message);
				suite.expect(false);
			});
		});

		suite.addTest("Subscribe with name", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<"Ping">([&suite](const std::string& message) -> void {
				Logger::print("{}", message);
				suite.expect(false);
			});
		});

		suite.addTest("Emit without subscribers", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			eventDispatcher.emit<>("ping"s);
			eventDispatcher.emit<"Ping">("ping"s);
		});

		suite.addTest("Send/Receive", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<>([&expectPingReceived, &suite](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				suite.expectEqual(message, "ping"sv);
			});
			eventDispatcher.emit<>("ping"s);

			suite.expect(expectPingReceived);
		});

		suite.addTest("Send/Receive with name", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<"Ping">([&expectPingReceived, &suite](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				suite.expectEqual(message, "ping"sv);
			});
			eventDispatcher.subscribe<"Other">([&suite](const std::string& message) -> void {
				Logger::print("{}", message);
				suite.expect(false);
			});
			eventDispatcher.emit<"Ping">("ping"s);

			suite.expect(expectPingReceived);
		});

		suite.addTest("Cascade calls", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};
			auto expectPongReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<"Ping">([&expectPingReceived, &suite, &eventDispatcher](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				suite.expectEqual(message, "ping"sv);
				eventDispatcher.emit<"Pong">("pong"s);
			});
			eventDispatcher.subscribe<"Pong">([&expectPongReceived, &suite](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPongReceived = true;
				suite.expectEqual(message, "pong"sv);
			});
			eventDispatcher.emit<"Ping">("ping"s);

			suite.expect(expectPingReceived);
			suite.expect(expectPongReceived);
		});

		suite.addTest("Multiple subscribers", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expect1 = std::atomic_bool{false};
			auto expect2 = std::atomic_bool{false};

			eventDispatcher.subscribe<"Event">([&expect1]() -> void {
				expect1 = true;
			});
			eventDispatcher.subscribe<"Event">([&expect2]() -> void {
				expect2 = true;
			});
			eventDispatcher.emit<"Event">();

			suite.expect(expect1);
			suite.expect(expect2);
		});

		suite.addTest("Mutable Lambda", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<"Count">([count = 0, &suite](int expected) mutable {
				++count;
				suite.expectEqual(count, expected);
			});

			eventDispatcher.emit<"Count">(1);
			eventDispatcher.emit<"Count">(2);
			eventDispatcher.emit<"Count">(3);
		});

		suite.addTest("Multiple subscribe", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = std::atomic_size_t{0};

			eventDispatcher.subscribe<"A", "B", "C">([&count] {
				++count;
			});

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			eventDispatcher.emit<"C">();
			eventDispatcher.emit<"D">();

			suite.expectEqual(count, 3uz);
		});

		suite.addTest("Unsubscribe", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			const auto subscriptionIdentifier = eventDispatcher.subscribe<"Event">([&count] {
				++count;
			});

			eventDispatcher.emit<"Event">();
			suite.expectEqual(count, 1uz);

			suite.expect(eventDispatcher.unsubscribe(subscriptionIdentifier));

			eventDispatcher.emit<"Event">();
			suite.expectEqual(count, 1uz);
		});

		suite.addTest("Clear subscribers", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			eventDispatcher.subscribe<"A">([&count] { ++count; });
			eventDispatcher.subscribe<"B">([&count] { ++count; });

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			suite.expectEqual(count, 2uz);

			eventDispatcher.clearSubscribers();

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			suite.expectEqual(count, 2uz);
		});

		suite.addTest("Unsubscribe by event hash", [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			eventDispatcher.subscribe<"Event">([&count] { ++count; });
			eventDispatcher.subscribe<"Other">([&count] { ++count; });

			eventDispatcher.emit<"Event">();
			eventDispatcher.emit<"Other">();
			suite.expectEqual(count, 2uz);

			suite.expect(eventDispatcher.unsubscribe<"Event">());

			eventDispatcher.emit<"Event">();
			eventDispatcher.emit<"Other">();
			suite.expectEqual(count, 3uz);

			suite.expect(not eventDispatcher.unsubscribe<"Event">());

			suite.expect(eventDispatcher.unsubscribe("Other"_hash));

			eventDispatcher.emit<"Other">();
			suite.expectEqual(count, 3uz);
		});
	}};
}
