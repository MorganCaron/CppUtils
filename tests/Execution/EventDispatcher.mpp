export module CppUtils.UnitTests.Execution.EventDispatcher;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Execution::EventDispatcher
{
	auto _ = testSuite("Execution/EventDispatcher").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::String::Literals;
		using Logger = TestSuite::Logger;

		suite.test("Empty") = [&] {
			auto _ = CppUtils::Execution::EventDispatcher{};
		};

		suite.test("Subscribe") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<>([](const std::string& message) -> void {
				Logger::print("{}", message);
				expect(false);
			});
		};

		suite.test("Subscribe with name") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<"Ping">([](const std::string& message) -> void {
				Logger::print("{}", message);
				expect(false);
			});
		};

		suite.test("Emit without subscribers") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			eventDispatcher.emit<>("ping"s);
			eventDispatcher.emit<"Ping">("ping"s);
		};

		suite.test("Send/Receive") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<>([&expectPingReceived](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				expect(message) == "ping";
			});
			eventDispatcher.emit<>("ping"s);

			expect(expectPingReceived);
		};

		suite.test("Send/Receive with name") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<"Ping">([&expectPingReceived](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				expect(message) == "ping";
			});
			eventDispatcher.subscribe<"Other">([](const std::string& message) -> void {
				Logger::print("{}", message);
				expect(false);
			});
			eventDispatcher.emit<"Ping">("ping"s);

			expect(expectPingReceived);
		};

		suite.test("Cascade calls") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expectPingReceived = std::atomic_bool{false};
			auto expectPongReceived = std::atomic_bool{false};

			eventDispatcher.subscribe<"Ping">([&expectPingReceived, &eventDispatcher](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPingReceived = true;
				expect(message) == "ping";
				eventDispatcher.emit<"Pong">("pong"s);
			});
			eventDispatcher.subscribe<"Pong">([&expectPongReceived](const std::string& message) -> void {
				Logger::print("{}", message);
				expectPongReceived = true;
				expect(message) == "pong";
			});
			eventDispatcher.emit<"Ping">("ping"s);

			expect(expectPingReceived);
			expect(expectPongReceived);
		};

		suite.test("Multiple subscribers") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto expect1 = std::atomic_bool{false};
			auto expect2 = std::atomic_bool{false};

			eventDispatcher.subscribe<"Event">([&expect1]() -> void {
				expect1 = true;
			});
			eventDispatcher.subscribe<"Event">([&expect2]() -> void {
				expect2 = true;
			});
			eventDispatcher.emit<"Event">();

			expect(expect1);
			expect(expect2);
		};

		suite.test("Mutable Lambda") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};

			eventDispatcher.subscribe<"Count">([count = 0](int expected) mutable {
				++count;
				expect(count) == expected;
			});

			eventDispatcher.emit<"Count">(1);
			eventDispatcher.emit<"Count">(2);
			eventDispatcher.emit<"Count">(3);
		};

		suite.test("Multiple subscribe") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = std::atomic_size_t{0};

			eventDispatcher.subscribe<"A", "B", "C">([&count] {
				++count;
			});

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			eventDispatcher.emit<"C">();
			eventDispatcher.emit<"D">();

			expect(count) == 3uz;
		};

		suite.test("Unsubscribe") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			const auto subscriptionIdentifier = eventDispatcher.subscribe<"Event">([&count] {
				++count;
			});

			eventDispatcher.emit<"Event">();
			expect(count) == 1uz;

			expect(eventDispatcher.unsubscribe(subscriptionIdentifier));

			eventDispatcher.emit<"Event">();
			expect(count) == 1uz;
		};

		suite.test("Clear subscribers") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			eventDispatcher.subscribe<"A">([&count] { ++count; });
			eventDispatcher.subscribe<"B">([&count] { ++count; });

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			expect(count) == 2uz;

			eventDispatcher.clearSubscribers();

			eventDispatcher.emit<"A">();
			eventDispatcher.emit<"B">();
			expect(count) == 2uz;
		};

		suite.test("Unsubscribe by event hash") = [&] {
			auto eventDispatcher = CppUtils::Execution::EventDispatcher{};
			auto count = 0uz;

			eventDispatcher.subscribe<"Event">([&count] { ++count; });
			eventDispatcher.subscribe<"Other">([&count] { ++count; });

			eventDispatcher.emit<"Event">();
			eventDispatcher.emit<"Other">();
			expect(count) == 2uz;

			expect(eventDispatcher.unsubscribe<"Event">());

			eventDispatcher.emit<"Event">();
			eventDispatcher.emit<"Other">();
			expect(count) == 3uz;

			expect(not eventDispatcher.unsubscribe<"Event">());

			expect(eventDispatcher.unsubscribe("Other"_hash));

			eventDispatcher.emit<"Other">();
			expect(count) == 3uz;
		};
	};
}
