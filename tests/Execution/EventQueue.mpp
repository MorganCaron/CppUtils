export module CppUtils.UnitTests.Execution.EventQueue;

import std;
import CppUtils.Execution.EventQueue;
import CppUtils.UnitTest;

namespace CppUtils::UnitTest::Execution::EventQueue
{
	auto _ = TestSuite{"Execution/EventQueue", {"Execution/EventDispatcher", "Thread/UniqueLocker", "Thread/ThreadLoop", "Execution/ScopeGuard", "UnitTest"}, [](TestSuite& suite) {
		suite.addTest("Local EventQueue emission", [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto received = false;
			auto valueReceived = 0;

			queue.subscribe<"test">([&](int value) {
				received = true;
				valueReceived = value;
			});

			queue.emit<"test">(42);
			queue.waitUntilFinished();

			suite.expect(received);
			suite.expectEqual(valueReceived, 42);
		});

		suite.addTest("Multiple subscribe", [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0uz;

			queue.subscribe<"A", "B">([&count] {
				++count;
			});

			queue.emit<"A">();
			queue.emit<"B">();
			queue.emit<"C">();

			queue.waitUntilFinished();
			suite.expectEqual(count, 2uz);
		});

		suite.addTest("Unsubscribe", [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			const CppUtils::Execution::EventQueue::SubscriptionIdentifier subscriptionIdentifier = queue.subscribe<"Event">([&count] {
				++count;
			});

			queue.emit<"Event">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 1);

			suite.expect(queue.unsubscribe(subscriptionIdentifier));

			queue.emit<"Event">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 1);
		});

		suite.addTest("Clear subscribers", [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			queue.subscribe<"A">([&count] { ++count; });
			queue.subscribe<"B">([&count] { ++count; });

			queue.emit<"A">();
			queue.emit<"B">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 2);

			queue.clearSubscribers();

			queue.emit<"A">();
			queue.emit<"B">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 2);
		});

		suite.addTest("Unsubscribe by event hash", [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			queue.subscribe<"Event">([&count] { ++count; });
			queue.subscribe<"Other">([&count] { ++count; });

			queue.emit<"Event">();
			queue.emit<"Other">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 2);

			suite.expect(queue.unsubscribe<"Event">());

			queue.emit<"Event">();
			queue.emit<"Other">();
			queue.waitUntilFinished();
			suite.expectEqual(count, 3);
		});
	}};
}
