export module CppUtils.UnitTests.Execution.EventQueue;

import std;
import CppUtils.Execution.EventQueue;
import CppUtils.UnitTest;

namespace CppUtils::UnitTest::Execution::EventQueue
{
	auto _ = testSuite("Execution/EventQueue").dependsOn("Execution/EventDispatcher", "Thread/UniqueLocker", "Thread/ThreadLoop", "Execution/ScopeGuard", "UnitTest") = [](TestSuite& suite) {
		suite.test("Local EventQueue emission") = [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto received = false;
			auto valueReceived = 0;

			queue.subscribe<"test">([&](int value) {
				received = true;
				valueReceived = value;
			});

			queue.emit<"test">(42);
			queue.waitUntilFinished();

			expect(received);
			expect(valueReceived) == 42;
		};

		suite.test("Multiple subscribe") = [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0uz;

			queue.subscribe<"A", "B">([&count] {
				++count;
			});

			queue.emit<"A">();
			queue.emit<"B">();
			queue.emit<"C">();

			queue.waitUntilFinished();
			expect(count) == 2uz;
		};

		suite.test("Unsubscribe") = [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			const CppUtils::Execution::EventQueue::SubscriptionIdentifier subscriptionIdentifier = queue.subscribe<"Event">([&count] {
				++count;
			});

			queue.emit<"Event">();
			queue.waitUntilFinished();
			expect(count) == 1;

			expect(queue.unsubscribe(subscriptionIdentifier));

			queue.emit<"Event">();
			queue.waitUntilFinished();
			expect(count) == 1;
		};

		suite.test("Clear subscribers") = [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			queue.subscribe<"A">([&count] { ++count; });
			queue.subscribe<"B">([&count] { ++count; });

			queue.emit<"A">();
			queue.emit<"B">();
			queue.waitUntilFinished();
			expect(count) == 2;

			queue.clearSubscribers();

			queue.emit<"A">();
			queue.emit<"B">();
			queue.waitUntilFinished();
			expect(count) == 2;
		};

		suite.test("Unsubscribe by event hash") = [&] {
			auto queue = CppUtils::Execution::EventQueue{};
			auto count = 0;

			queue.subscribe<"Event">([&count] { ++count; });
			queue.subscribe<"Other">([&count] { ++count; });

			queue.emit<"Event">();
			queue.emit<"Other">();
			queue.waitUntilFinished();
			expect(count) == 2;

			expect(queue.unsubscribe<"Event">());

			queue.emit<"Event">();
			queue.emit<"Other">();
			queue.waitUntilFinished();
			expect(count) == 3;
		};
	};
}
