export module CppUtils.UnitTests.Execution.ScopeGuard;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Execution::ScopeGuard
{
	auto _ = testSuite("Execution/ScopeGuard").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test("Basic ScopeGuard") = [&] {
			auto called = false;
			{
				auto _ = CppUtils::Execution::ScopeGuard{[&called]() {
					called = true;
				}};
			}
			expect(called);
		};

		suite.test("ScopeGuard with Exception") = [&] {
			auto called = false;
			try
			{
				auto _ = CppUtils::Execution::ScopeGuard{[&called]() {
					called = true;
				}};
				throw std::runtime_error("Test exception");
			}
			catch (const std::runtime_error&)
			{}
			expect(called);
		};
	};
}
