export module CppUtils.UnitTests.Execution.TryExecute;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Execution::TryExecute
{
	auto _ = testSuite("Execution/TryExecute") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("Function returning value") = [&] {
			const auto result = CppUtils::Execution::tryExecute([] {
				return 42;
			});

			expect(result.has_value());
			expect(result.value()) == 42;
		};

		suite.test("Function returning void") = [&] {
			auto executed = false;
			const auto result = CppUtils::Execution::tryExecute([&] {
				executed = true;
			});

			expect(executed);
			expect(result.has_value());
		};

		suite.test("Function throwing std::exception") = [&] {
			const auto result = CppUtils::Execution::tryExecute([] -> int {
				throw std::runtime_error{"disk read failed"};
			});

			expect(not result.has_value());
			expect(result.error()) == "disk read failed";
		};

		suite.test("Function throwing non-std exception") = [&] {
			const auto result = CppUtils::Execution::tryExecute([] -> int {
				throw 123;
			});

			expect(not result.has_value());
			expect(result.error()) == "Unknown exception";
		};
	};
}
