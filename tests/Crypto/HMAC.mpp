export module CppUtils.UnitTests.Crypto.HMAC;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Crypto::HMAC
{
	auto _ = testSuite("Crypto/HMAC").dependsOn("String/Utility", "Crypto/SHA256") = [](TestSuite& suite) {
		suite.test("Empty key, empty message") = [&] {
			auto hmac = CppUtils::Crypto::HMAC<CppUtils::Crypto::SHA256>::sign("", "");
			expect(CppUtils::String::toHexString(hmac)) == "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad";
		};

		suite.test("Test Case 1") = [&] {
			auto hmac = CppUtils::Crypto::HMAC<CppUtils::Crypto::SHA256>::sign("key", "The quick brown fox jumps over the lazy dog");
			expect(CppUtils::String::toHexString(hmac)) == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8";
		};
	};
}
