export module CppUtils.UnitTests.Crypto.SHA256;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Crypto::SHA256
{
	auto _ = testSuite("Crypto/SHA256").dependsOn("String/Utility") = [](TestSuite& suite) {
		suite.test("Empty string") = [&] {
			const auto hash = CppUtils::Crypto::SHA256::hash("");
			expect(CppUtils::String::toHexString(hash)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
		};

		suite.test("Test vector 1") = [&] {
			const auto hash = CppUtils::Crypto::SHA256::hash("abc");
			expect(CppUtils::String::toHexString(hash)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
		};

		suite.test("Test vector 2") = [&] {
			const auto hash = CppUtils::Crypto::SHA256::hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
			expect(CppUtils::String::toHexString(hash)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
		};

		suite.test("Multi-step update") = [&] {
			auto sha = CppUtils::Crypto::SHA256{};
			sha.update("a");
			sha.update("b");
			sha.update("c");
			const auto hash = sha.digest();
			expect(CppUtils::String::toHexString(hash)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
		};
	};
}
