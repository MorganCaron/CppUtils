export module CppUtils.UnitTests.Memory;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Memory
{
	auto _ = testSuite("Memory").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test("moveRawPointer") = [&] {
			auto* ptr = new int{42};
			auto value = CppUtils::Memory::moveRawPointer(ptr);
			expect(value) == 42;
		};
	};
}
