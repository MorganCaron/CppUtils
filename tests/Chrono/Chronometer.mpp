export module CppUtils.UnitTests.Chrono.Chronometer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Chrono::Chronometer
{
	auto _ = testSuite("Chrono").dependsOn("Logger") = [](TestSuite& suite) {
		using Logger = TestSuite::Logger;

		suite.test("Chronometer") = [&] {
			auto chrono = CppUtils::Chrono::Chronometer{};
			chrono.stop();
			auto string = CppUtils::Chrono::durationToString(chrono.elapsed());
			expect(not std::ranges::empty(string));
			Logger::print("{}", string);
		};
	};
}
