export module CppUtils.UnitTests.String.Utility;

import std;
import CppUtils;

namespace CppUtils::UnitTest::String::Utility
{
	auto _ = testSuite("String/Utility").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("trimString") = [&] {
			auto string = "\n \t Hello World!\n \t ";
			auto leftTrimString = CppUtils::String::leftTrimString(string);
			auto rightTrimString = CppUtils::String::rightTrimString(string);
			auto trimString = CppUtils::String::trimString(string);

			Logger::print(R"("{}")", leftTrimString);
			expect(leftTrimString) == "Hello World!\n \t ";

			Logger::print(R"("{}")", rightTrimString);
			expect(rightTrimString) == "\n \t Hello World!";

			Logger::print(R"("{}")", trimString);
			expect(trimString) == "Hello World!";
		};

		suite.test("getPrintableChar") = [&] {
			auto output = ""s;
			for (char c = 0; c >= 0; ++c)
				output += CppUtils::String::getPrintableChar(c) + ' ';
			Logger::print("{}", output);
		};

		suite.test("getNumberLength") = [&] {
			expect(CppUtils::String::getNumberLength(0)) == 1uz;
			expect(CppUtils::String::getNumberLength(1)) == 1uz;
			expect(CppUtils::String::getNumberLength(2)) == 1uz;
			expect(CppUtils::String::getNumberLength(10)) == 2uz;

			expect(CppUtils::String::getNumberLength(-1)) == 2uz;
			expect(CppUtils::String::getNumberLength(-2)) == 2uz;
			expect(CppUtils::String::getNumberLength(-10)) == 3uz;

			expect(CppUtils::String::getNumberLength(0, 2)) == 1uz;
			expect(CppUtils::String::getNumberLength(1, 2)) == 1uz;
			expect(CppUtils::String::getNumberLength(2, 2)) == 2uz;
			expect(CppUtils::String::getNumberLength(10, 2)) == 4uz;
		};

		suite.test("toString") = [&] {
			expect(CppUtils::String::toString<2>(0)) == "0";
			expect(CppUtils::String::toString<2>(1)) == "1";
			expect(CppUtils::String::toString<2>(2)) == "10";
			expect(CppUtils::String::toString<2>(10)) == "1010";

			expect(CppUtils::String::toString(0)) == "0";
			expect(CppUtils::String::toString(1)) == "1";
			expect(CppUtils::String::toString(-1)) == "-1";

			expect(CppUtils::String::toString(42)) == "42";
			expect(CppUtils::String::toString(42u)) == "42";
			expect(CppUtils::String::toString(42uz)) == "42";
			expect(CppUtils::String::toString(42ll)) == "42";

			expect(CppUtils::String::toString(-42)) == "-42";
			expect(CppUtils::String::toString(-42ll)) == "-42";

			expect(CppUtils::String::toString(123'456)) == "123456";
			expect(CppUtils::String::toString(-123'456)) == "-123456";
		};

		suite.test("split") = [&] {
			auto splitString = CppUtils::String::split("Hello World!", " ");
			expect(std::ranges::size(splitString)) == 2uz;
			expect(splitString[0]) == "Hello";
			expect(splitString[1]) == "World!";
		};

		suite.test("toHexString") = [&] {
			const auto data = std::array{std::byte{0x00}, std::byte{0x0f}, std::byte{0x10}, std::byte{0xff}};
			expect(CppUtils::String::toHexString(data)) == "000f10ff";
			expect(CppUtils::String::toHexString("Hello")) == "48656c6c6f";
		};

		suite.test("fromHexString") = [&] {
			const auto decoded = CppUtils::String::fromHexString("000f10ff");
			const auto expectedData = std::array{std::byte{0x00}, std::byte{0x0f}, std::byte{0x10}, std::byte{0xff}};
			expect(std::ranges::equal(decoded, expectedData));
		};

		suite.test("toLowercase") = [&] {
			expect(CppUtils::String::toLowercase('A')) == 'a';
			expect(CppUtils::String::toLowercase("HELLO")) == "hello";
			const auto original = std::string{"HELLO"};
			expect(CppUtils::String::toLowercase(original)) == "hello";
			expect(CppUtils::String::toLowercase(std::string{"HELLO"})) == "hello";
			expect(CppUtils::String::toLowercase("HELLO"sv)) == "hello";
			expect(CppUtils::String::toLowercase(L"HELLO"sv)) == L"hello";
		};

		suite.test("toUppercase") = [&] {
			expect(CppUtils::String::toUppercase('a')) == 'A';
			expect(CppUtils::String::toUppercase("hello")) == "HELLO";
			const auto original = std::string{"hello"};
			expect(CppUtils::String::toUppercase(original)) == "HELLO";
			expect(CppUtils::String::toUppercase(std::string{"hello"})) == "HELLO";
			expect(CppUtils::String::toUppercase("hello"sv)) == "HELLO";
			expect(CppUtils::String::toUppercase(L"hello"sv)) == L"HELLO";
		};

		suite.test("formatValue") = [&] {
			expect(CppUtils::String::formatValue(42)) == "42";
			expect(CppUtils::String::formatValue("hello")) == "hello";
			expect(CppUtils::String::formatValue(std::byte{0x2A})) == "0x2A";

			const auto vector = std::vector<int>{1, 2, 3};
			expect(CppUtils::String::formatValue(vector)) == "[1, 2, 3]";

			const auto stringVector = std::vector<std::string>{"foo", "bar"};
			expect(CppUtils::String::formatValue(stringVector)) == R"(["foo", "bar"])";

			const auto pair = std::pair{1, "test"};
			expect(CppUtils::String::formatValue(pair)) == R"((1, "test"))";

			const auto tuple = std::tuple{1, 2.5, "item"};
			expect(CppUtils::String::formatValue(tuple)) == R"((1, 2.5, "item"))";

			const auto variant = std::variant<int, std::string>{"active"};
			expect(CppUtils::String::formatValue(variant)) == "active";

			const auto path = std::filesystem::path{"/usr/local/bin"};
			expect(CppUtils::String::formatValue(path)) == "/usr/local/bin";

			const auto emptyOptional = std::optional<int>{};
			expect(CppUtils::String::formatValue(emptyOptional)) == "nullopt";

			const auto populatedOptional = std::optional<std::string>{"hello"};
			expect(CppUtils::String::formatValue(populatedOptional)) == "hello";

			const auto nullUniquePtr = std::unique_ptr<int>{};
			expect(CppUtils::String::formatValue(nullUniquePtr)) == "nullptr";

			const auto populatedUniquePtr = std::make_unique<int>(42);
			expect(CppUtils::String::formatValue(populatedUniquePtr)) == "42";

			const auto vectorOfOptionals = std::vector<std::optional<int>>{1, std::nullopt, 3};
			expect(CppUtils::String::formatValue(vectorOfOptionals)) == "[1, nullopt, 3]";
		};
	};
}
