export module CppUtils.UnitTests.Terminal.AutoScroll;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Terminal::AutoScroll
{
	auto _ = TestSuite{"Terminal/AutoScroll", {"Terminal/Canvas", "Terminal/Text"}, [](TestSuite& suite) {
		using namespace std::chrono_literals;

		suite.addTest("Basic AutoScroll", [&] {
			const auto size = CppUtils::Container::Size2{10, 1};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto& autoScroll = canvas.newWidget<CppUtils::Terminal::AutoScroll>(size);
			autoScroll.newWidget<CppUtils::Terminal::Text>(CppUtils::Container::Size2{20, 1}, "Hello World Scrolling");

			canvas.print();
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				suite.expectEqual(accessor->getChar({0, 0}).character, U'H');
			}
			std::this_thread::sleep_for(200ms);

			autoScroll.setScrollOffset(6);
			canvas.print();
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				suite.expectEqual(accessor->getChar({0, 0}).character, U'W');
			}
			std::this_thread::sleep_for(200ms);
		});

		suite.addTest("AutoScroll on Hover", [&] {
			const auto canvasSize = CppUtils::Container::Size2{20, 5};
			auto canvas = CppUtils::Terminal::Canvas{canvasSize};

			auto& autoScroll = canvas.newWidget<CppUtils::Terminal::AutoScroll>(
										 CppUtils::Container::Size2{10, 1},
										 std::make_unique<CppUtils::Terminal::Text>(CppUtils::Container::Size2{20, 1}, "Hello World Scrolling"),
										 CppUtils::Terminal::AutoScroll::Direction::Horizontal,
										 50ms)
								   .setScrollOnHover(true);
			canvas.print();

			suite.expectEqual(autoScroll.isScrollOnHover(), true);
			suite.expectEqual(autoScroll.isAutoScrolling(), false);

			const auto canvasOrigin = canvas.getAbsolutePosition();
			auto hoverEvent = CppUtils::Terminal::Mouse::Event{};
			hoverEvent.absolutePosition = canvasOrigin + CppUtils::Container::Size2{2uz, 0uz};
			canvas.onMouseEvent(hoverEvent);

			suite.expectEqual(autoScroll.isAutoScrolling(), true);
			std::this_thread::sleep_for(150ms);
			suite.expect(autoScroll.getScrollOffset() > 0uz);

			auto leaveEvent = CppUtils::Terminal::Mouse::Event{};
			leaveEvent.absolutePosition = canvasOrigin + CppUtils::Container::Size2{15uz, 0uz};
			canvas.onMouseEvent(leaveEvent);

			suite.expectEqual(autoScroll.isAutoScrolling(), false);
			suite.expectEqual(autoScroll.getScrollOffset(), 0uz);
		});
	}};
}
