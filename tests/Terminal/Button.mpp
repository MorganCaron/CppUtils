export module CppUtils.UnitTests.Terminal.Button;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Terminal::Button
{
	auto _ = testSuite("Terminal/Button").dependsOn("Terminal/Canvas", "Terminal/Text", "Terminal/Element") = [](TestSuite& suite) {
		using namespace std::chrono_literals;

		suite.test("Click") = [&] {
			const auto size = CppUtils::Container::Size2{10, 3};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto clicked = false;
			auto textWidget = std::make_unique<CppUtils::Terminal::Text>(size, "Click me", CppUtils::Terminal::Alignment::Center);
			canvas.newWidget<CppUtils::Terminal::Button>(size, std::move(textWidget), [&clicked] {
				clicked = true;
			});

			canvas.print();
			std::this_thread::sleep_for(200ms);
			not expect(clicked);

			auto hoverEvent = CppUtils::Terminal::Mouse::Event{
				.button = CppUtils::Terminal::Mouse::Button::None,
				.pressed = false,
				.relativePosition = {},
				.absolutePosition = canvas.getAbsolutePosition() + CppUtils::Container::Size2{5uz, 1uz}};
			canvas.onMouseEvent(hoverEvent);
			canvas.print();
			std::this_thread::sleep_for(200ms);

			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({5, 1}).attributes.backgroundColor) == CppUtils::Terminal::BackgroundColor::BackgroundColorEnum::Cyan;
			}

			auto pressEvent = hoverEvent;
			pressEvent.button = CppUtils::Terminal::Mouse::Button::Left;
			pressEvent.pressed = true;
			canvas.onMouseEvent(pressEvent);
			canvas.print();
			std::this_thread::sleep_for(200ms);

			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({5, 1}).attributes.backgroundColor) == CppUtils::Terminal::BackgroundColor::BackgroundColorEnum::Black;
			}
			not expect(clicked);

			auto releaseEvent = pressEvent;
			releaseEvent.pressed = false;
			canvas.onMouseEvent(releaseEvent);
			canvas.print();
			std::this_thread::sleep_for(200ms);

			expect(clicked);
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({5, 1}).attributes.backgroundColor) == CppUtils::Terminal::BackgroundColor::BackgroundColorEnum::Cyan;
			}
		};

		suite.test("CustomStyle") = [&] {
			const auto size = CppUtils::Container::Size2{20, 3};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto textWidget = std::make_unique<CppUtils::Terminal::Text>(size, "Custom Style", CppUtils::Terminal::Alignment::Center);
			auto& button = canvas.newWidget<CppUtils::Terminal::Button>(size, std::move(textWidget));

			auto customStyle = CppUtils::Terminal::ButtonStyle{};
			customStyle.normal.backgroundColor = CppUtils::Terminal::BackgroundColor::BackgroundColorEnum::Red;
			button.setStyle(customStyle);

			canvas.print();

			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({0, 0}).attributes.backgroundColor) == CppUtils::Terminal::BackgroundColor::BackgroundColorEnum::Red;
			}
		};

		suite.test("CustomBorders") = [&] {
			const auto size = CppUtils::Container::Size2{20, 3};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto container = std::make_unique<CppUtils::Terminal::Container>(size);
			container->setBorderStyle({.sides = CppUtils::Terminal::Element::Side::All});
			const auto innerSize = CppUtils::Container::Size2{18, 1};
			container->newWidget<CppUtils::Terminal::Text>(innerSize, "Custom Border", CppUtils::Terminal::Alignment::Center);

			canvas.newWidget<CppUtils::Terminal::Button>(size, std::move(container));

			canvas.print();
			std::this_thread::sleep_for(200ms);

			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({0, 0}).character) == U'┌';
				expect(accessor->getChar({19, 0}).character) == U'┐';
				expect(accessor->getChar({0, 2}).character) == U'└';
				expect(accessor->getChar({19, 2}).character) == U'┘';
				expect(accessor->getChar({1, 0}).character) == U'─';
				expect(accessor->getChar({0, 1}).character) == U'│';
			}
		};

		suite.test("TextAlignment") = [&] {
			const auto size = CppUtils::Container::Size2{20, 1};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto text = std::make_unique<CppUtils::Terminal::Text>(size, "Click");
			auto& textRef = *text;
			canvas.newWidget<CppUtils::Terminal::Button>(size, std::move(text));

			textRef.setHorizontalAlignment(CppUtils::Terminal::Alignment::Begin);
			canvas.print();
			std::this_thread::sleep_for(200ms);
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({0, 0}).character) == U'C';
			}

			textRef.setHorizontalAlignment(CppUtils::Terminal::Alignment::Center);
			canvas.print();
			std::this_thread::sleep_for(200ms);
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({7, 0}).character) == U'C';
			}

			textRef.setHorizontalAlignment(CppUtils::Terminal::Alignment::End);
			canvas.print();
			std::this_thread::sleep_for(200ms);
			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({15, 0}).character) == U'C';
			}
		};

		suite.test("TextOverflow") = [&] {
			const auto size = CppUtils::Container::Size2{20, 1};
			auto canvas = CppUtils::Terminal::Canvas{size};

			auto text = std::make_unique<CppUtils::Terminal::Text>(size, "Lorem ipsum dolor sit amet, consectetur adipiscing elit", CppUtils::Terminal::Alignment::Begin);
			canvas.newWidget<CppUtils::Terminal::Button>(size, std::move(text));

			canvas.print();
			std::this_thread::sleep_for(200ms);

			{
				const auto accessor = canvas.getBuffer().sharedAccess();
				expect(accessor->getChar({17, 0}).character) == U'…';
			}
		};
	};
}
