export module CppUtils.UnitTests.Terminal.RawTerminal;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Terminal::RawTerminal
{
	auto _ = testSuite("Terminal/RawTerminal").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test("Single RawTerminal") = [] {
			const auto initialRawState = CppUtils::Terminal::isRawMode();
			{
				auto raw = CppUtils::Terminal::RawTerminal{};
				skipIf(not raw.isInitialized(), "Terminal environment non-interactive");
				expect(CppUtils::Terminal::isRawMode());
			}
			expect(CppUtils::Terminal::isRawMode()) == initialRawState;
		};

		suite.test("Move construction") = [] {
			const auto initialRawState = CppUtils::Terminal::isRawMode();
			{
				auto raw1 = CppUtils::Terminal::RawTerminal{};
				skipIf(not raw1.isInitialized(), "Terminal environment non-interactive");
				expect(CppUtils::Terminal::isRawMode());
				{
					auto raw2 = std::move(raw1);
					expect(not raw1.isInitialized());
					expect(raw2.isInitialized());
					expect(CppUtils::Terminal::isRawMode());
				}
				expect(CppUtils::Terminal::isRawMode()) == initialRawState;
			}
			expect(CppUtils::Terminal::isRawMode()) == initialRawState;
		};

		suite.test("Move assignment (raw2 = move(raw1))") = [] {
			const auto initialRawState = CppUtils::Terminal::isRawMode();
			{
				auto raw1 = CppUtils::Terminal::RawTerminal{};
				skipIf(not raw1.isInitialized(), "Terminal environment non-interactive");
				expect(CppUtils::Terminal::isRawMode());

				auto raw2 = CppUtils::Terminal::RawTerminal{};
				expect(raw2.isInitialized());
				expect(CppUtils::Terminal::isRawMode());

				raw2 = std::move(raw1);
				expect(not raw1.isInitialized());
				expect(raw2.isInitialized());

				expect(CppUtils::Terminal::isRawMode());
			}
			expect(CppUtils::Terminal::isRawMode()) == initialRawState;
		};

		suite.test("Move assignment (raw1 = move(raw2))") = [] {
			const auto initialRawState = CppUtils::Terminal::isRawMode();
			{
				auto raw1 = CppUtils::Terminal::RawTerminal{};
				skipIf(not raw1.isInitialized(), "Terminal environment non-interactive");
				expect(CppUtils::Terminal::isRawMode());

				auto raw2 = CppUtils::Terminal::RawTerminal{};
				expect(raw2.isInitialized());
				expect(CppUtils::Terminal::isRawMode());

				raw1 = std::move(raw2);
				expect(not raw2.isInitialized());
				expect(raw1.isInitialized());

				expect(CppUtils::Terminal::isRawMode());
			}
			expect(CppUtils::Terminal::isRawMode()) == initialRawState;
		};

		suite.test("Multiple handles") = [] {
			const auto defaultRawState = CppUtils::Terminal::isRawMode();
			{
				auto rawDefault = CppUtils::Terminal::RawTerminal{};
				skipIf(not rawDefault.isInitialized(), "Terminal environment non-interactive");
				expect(CppUtils::Terminal::isRawMode());

#if defined(OS_LINUX) or defined(OS_MACOS)
				auto rawStderr = CppUtils::Terminal::RawTerminal{STDERR_FILENO};
				skipIf(not rawStderr.isInitialized(), "Terminal stderr non-interactive");
				expect(CppUtils::Terminal::isRawMode(STDERR_FILENO));
#endif
			}
			expect(CppUtils::Terminal::isRawMode()) == defaultRawState;
		};
	};
}
