export module CppUtils.UnitTests.FileSystem.File;

import std;
import CppUtils;

namespace CppUtils::UnitTest::FileSystem::File
{
	auto _ = testSuite("FileSystem/File").dependsOn("Logger", "FileSystem/Directory") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("forFiles") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				expect(CppUtils::FileSystem::String::write(directory / "file.txt", "test"));
				expect(CppUtils::FileSystem::String::write(directory / "file.log", "test"));
				auto filesCounter = 0u;
				CppUtils::FileSystem::forFiles(directory, [&filesCounter](const auto& filePath) -> void {
					Logger::print("{}", filePath.string());
					++filesCounter;
				});
				expect(filesCounter) == 2u;
			}};
		};

		suite.test("forFilesWithExtension") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				expect(CppUtils::FileSystem::String::write(directory / "file.txt", "test"));
				expect(CppUtils::FileSystem::String::write(directory / "file.log", "test"));
				auto filesCounter = 0u;
				CppUtils::FileSystem::forFilesWithExtension(directory, ".log", [&filesCounter](const auto& filePath) -> void {
					Logger::print("{}", filePath.string());
					++filesCounter;
				});
				expect(filesCounter) == 1u;
			}};
		};

		suite.test("Binary/readByBlocks") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				const auto filePath = directory / "test.tmp";
				auto originalData = std::vector<std::byte>{std::byte{0xDE}, std::byte{0xAD}, std::byte{0xBE}, std::byte{0xEF}};
				expect(CppUtils::FileSystem::Binary::writeVector(filePath, originalData));

				auto resultData = std::vector<std::byte>{};
				auto nbBlocks = 0u;
				const auto blockSize = 2uz;
				const auto result = CppUtils::FileSystem::Binary::readByBlocks(filePath, [&](auto block) {
					resultData.insert(std::ranges::end(resultData), std::ranges::begin(block), std::ranges::end(block));
					++nbBlocks;
				}, blockSize);

				expect(result);
				expect(resultData == originalData);
				expect(nbBlocks) == (std::ranges::size(originalData) + blockSize - 1) / blockSize;
			}};
		};

		suite.test("String/readByBlocks") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				const auto filePath = directory / "test.tmp";
				constexpr auto originalString = "Hello World!"sv;
				expect(CppUtils::FileSystem::String::write(filePath, originalString));

				auto resultString = ""s;
				auto nbBlocks = 0u;
				const auto blockSize = 5uz;
				const auto result = CppUtils::FileSystem::String::readByBlocks(filePath, [&](std::string_view block) {
					resultString += block;
					++nbBlocks;
				}, blockSize);

				expect(result);
				expect(resultString) == originalString;
				expect(nbBlocks) == (std::ranges::size(originalString) + blockSize - 1) / blockSize;
			}};
		};

		suite.test("readByBlocks (error)") = [&] {
			const auto result = CppUtils::FileSystem::Binary::readByBlocks("non_existent_file.tmp", [](auto) {});
			expect(not result);
			expect(result.error().type) == CppUtils::FileSystem::Error::Type::OpenFailed;
			expect(result.error().message) == "Failed to open file";
		};

		suite.test("readByBlocks (callback error propagation)") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				const auto filePath = directory / "test.tmp";
				expect(CppUtils::FileSystem::String::write(filePath, "Some content"));

				const auto result = CppUtils::FileSystem::Binary::readByBlocks(filePath, [](auto) -> std::expected<void, std::string_view> {
					return std::unexpected{"Error from callback"};
				});

				expect(not result);
				expect(result.error().type) == CppUtils::FileSystem::Error::Type::CallbackError;
				expect(result.error().message) == "Error from callback";
			}};
		};

		suite.test("IncrementalHash") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				const auto filePath = directory / "test.tmp";
				constexpr auto originalString = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."sv;
				expect(CppUtils::FileSystem::String::write(filePath, originalString));

				auto finalHash = CppUtils::Type::HashOffset;
				const auto result = CppUtils::FileSystem::Binary::readByBlocks(filePath, [&finalHash](auto block) {
					finalHash = CppUtils::Type::hash(block, finalHash);
				}, 8uz);

				expect(result);
				auto expectedHash = CppUtils::Type::hash(originalString);

				expect(finalHash) == expectedHash;
			}};
		};
	};

	namespace Binary
	{
		auto _ = testSuite("FileSystem/File/Binary").dependsOn("Logger", "FileSystem/Directory") = [](TestSuite& suite) {
			using Logger = TestSuite::Logger;

			suite.test("WriteRead") = [&] {
				CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
					auto filePath = directory / "test.tmp";
					auto originalValue = 12'345;
					expect(CppUtils::FileSystem::Binary::write(filePath, originalValue));
					auto fileContent = CppUtils::FileSystem::Binary::read<decltype(originalValue)>(filePath);
					expect(fileContent);
					Logger::print("{}", fileContent.value());
					expect(fileContent.value()) == originalValue;
				}};
			};

			suite.test("WriteReadVector") = [&] {
				CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
					auto filePath = directory / "test.tmp";
					auto originalVector = std::vector<int>{};
					originalVector.resize(10);
					std::iota(originalVector.begin(), originalVector.end(), 1);
					expect(CppUtils::FileSystem::Binary::writeVector(filePath, originalVector));
					auto vector = CppUtils::FileSystem::Binary::readVector<int>(filePath);
					expect(vector);
					for (auto nb : vector.value())
						Logger::print("{}", nb);
					expect(vector.value()) == originalVector;
				}};
			};

			suite.test("AppendVector") = [&] {
				CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
					auto filePath = directory / "test.tmp";
					auto initialVector = std::vector<int>{1, 2, 3};
					auto appendedVector = std::vector<int>{4, 5, 6};
					expect(CppUtils::FileSystem::Binary::writeVector(filePath, initialVector));
					expect(CppUtils::FileSystem::Binary::appendVector(filePath, appendedVector));
					auto vector = CppUtils::FileSystem::Binary::readVector<int>(filePath);
					expect(vector);
					auto expectedVector = std::vector<int>{1, 2, 3, 4, 5, 6};
					expect(vector.value()) == expectedVector;
				}};
			};
		};
	}

	namespace String
	{
		auto _ = testSuite("FileSystem/File/String").dependsOn("Logger", "FileSystem/Directory") = [](TestSuite& suite) {
			using Logger = TestSuite::Logger;

			suite.test("WriteRead") = [&] {
				CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
					auto filePath = directory / "test.tmp";
					auto originalString = "Hello World!";
					expect(CppUtils::FileSystem::String::write(filePath, originalString));
					auto fileContent = CppUtils::FileSystem::String::read(filePath);
					expect(fileContent.has_value());
					Logger::print("{}", fileContent.value());
					expect(fileContent.value()) == originalString;
				}};
			};

			suite.test("Append") = [&] {
				CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
					auto filePath = directory / "test.tmp";
					auto firstString = "Hello ";
					auto secondString = "World!";
					expect(CppUtils::FileSystem::String::append(filePath, firstString));
					expect(CppUtils::FileSystem::String::append(filePath, secondString));
					auto fileContent = CppUtils::FileSystem::String::read(filePath);
					expect(fileContent.has_value());
					Logger::print("{}", fileContent.value());
					expect(fileContent.value()) == std::string{firstString} + secondString;
				}};
			};
		};
	}
}
