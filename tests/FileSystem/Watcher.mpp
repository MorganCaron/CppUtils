module;

#include <CppUtils/System/OS.hpp>

export module CppUtils.UnitTests.FileSystem.Watcher;

import std;
import CppUtils;

namespace CppUtils::UnitTest::FileSystem::Watcher
{
	auto _ = testSuite("FileSystem/Watcher").dependsOn("Logger", "FileSystem/Directory", "FileSystem/File") = [](TestSuite& suite) {
		using namespace std::chrono_literals;
		using Logger = TestSuite::Logger;

		suite.test("No file") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(directory / "test.tmp");
				watcher.onEvent(
					[](
						[[maybe_unused]] CppUtils::FileSystem::Event event,
						[[maybe_unused]] const std::filesystem::path& filePath) -> void {
					expect(false);
				});
				std::this_thread::sleep_for(10ms);
			}};
		};

		suite.test("No event") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto filePath = directory / "test.tmp";
				CppUtils::FileSystem::String::write(filePath, "Hello World!");
				std::this_thread::sleep_for(100ms);

				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(filePath);
				watcher.onEvent(
					[](
						[[maybe_unused]] CppUtils::FileSystem::Event event,
						[[maybe_unused]] const std::filesystem::path& filePath) -> void {
					expect(false);
				});
				std::this_thread::sleep_for(100ms);
			}};
		};

		suite.test("Unwatch") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(directory);
				watcher.unwatch(directory);
			}};
		};

		suite.test("Watch file creation") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto expectCreateFile = std::atomic_bool{false};
				auto expectCloseFile = std::atomic_bool{false};
				auto filePath = directory / "test.tmp";

				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(directory);
				watcher.onEvent(
					[](CppUtils::FileSystem::Event event,
						const std::filesystem::path& filePath) -> void {
					Logger::print("{}: {}", event, filePath.string());
				});
				watcher.onEvent(CppUtils::FileSystem::Event::Created,
					[&expectCreateFile, &filePath](
						CppUtils::FileSystem::Event event,
						const std::filesystem::path& eventFilePath) -> void {
					expect(event) == CppUtils::FileSystem::Event::Created;
					expect(eventFilePath) == filePath;
					expectCreateFile = true;
				});
				watcher.onEvent(CppUtils::FileSystem::Event::CloseWrite,
					[&expectCloseFile, &filePath](
						CppUtils::FileSystem::Event event,
						const std::filesystem::path& eventFilePath) -> void {
					expect(event) == CppUtils::FileSystem::Event::CloseWrite;
					expect(eventFilePath) == filePath;
					expectCloseFile = true;
				});

				CppUtils::FileSystem::String::write(directory / "test.tmp", "Hello World!");
				expect([&] { return expectCreateFile and expectCloseFile; }) == eventually;
			}};
		};

		suite.test("Watch file modification") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto expectModifyFile = std::atomic_bool{false};
				auto filePath = directory / "test.tmp";
				CppUtils::FileSystem::String::write(filePath, "Foo");
				std::this_thread::sleep_for(100ms);

				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(filePath);
				watcher.onEvent(
					[](CppUtils::FileSystem::Event event,
						const std::filesystem::path& filePath) -> void {
					Logger::print("{}: {}", event, filePath.string());
				});
				watcher.onEvent(CppUtils::FileSystem::Event::CloseWrite,
					[&expectModifyFile, &filePath](
						CppUtils::FileSystem::Event event,
						const std::filesystem::path& eventFilePath) -> void {
					expect(event) == CppUtils::FileSystem::Event::CloseWrite;
					expect(eventFilePath) == filePath;
					expectModifyFile = true;
				});

				CppUtils::FileSystem::String::write(filePath, "Bar");
				expect([&] { return expectModifyFile.load(); }) == eventually;
			}};
		};

		suite.test("Watch file modification in a directory") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto expectModifyFile = std::atomic_bool{false};
				auto filePath = directory / "test.tmp";
				CppUtils::FileSystem::String::write(filePath, "Foo");
				std::this_thread::sleep_for(100ms);

				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(directory);
				watcher.onEvent(
					[](CppUtils::FileSystem::Event event,
						const std::filesystem::path& filePath) -> void {
					Logger::print("{}: {}", event, filePath.string());
				});
				watcher.onEvent(CppUtils::FileSystem::Event::CloseWrite,
					[&expectModifyFile, &filePath](
						CppUtils::FileSystem::Event event,
						const std::filesystem::path& eventFilePath) -> void {
					expect(event) == CppUtils::FileSystem::Event::CloseWrite;
					expect(eventFilePath) == filePath;
					expectModifyFile = true;
				});

				CppUtils::FileSystem::String::write(filePath, "Bar");
				expect([&] { return expectModifyFile.load(); }) == eventually;
			}};
		};

		suite.test("Watch file deletion") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto expectDeleteFile = std::atomic_bool{false};
				auto filePath = directory / "test.tmp";
				CppUtils::FileSystem::String::write(filePath, "Hello World!");
				std::this_thread::sleep_for(100ms);

				auto watcher = CppUtils::FileSystem::Watcher{};
				watcher.watch(directory);
				watcher.onEvent(
					[](CppUtils::FileSystem::Event event,
						const std::filesystem::path& filePath) -> void {
					Logger::print("{}: {}", event, filePath.string());
				});
				watcher.onEvent(CppUtils::FileSystem::Event::Deleted,
					[&expectDeleteFile, &filePath](
						CppUtils::FileSystem::Event event,
						const std::filesystem::path& eventFilePath) -> void {
					expect(event) == CppUtils::FileSystem::Event::Deleted;
					expect(eventFilePath) == filePath;
					expectDeleteFile = true;
				});

				std::filesystem::remove(filePath);
				expect([&] { return expectDeleteFile.load(); }) == eventually;
			}};
		};

		suite.test("Passive start and stop") = [&] {
			auto watcher = CppUtils::FileSystem::Watcher{};
			expect(not watcher.isRunning());

			watcher.start();
			expect(watcher.isRunning());

			watcher.stop();
			expect(not watcher.isRunning());

			watcher.start();
			expect(watcher.isRunning());

			watcher.stop();
			expect(not watcher.isRunning());
		};

		suite.test("Reset watcher") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto watcher = CppUtils::FileSystem::Watcher{};
				expect(not watcher.isRunning());

				watcher.watch(directory);
				expect(watcher.isRunning());

				watcher.reset();
				expect(not watcher.isRunning());
			}};
		};

		suite.test("Move watcher") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				auto watcher1 = CppUtils::FileSystem::Watcher{};
				expect(not watcher1.isRunning());

				watcher1.watch(directory);
				expect(watcher1.isRunning());

				auto watcher2 = std::move(watcher1);
				expect(watcher2.isRunning());
				expect(not watcher1.isRunning());

				watcher2.stop();
				expect(not watcher2.isRunning());
			}};
		};
	};
}
