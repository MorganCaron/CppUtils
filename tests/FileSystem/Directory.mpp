export module CppUtils.UnitTests.FileSystem.Directory;

import std;
import CppUtils;

namespace CppUtils::UnitTest::FileSystem::Directory
{
	auto _ = testSuite("FileSystem/Directory").dependsOn("UnitTest", "Logger") = [](TestSuite& suite) {
		using Logger = TestSuite::Logger;

		suite.test("TemporaryDirectory") = [&] {
			auto functionCalled = false;
			CppUtils::FileSystem::TemporaryDirectory{[&functionCalled](const auto& directory) -> void {
				functionCalled = true;
				expect(std::filesystem::exists(directory));
				Logger::print("{}", directory.string());
			}};
			expect(functionCalled);
		};
	};
}
