export module CppUtils.UnitTests.FileSystem.FileStaging;

import std;
import CppUtils;

namespace CppUtils::UnitTest::FileSystem::FileStaging
{
	auto _ = testSuite("FileSystem/FileStaging").dependsOn("FileSystem/Directory") = [](TestSuite& suite) {
		suite.test("FileStaging stage and complete with archive") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputDirectory = sandbox / "input";
				const auto stagingDirectory = sandbox / "staging";
				const auto archiveDirectory = sandbox / "archive";
				const auto quarantineDirectory = sandbox / "quarantine";

				std::filesystem::create_directories(inputDirectory);
				const auto inputFilePath = inputDirectory / "orders.csv";
				CppUtils::FileSystem::String::write(inputFilePath, "id;amount\n1;100\n2;200\n");

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(
					inputFilePath,
					stagingDirectory,
					quarantineDirectory,
					archiveDirectory);

				expect(stageResult.has_value());
				const auto& staging = stageResult.value();

				expect(staging.inputPath()) == inputFilePath;
				expect(not std::filesystem::exists(inputFilePath));
				expect(std::filesystem::exists(staging.stagedPath()));

				auto completeResult = staging.complete();
				expect(completeResult.has_value());
				const auto& archivedPath = completeResult.value();

				expect(not std::filesystem::exists(staging.stagedPath()));
				expect(std::filesystem::exists(archivedPath));
				expect(archivedPath.parent_path()) == archiveDirectory;
			}};
		};

		suite.test("FileStaging stage and complete with deletion") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputDirectory = sandbox / "input";
				const auto stagingDirectory = sandbox / "staging";

				std::filesystem::create_directories(inputDirectory);
				const auto inputFilePath = inputDirectory / "temp_data.csv";
				CppUtils::FileSystem::String::write(inputFilePath, "temporary content\n");

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(
					inputFilePath,
					stagingDirectory);

				expect(stageResult.has_value());
				const auto& staging = stageResult.value();

				expect(std::filesystem::exists(staging.stagedPath()));

				auto completeResult = staging.complete();
				expect(completeResult.has_value());
				expect(completeResult.value().string()) == "";
				expect(not std::filesystem::exists(staging.stagedPath()));
			}};
		};

		suite.test("FileStaging stage and abort with quarantine") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputDirectory = sandbox / "input";
				const auto stagingDirectory = sandbox / "staging";
				const auto archiveDirectory = sandbox / "archive";
				const auto quarantineDirectory = sandbox / "quarantine";

				std::filesystem::create_directories(inputDirectory);
				const auto inputFilePath = inputDirectory / "corrupted.csv";
				CppUtils::FileSystem::String::write(inputFilePath, "corrupted content\n");

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(
					inputFilePath,
					stagingDirectory,
					quarantineDirectory,
					archiveDirectory);

				expect(stageResult.has_value());
				const auto& staging = stageResult.value();

				auto abortResult = staging.abort();
				expect(abortResult.has_value());
				const auto& quarantinedPath = abortResult.value();

				expect(not std::filesystem::exists(staging.stagedPath()));
				expect(std::filesystem::exists(quarantinedPath));
				expect(quarantinedPath.parent_path()) == quarantineDirectory;
			}};
		};

		suite.test("FileStaging stage and abort with deletion") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputDirectory = sandbox / "input";
				const auto stagingDirectory = sandbox / "staging";

				std::filesystem::create_directories(inputDirectory);
				const auto inputFilePath = inputDirectory / "corrupted.csv";
				CppUtils::FileSystem::String::write(inputFilePath, "corrupted content\n");

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(
					inputFilePath,
					stagingDirectory);

				expect(stageResult.has_value());
				const auto& staging = stageResult.value();

				auto abortResult = staging.abort();
				expect(abortResult.has_value());
				expect(abortResult.value().string()) == "";

				expect(not std::filesystem::exists(staging.stagedPath()));
				expect(not std::filesystem::exists(inputFilePath));
			}};
		};

		suite.test("FileStaging stage and retry") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputDirectory = sandbox / "input";
				const auto stagingDirectory = sandbox / "staging";

				std::filesystem::create_directories(inputDirectory);
				const auto inputFilePath = inputDirectory / "retry_me.csv";
				CppUtils::FileSystem::String::write(inputFilePath, "retry content\n");

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(
					inputFilePath,
					stagingDirectory);

				expect(stageResult.has_value());
				const auto& staging = stageResult.value();

				auto retryResult = staging.retry();
				expect(retryResult.has_value());
				expect(retryResult.value()) == inputFilePath;

				expect(not std::filesystem::exists(staging.stagedPath()));
				expect(std::filesystem::exists(inputFilePath));
			}};
		};

		suite.test("FileStaging non-existent file error") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& sandbox) -> void {
				const auto inputFilePath = sandbox / "does_not_exist.csv";

				auto stageResult = CppUtils::FileSystem::FileStaging::stage(inputFilePath);
				expect(not stageResult.has_value());
			}};
		};
	};
}
