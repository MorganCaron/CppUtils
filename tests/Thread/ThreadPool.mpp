export module CppUtils.UnitTests.Thread.ThreadPool;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::ThreadPool
{
	auto _ = testSuite("Thread/ThreadPool").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace std::chrono_literals;
		using Logger = TestSuite::Logger;

		suite.test("0 task / 1 thread") = [&] {
			auto _ = CppUtils::Thread::ThreadPool{1};
		};

		suite.test("0 task / 2 threads") = [&] {
			auto _ = CppUtils::Thread::ThreadPool{2};
		};

		suite.test("0 task / N threads") = [&] {
			auto _ = CppUtils::Thread::ThreadPool{};
		};

		suite.test("1 task with future.wait()") = [&] {
			auto called = std::atomic_bool{false};
			{
				auto threadPool = CppUtils::Thread::ThreadPool{};
				auto future = threadPool.call([&called] {
					called = true;
				});
				future.wait();
			}
			expect(called);
		};

		suite.test("waitUntilFinished") = [&] {
			auto called = std::atomic_bool{false};
			{
				auto threadPool = CppUtils::Thread::ThreadPool{};
				threadPool.call([&called] {
					called = true;
				});
				threadPool.waitUntilFinished();
			}
			expect(called);
		};

		suite.test("Canary: LLVM #221609 std::runtime_error double-free") = [] {
#if defined(_WIN32)
			skip("Waiting for LLVM issue #221609 fix: https://github.com/llvm/llvm-project/issues/221609");
#else
			auto exceptionPointer = std::exception_ptr{};
			try
			{
				throw std::runtime_error{"Canary"};
			}
			catch (...)
			{
				exceptionPointer = std::current_exception();
			}
			try
			{
				if (exceptionPointer)
					std::rethrow_exception(exceptionPointer);
			}
			catch (const std::exception& exception)
			{
				expect(exception.what()) == "Canary";
			}
#endif
		};

		// Workaround on Windows (MSVC ABI)
		// https://github.com/llvm/llvm-project/issues/221609
#if defined(_WIN32)
		struct WorkaroundException final: std::exception
		{
			explicit WorkaroundException(const char* message) noexcept: m_message{message} {}
			[[nodiscard]] auto what() const noexcept -> const char* override
			{
				return m_message;
			}

		private:
			const char* m_message;
		};
		using TestException = WorkaroundException;
#else
		using TestException = std::runtime_error;
#endif

		suite.test("Error handling with future") = [&] {
			auto threadPool = CppUtils::Thread::ThreadPool{};
			auto future = threadPool.call([] {
				throw TestException{"Test error"}; // throw std::runtime_error{"Test error"};
			});

			auto called = std::atomic_bool{false};
			try
			{
				future.get();
			}
			catch (const std::exception& exception)
			{
				called = true;
				Logger::print<"error">("ThreadPool: Unhandled exception: {}", exception.what());
				expect(exception.what()) == "Test error";
			}
			expect(called);
		};

		suite.test("Error handling without future") = [&] {
			auto threadPool = CppUtils::Thread::ThreadPool{};
			auto called = std::atomic_bool{false};
			threadPool.setOnError([&called](std::exception_ptr exceptionPointer) {
				called = true;
				try
				{
					std::rethrow_exception(exceptionPointer);
				}
				catch (const std::exception& exception)
				{
					Logger::print<"error">("ThreadPool: Unhandled exception: {}", exception.what());
					expect(exception.what()) == "Test error";
				}
				catch (...)
				{
					Logger::print<"error">("ThreadPool: Unhandled non-std exception");
				}
			});
			threadPool.call([] {
				throw TestException{"Test error"};
			});
			threadPool.waitUntilFinished();
			expect(called);
		};

		suite.test("Task with return value") = [&] {
			auto threadPool = CppUtils::Thread::ThreadPool{};
			auto future = threadPool.call([] {
				return 42;
			});
			expect(future.get()) == 42;
		};

		suite.test("Stress test") = [&] {
			auto threadPool = CppUtils::Thread::ThreadPool{};
			auto counter = std::atomic_size_t{0};
			const auto numTasks = 10'000uz;

#if defined(__cpp_lib_ranges_indices)
			for (auto _ : std::views::indices(numTasks))
#else
			for (auto _ : std::views::iota(0uz, numTasks))
#endif
				threadPool.call([&counter] {
					++counter;
				});

			threadPool.waitUntilFinished();
			expect(counter.load()) == numTasks;
		};
	};
}
