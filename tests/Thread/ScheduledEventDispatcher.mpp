export module CppUtils.UnitTests.Thread.ScheduledEventDispatcher;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::ScheduledEventDispatcher
{
	auto _ = TestSuite{"Thread/ScheduledEventDispatcher", {"Execution/EventDispatcher", "Thread/Scheduler"}, [](TestSuite& suite) {
		using namespace std::chrono_literals;

		suite.addTest("Immediate Emit", [&] {
			auto dispatcher = CppUtils::Thread::ScheduledEventDispatcher{};
			auto receivedValue = std::atomic_bool{};

			dispatcher.subscribe<"Event">([&](bool value) {
				receivedValue = value;
			});
			dispatcher.emit<"Event">(true);

			dispatcher.waitUntilFinished();
			suite.expectEqual(receivedValue.load(), true);
		});

		suite.addTest("Delayed Emit", [&] {
			auto dispatcher = CppUtils::Thread::ScheduledEventDispatcher{};
			auto receivedValue = std::atomic_bool{};
			auto executionTime = std::atomic<CppUtils::Thread::ScheduledEventDispatcher::TimePoint>{};

			dispatcher.subscribe<"Event">([&](bool value) {
				executionTime = CppUtils::Thread::ScheduledEventDispatcher::Clock::now();
				receivedValue = value;
			});

			constexpr auto delay = 100ms;
			const auto startTime = CppUtils::Thread::ScheduledEventDispatcher::Clock::now();
			dispatcher.emit<"Event">(delay, true);

			if (CppUtils::Thread::ScheduledEventDispatcher::Clock::now() < startTime + delay)
				suite.expectEqual(receivedValue.load(), false);

			dispatcher.waitUntilFinished();

			suite.expectEqual(receivedValue.load(), true);
			suite.expect(executionTime.load() >= startTime + delay);
		});

		suite.addTest("Delayed Emit with Flush", [&] {
			auto dispatcher = CppUtils::Thread::ScheduledEventDispatcher{};
			auto receivedValue = std::atomic_bool{};

			dispatcher.subscribe<"Event">([&](bool value) {
				receivedValue = value;
			});
			dispatcher.emit<"Event">(30s, true);

			suite.expect(not receivedValue.load());
			dispatcher.flush();
			suite.expect(receivedValue.load());
		});
	}};
}
