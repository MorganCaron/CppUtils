export module CppUtils.UnitTests.Thread.TryAsync;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::TryAsync
{
	auto _ = testSuite("Thread/TryAsync").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("Successful async call") = [&] {
			auto future = CppUtils::Thread::tryAsync([] {
				return 42;
			});
			auto result = future.get();
			expect(result);
			expect(result.value()) == 42;
		};

		suite.test("Async call with exception") = [&] {
			auto future = CppUtils::Thread::tryAsync([] {
				throw std::runtime_error{"Test exception"};
				return 0;
			});
			auto result = future.get();
			expect(not result);
			expect(result.error().what()) == "Test exception";
		};

		suite.test("Void async call") = [&] {
			auto future = CppUtils::Thread::tryAsync([] {
				Logger::print("Void async call executed");
			});
			auto result = future.get();
			expect(result);
		};

		suite.test("Void async call with exception") = [&] {
			auto future = CppUtils::Thread::tryAsync([] {
				throw std::runtime_error{"Void test exception"};
			});
			auto result = future.get();
			expect(not result);
			expect(result.error().what()) == "Void test exception";
		};
	};
}
