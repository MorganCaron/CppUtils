export module CppUtils.UnitTests.Thread.AsyncEventDispatcher;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::AsyncEventDispatcher
{
	auto _ = testSuite("Thread/AsyncEventDispatcher").dependsOn("Thread/ThreadPool", "Execution/EventDispatcher") = [](TestSuite& suite) {
		suite.test("Emit and Wait") = [&] {
			auto dispatcher = CppUtils::Thread::AsyncEventDispatcher{};
			auto received = std::atomic_bool{false};

			dispatcher.subscribe<"Event">([&](bool receivedValue) {
				expect(receivedValue);
				received = true;
			});
			dispatcher.emit<"Event">(true);

			dispatcher.waitUntilFinished();
			expect(received);
		};

		// Workaround on Windows (MSVC ABI)
		// https://github.com/llvm/llvm-project/issues/221609
#if defined(_WIN32)
		struct WorkaroundException final: std::exception
		{
			explicit WorkaroundException(const char* message) noexcept: m_message{message} {}
			[[nodiscard]] auto what() const noexcept -> const char* override
			{
				return m_message;
			}

		private:
			const char* m_message;
		};
		using TestException = WorkaroundException;
#else
		using TestException = std::runtime_error;
#endif

		suite.test("Error Handling") = [&] {
			auto errorCaught = std::atomic_bool{false};
			auto onError = [&](std::exception_ptr) {
				errorCaught = true;
			};
			auto dispatcher = CppUtils::Thread::AsyncEventDispatcher{1, onError};

			dispatcher.subscribe<"Event">([&](std::nullptr_t) {
				throw TestException{"Test Error"}; // throw std::runtime_error{"Test Error"};
			});
			dispatcher.emit<"Event">(nullptr);

			dispatcher.waitUntilFinished();
			expect(errorCaught);
		};

		suite.test("Stateful lambda") = [&] {
			auto dispatcher = CppUtils::Thread::AsyncEventDispatcher{};
			auto counter = std::make_shared<int>(0);
			auto mutex = std::make_shared<std::mutex>();

			dispatcher.subscribe<"Event">([counter, mutex, internalCount = 0](int value) mutable {
				auto lockGuard = std::lock_guard{*mutex};
				internalCount += value;
				*counter = internalCount;
			});
			dispatcher.emit<"Event">(10);
			dispatcher.emit<"Event">(20);

			dispatcher.waitUntilFinished();
			expect(*counter) == 30;
		};

		suite.test("Passing stateful lambda as argument") = [&] {
			auto dispatcher = CppUtils::Thread::AsyncEventDispatcher{};
			auto result = std::atomic_int{0};

			using Function = std::function<void()>;
			dispatcher.subscribe<"Execute">([&](Function function) {
				function();
			});

			dispatcher.emit<"Execute">(Function{[state = 42, &result]() {
				result = state;
			}});

			dispatcher.waitUntilFinished();
			expect(result.load()) == 42;
		};

		suite.test("Multiple subscribe") = [&] {
			auto dispatcher = CppUtils::Thread::AsyncEventDispatcher{};
			auto count = std::atomic_size_t{0};

			dispatcher.subscribe<"A", "B">([&count] {
				++count;
			});

			dispatcher.emit<"A">();
			dispatcher.emit<"B">();
			dispatcher.emit<"C">();

			dispatcher.waitUntilFinished();
			expect(count) == 2uz;
		};
	};
}
