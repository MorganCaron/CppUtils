export module CppUtils.UnitTests.Thread.UniqueLocker;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::UniqueLocker
{
	auto _ = testSuite("Thread/UniqueLocker").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test("Access") = [&] {
			auto lockedString = CppUtils::Thread::UniqueLocker<std::string>{"Test"};
			{
				auto accessor = lockedString.access();
				expect(accessor.value()) == "Test";
			}
		};

		suite.test("Test mutex") = [&] {
			auto lockedNumber = CppUtils::Thread::UniqueLocker{0uz};

			auto incrementFunction = [&lockedNumber](std::size_t iterations) noexcept -> void {
				while (iterations--)
				{
					auto accessor = lockedNumber.access();
					auto& nb = accessor.value();
					++nb;
				}
			};

			auto iterations = 1'000'000uz;
			{
				auto thread0 = std::jthread{incrementFunction, iterations};
				auto thread1 = std::jthread{incrementFunction, iterations};
			}
			auto accessor = lockedNumber.access();
			expect(accessor.value()) == iterations * 2;
		};

		suite.test("Const access") = [&] {
			const auto constLockedString = CppUtils::Thread::UniqueLocker<std::string>{"Test"};
			auto accessor = constLockedString.access();
			expect(accessor.value()) == "Test";
		};

		suite.test("Const& access") = [&] {
			const auto& constLockedString = CppUtils::Thread::UniqueLocker<std::string>{"Test"};
			auto accessor = constLockedString.access();
			expect(accessor.value()) == "Test";
		};

		suite.test("Const&& access") = [&] {
			const auto&& constLockedString = CppUtils::Thread::UniqueLocker<std::string>{"Test"};
			auto accessor = constLockedString.access();
			expect(accessor.value()) == "Test";
		};

		suite.test("MultipleAccessor") = [&] {
			auto lockedString1 = CppUtils::Thread::UniqueLocker<std::string>{"Foo"};
			auto lockedString2 = CppUtils::Thread::UniqueLocker<std::string>{"Bar"};
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{lockedString1, lockedString2};
				expect(std::get<0>(accessor.values)) == "Foo";
				expect(std::get<1>(accessor.values)) == "Bar";
			}
		};

		suite.test("Move constructor") = [&] {
			auto source = CppUtils::Thread::UniqueLocker<std::unique_ptr<int>>{std::make_unique<int>(42)};
			auto destination = CppUtils::Thread::UniqueLocker<std::unique_ptr<int>>{std::move(source)};

			expect(source.access().value()) == nullptr;
			expect(destination.access().value()) != nullptr;
			expect(*destination.access().value()) == 42;
		};

		suite.test("Move assignment") = [&] {
			auto source = CppUtils::Thread::UniqueLocker<std::unique_ptr<int>>{std::make_unique<int>(100)};
			auto destination = CppUtils::Thread::UniqueLocker<std::unique_ptr<int>>{std::make_unique<int>(200)};

			destination = std::move(source);

			expect(source.access().value()) == nullptr;
			expect(destination.access().value()) != nullptr;
			expect(*destination.access().value()) == 100;
		};
	};
}
