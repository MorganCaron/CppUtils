export module CppUtils.UnitTests.Thread.Scheduler;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::Scheduler
{
	auto _ = testSuite("Thread/Scheduler").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::chrono_literals;

		suite.test("Initialize Scheduler") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};

			scheduler.waitUntilFinished();
		};

		suite.test("Schedule and execute") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto executed = std::atomic_bool{false};

			scheduler.schedule([&executed] {
				executed = true;
			}, 100ms);

			scheduler.waitUntilFinished();

			expect(executed.load());
		};

		suite.test("Recursive scheduling") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto counter = std::atomic_size_t{0};

			scheduler.schedule([&scheduler, &counter] {
				++counter;
				scheduler.schedule([&counter] {
					++counter;
				}, 100ms);
			}, 100ms);

			scheduler.waitUntilFinished();

			expect(counter.load()) == 2uz;
		};

		suite.test("Cancel tasks on destruction") = [&] {
			auto executed = std::atomic_bool{false};

			{
				auto scheduler = CppUtils::Thread::Scheduler{};

				scheduler.schedule([&executed] {
					executed = true;
				}, 100ms);
			}

			expect(not executed.load());
		};

		suite.test("Multiple tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto counter = std::atomic_size_t{0};

			scheduler.schedule([&counter] { ++counter; }, 100ms);
			scheduler.schedule([&counter] { ++counter; }, 200ms);
			scheduler.schedule([&counter] { ++counter; }, 300ms);

			scheduler.waitUntilFinished();

			expect(counter.load()) == 3uz;
		};

		suite.test("Cancel specific task") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto number = std::atomic_size_t{0};

			scheduler.schedule([&number] { ++number; }, 0ms);
			const auto id = scheduler.schedule([&number] { number += 0b10; }, 250ms);
			scheduler.schedule([&number] { number += 0b100; }, 500ms);

			scheduler.cancel(id);

			scheduler.waitUntilFinished();

			expect(number.load()) == 5uz;
		};

		suite.test("Cancel all tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto number = std::atomic_size_t{0};

			scheduler.schedule([&number] { ++number; }, 200ms);
			scheduler.schedule([&number] { number += 0b10; }, 350ms);
			scheduler.schedule([&number] { number += 0b100; }, 500ms);

			scheduler.cancelAll();

			scheduler.waitUntilFinished();

			expect(number.load()) == 0uz;
		};

		suite.test("Cancel tasks by owner") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto number1 = std::atomic_size_t{0};
			auto number2 = std::atomic_size_t{0};

			auto dummyOwner1 = 1;
			auto dummyOwner2 = 2;

			scheduler.schedule([&number1] { ++number1; }, 200ms, &dummyOwner1);
			scheduler.schedule([&number2] { ++number2; }, 200ms, &dummyOwner2);

			scheduler.cancelOwner(&dummyOwner1);

			scheduler.waitUntilFinished();

			expect(number1.load()) == 0uz;
			expect(number2.load()) == 1uz;
		};

		suite.test("Order of execution") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{0s, 1uz};
			auto executionOrder = std::vector<std::size_t>{};
			auto mutex = std::mutex{};
			auto record = [&](std::size_t value) {
				auto lock = std::unique_lock{mutex};
				executionOrder.push_back(value);
			};

			const auto now = CppUtils::Thread::Scheduler::Clock::now();
			scheduler.schedule([&] { record(1); }, now + 100ms);
			scheduler.schedule([&] { record(2); }, now + 50ms);
			scheduler.schedule([&] { record(3); }, now + 200ms);

			scheduler.waitUntilFinished();

			expect(std::ranges::size(executionOrder)) == 3uz;
			expect(executionOrder[0]) == 2uz;
			expect(executionOrder[1]) == 1uz;
			expect(executionOrder[2]) == 3uz;
		};

		suite.test("Without bucketing") = [&] {
			using Clock = CppUtils::Thread::Scheduler::Clock;
			using TimePoint = CppUtils::Thread::Scheduler::TimePoint;
			auto scheduler = CppUtils::Thread::Scheduler{0s, 1uz};
			auto times = std::vector<TimePoint>{};
			auto mutex = std::mutex{};

			auto record = [&](TimePoint timePoint) {
				auto lock = std::unique_lock{mutex};
				times.push_back(timePoint);
			};

			const auto now = Clock::now();
			scheduler.schedule([&] { record(Clock::now()); }, now + 100ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 350ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 700ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 1200ms);

			scheduler.waitUntilFinished();

			expect(std::ranges::size(times)) == 4uz;
			// Chaque tache respecte sa date
			expect(times[0]) >= now + 80ms;
			expect(times[1]) >= now + 300ms;
			expect(times[2]) >= now + 650ms;
			expect(times[3]) >= now + 1100ms;
		};

		suite.test("With bucketing") = [&] {
			using Clock = CppUtils::Thread::Scheduler::Clock;
			using TimePoint = CppUtils::Thread::Scheduler::TimePoint;
			auto scheduler = CppUtils::Thread::Scheduler{300ms, 1uz};
			auto times = std::vector<TimePoint>{};
			auto mutex = std::mutex{};

			auto record = [&](TimePoint timePoint) {
				auto lock = std::unique_lock{mutex};
				times.push_back(timePoint);
			};

			const auto now = Clock::now();
			scheduler.schedule([&] { record(Clock::now()); }, now + 100ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 350ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 700ms);
			scheduler.schedule([&] { record(Clock::now()); }, now + 1200ms);

			scheduler.waitUntilFinished();

			expect(std::ranges::size(times)) == 4uz;
			// Avec bucketing (300ms): les taches 0 (100ms) et 1 (350ms) sont groupées dans le 1er bucket (< 80ms)
			expect(times[1] - times[0]) < 80ms;
			// La tache 2 (700ms) est dans le 2ème bucket
			expect(times[2] - times[1]) >= 150ms;
			// La tache 3 (1200ms) est dans le 3ème bucket
			expect(times[3] - times[2]) >= 150ms;
		};

		suite.test("Schedule events in reverse order") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{0s, 1uz};
			auto executionOrder = std::vector<std::size_t>{};
			auto mutex = std::mutex{};
			auto record = [&](std::size_t value) {
				auto lock = std::unique_lock{mutex};
				executionOrder.push_back(value);
			};

			const auto now = CppUtils::Thread::Scheduler::Clock::now();
			scheduler.schedule([&] { record(2); }, now + 200ms);
			scheduler.schedule([&] { record(1); }, now + 100ms);

			scheduler.waitUntilFinished();

			expect(std::ranges::size(executionOrder)) == 2uz;
			expect(executionOrder[0]) == 1uz;
			expect(executionOrder[1]) == 2uz;
		};

		suite.test("Schedule earlier task after later task") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto taskExecutionSignal = std::binary_semaphore{0};
			auto bExecuted = std::atomic_bool{false};

			scheduler.schedule([&] { bExecuted = true; }, 500ms);
			scheduler.schedule([&] { taskExecutionSignal.release(); }, 100ms);

			expect(taskExecutionSignal) == completes;
			scheduler.cancelAll();

			expect(not bExecuted.load());
		};

		suite.test("Stress test with many tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			const auto numTasks = 10'000uz;
			auto executedCount = std::atomic_size_t{0};

#if defined(__cpp_lib_ranges_indices)
			for (auto _ : std::views::indices(numTasks))
#else
			for (auto _ : std::views::iota(0uz, numTasks))
#endif
				scheduler.schedule([&] {
					executedCount++;
				}, std::chrono::milliseconds{CppUtils::Math::getRandomNumberInInterval(0, 9)});

			scheduler.waitUntilFinished();

			expect(executedCount.load()) == numTasks;
		};

		// Workaround on Windows (MSVC ABI)
		// https://github.com/llvm/llvm-project/issues/221609
#if defined(_WIN32)
		struct WorkaroundException final: std::exception
		{
			explicit WorkaroundException(const char* message) noexcept: m_message{message} {}
			[[nodiscard]] auto what() const noexcept -> const char* override
			{
				return m_message;
			}

		private:
			const char* m_message;
		};
		using TestException = WorkaroundException;
#else
		using TestException = std::runtime_error;
#endif

		suite.test("onError callback is invoked on exception") = [&] {
			auto onErrorInvoked = std::atomic_bool{false};
			auto scheduler = CppUtils::Thread::Scheduler{
				0ms,
				std::thread::hardware_concurrency(),
				[&](std::exception_ptr) {
				onErrorInvoked = true;
			}};

			scheduler.schedule([] {
				throw TestException{"Test exception"}; // throw std::runtime_error{"Test exception"};
			}, 10ms);

			scheduler.waitUntilFinished();

			expect(onErrorInvoked.load());
		};

		suite.test("getScheduledTasksCount(): Waiting tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};

			expect(scheduler.getScheduledTasksCount()) == 0uz;

			scheduler.schedule([] {}, 10s);
			expect(scheduler.getScheduledTasksCount()) == 1uz;

			scheduler.schedule([] {}, 20s);
			expect(scheduler.getScheduledTasksCount()) == 2uz;

			scheduler.cancelAll();
			expect(scheduler.getScheduledTasksCount()) == 0uz;
		};

		suite.test("getScheduledTasksCount(): Processing tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};

			auto promise = std::promise<void>{};
			auto future = promise.get_future();
			auto started = std::promise<void>{};
			auto startedFuture = started.get_future();

			scheduler.schedule([&] {
				started.set_value();
				future.wait();
			}, 0s);

			startedFuture.wait();
			expect(scheduler.getScheduledTasksCount()) == 1uz;

			promise.set_value();
			scheduler.flush();
			expect(scheduler.getScheduledTasksCount()) == 0uz;
		};

		suite.test("Flush tasks") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto executed = std::atomic_bool{false};

			scheduler.schedule([&executed] {
				executed = true;
			}, 30s);

			expect(not executed.load());
			scheduler.flush();
			expect(executed.load());
		};

		suite.test("Flush tasks with chaining") = [&] {
			auto scheduler = CppUtils::Thread::Scheduler{};
			auto counter = std::atomic_size_t{0};

			scheduler.schedule([&] {
				++counter;
				scheduler.schedule([&] {
					++counter;
				}, 30s);
			}, 30s);

			expect(counter.load()) == 0uz;
			scheduler.flush();
			expect(counter.load()) == 2uz;
		};
	};
}
