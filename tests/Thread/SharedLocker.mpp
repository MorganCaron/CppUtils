export module CppUtils.UnitTests.Thread.SharedLocker;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::SharedLocker
{
	auto _ = testSuite("Thread/SharedLocker").dependsOn("UnitTest", "Thread/UniqueLocker") = [](TestSuite& suite) {
		suite.test("Unique access") = [&] {
			auto lockedString = CppUtils::Thread::SharedLocker<std::string>{"Foo"};
			{
				auto accessor = lockedString.uniqueAccess();
				expect(accessor.value()) == "Foo";
			}
		};

		suite.test("Unique access: Test mutex") = [&] {
			auto lockedNumber = CppUtils::Thread::SharedLocker{0uz};

			auto incrementFunction = [&lockedNumber](std::size_t iterations) noexcept -> void {
				while (iterations--)
				{
					auto accessor = lockedNumber.uniqueAccess();
					auto& nb = accessor.value();
					++nb;
				}
			};

			auto iterations = 1'000'000uz;
			{
				auto thread0 = std::jthread{incrementFunction, iterations};
				auto thread1 = std::jthread{incrementFunction, iterations};
			}
			auto accessor = lockedNumber.uniqueAccess();
			expect(accessor.value()) == iterations * 2;
		};

		suite.test("Shared access") = [&] {
			auto lockedString = CppUtils::Thread::SharedLocker<std::string>{"Foo"};
			{
				auto accessor0 = lockedString.sharedAccess();
				auto accessor1 = lockedString.sharedAccess();
				expect(accessor0.value()) == "Foo";
				expect(accessor1.value()) == "Foo";
			}
		};

		suite.test("MultipleAccessor") = [&] {
			auto lockedString1 = CppUtils::Thread::SharedLocker<std::string>{"Foo"};
			auto lockedString2 = CppUtils::Thread::SharedLocker<std::string>{"Bar"};
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{lockedString1, lockedString2};
				expect(std::get<0>(accessor.values)) == "Foo";
				expect(std::get<1>(accessor.values)) == "Bar";
			}
		};

		suite.test("Mixed access") = [&] {
			auto lockedString1 = CppUtils::Thread::UniqueLocker<std::string>{"Foo"};
			auto lockedString2 = CppUtils::Thread::SharedLocker<std::string>{"Bar"};
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{lockedString1, lockedString2};
				expect(std::get<0>(accessor.values)) == "Foo";
				expect(std::get<1>(accessor.values)) == "Bar";
			}
		};

		suite.test("Move constructor") = [&] {
			auto source = CppUtils::Thread::SharedLocker<std::unique_ptr<int>>{std::make_unique<int>(42)};
			auto destination = CppUtils::Thread::SharedLocker<std::unique_ptr<int>>{std::move(source)};

			expect(source.uniqueAccess().value()) == nullptr;
			expect(destination.sharedAccess().value()) != nullptr;
			expect(*destination.sharedAccess().value()) == 42;
		};

		suite.test("Move assignment") = [&] {
			auto source = CppUtils::Thread::SharedLocker<std::unique_ptr<int>>{std::make_unique<int>(100)};
			auto destination = CppUtils::Thread::SharedLocker<std::unique_ptr<int>>{std::make_unique<int>(200)};

			destination = std::move(source);

			expect(source.uniqueAccess().value()) == nullptr;
			expect(destination.sharedAccess().value()) != nullptr;
			expect(*destination.sharedAccess().value()) == 100;
		};
	};
}
