export module CppUtils.UnitTests.Thread.SharedPtr;

import CppUtils;

namespace CppUtils::UnitTest::Thread::SharedPtr
{
	auto _ = testSuite("Thread/SharedPtr").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test<[] {
			auto shared = CppUtils::Thread::makeShared<int>(42);
			if (not shared or shared.use_count() != 1uz)
				return false;

			auto copy = shared;
			if (shared.use_count() != 2uz or *copy != 42)
				return false;

			*copy = 100;
			if (*shared != 100)
				return false;

			auto weak = CppUtils::Thread::WeakPtr{shared};
			if (weak.expired() or weak.use_count() != 2uz)
				return false;

			auto locked = weak.lock();
			if (not locked or locked.use_count() != 3uz or *locked != 100)
				return false;

			return true;
		}>("Constexpr SharedPtr and WeakPtr");

		suite.test("Empty") = [&] {
			auto sharedInt = CppUtils::Thread::SharedPtr<int>{};

			expect(not sharedInt);
			expect(sharedInt.use_count()) == 0uz;
			expect(sharedInt) == nullptr;
			expect(nullptr) == sharedInt;
		};

		suite.test("Construction and dereference") = [&] {
			auto shared = CppUtils::Thread::makeShared<std::string>("Antigravity");
			expect(static_cast<bool>(shared));
			expect(shared.use_count()) == 1uz;
			expect(*shared) == "Antigravity";
			expect(shared->size()) == 11uz;
		};

		suite.test("Copy semantics and refcount") = [&] {
			auto shared1 = CppUtils::Thread::makeShared<int>(123);
			expect(shared1.use_count()) == 1uz;

			{
				auto shared2 = shared1;
				expect(shared1.use_count()) == 2uz;
				expect(shared2.use_count()) == 2uz;
				expect(*shared2) == 123;

				auto shared3 = CppUtils::Thread::SharedPtr<int>{};
				shared3 = shared2;
				expect(shared1.use_count()) == 3uz;
			}

			expect(shared1.use_count()) == 1uz;
		};

		suite.test("Move semantics") = [&] {
			auto shared1 = CppUtils::Thread::makeShared<int>(456);
			expect(shared1.use_count()) == 1uz;

			auto shared2 = std::move(shared1);
			expect(not shared1);
			expect(shared1.use_count()) == 0uz;
			expect(static_cast<bool>(shared2));
			expect(shared2.use_count()) == 1uz;
			expect(*shared2) == 456;

			auto shared3 = CppUtils::Thread::SharedPtr<int>{};
			shared3 = std::move(shared2);
			expect(not shared2);
			expect(shared3.use_count()) == 1uz;
			expect(*shared3) == 456;
		};

		suite.test("Reset") = [&] {
			auto shared = CppUtils::Thread::makeShared<int>(789);
			expect(shared.use_count()) == 1uz;

			shared.reset();
			expect(not shared);
			expect(shared.use_count()) == 0uz;
			expect(shared) == nullptr;
		};

		suite.test("WeakPtr basic and lock") = [&] {
			auto shared = CppUtils::Thread::makeShared<std::string>("WeakValue");
			auto weak = CppUtils::Thread::WeakPtr{shared};

			expect(not weak.expired());
			expect(weak.use_count()) == 1uz;

			auto locked = weak.lock();
			expect(static_cast<bool>(locked));
			expect(locked.use_count()) == 2uz;
			expect(*locked) == "WeakValue";
		};

		suite.test("WeakPtr expiration and destruction") = [&] {
			auto weak = CppUtils::Thread::WeakPtr<std::string>{};
			expect(weak.expired());
			expect(weak.use_count()) == 0uz;

			{
				auto shared = CppUtils::Thread::makeShared<std::string>("Temporary");
				weak = shared;
				expect(not weak.expired());
				expect(weak.use_count()) == 1uz;
			}

			expect(weak.expired());
			expect(weak.use_count()) == 0uz;
			auto locked = weak.lock();
			expect(not locked);
			expect(locked) == nullptr;
		};

		suite.test("Comparison and owner equality") = [&] {
			auto shared1 = CppUtils::Thread::makeShared<int>(10);
			auto shared2 = shared1;
			auto shared3 = CppUtils::Thread::makeShared<int>(10);

			expect(shared1) == shared2;
			expect(shared1.owner_equal(shared2));
			expect(CppUtils::Thread::ownerEqual(shared1, shared2));
			expect(not(shared1 == shared3));
			expect(not shared1.owner_equal(shared3));
			expect(not CppUtils::Thread::ownerEqual(shared1, shared3));
			expect(shared1) != nullptr;
			expect(nullptr) != shared1;

			auto weak1 = CppUtils::Thread::WeakPtr{shared1};
			auto weak2 = CppUtils::Thread::WeakPtr{shared2};
			auto weak3 = CppUtils::Thread::WeakPtr{shared3};

			expect(weak1) == weak2;
			expect(not(weak1 == weak3));
			expect(weak1.owner_equal(weak2));
			expect(CppUtils::Thread::ownerEqual(weak1, weak2));
			expect(not weak1.owner_equal(weak3));
			expect(not CppUtils::Thread::ownerEqual(weak1, weak3));
		};
	};
}
