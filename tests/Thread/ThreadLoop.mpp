export module CppUtils.UnitTests.Thread.ThreadLoop;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Thread::ThreadLoop
{
	auto _ = testSuite("Thread/ThreadLoop").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace std::chrono_literals;
		using Logger = TestSuite::Logger;

		suite.test("isRunning") = [&] {
			auto threadLoop = CppUtils::Thread::ThreadLoop{[] {
				std::this_thread::sleep_for(10ms);
			}};
			expect(not threadLoop.isRunning());
			threadLoop.start();
			expect(threadLoop.isRunning());
			threadLoop.stop();
			expect(not threadLoop.isRunning());
			threadLoop.start();
			expect(threadLoop.isRunning());
		};

		suite.test("Loop") = [&] {
			auto lockedNumber = CppUtils::Thread::UniqueLocker{0uz};
			{
				auto threadLoop = CppUtils::Thread::ThreadLoop{[&lockedNumber] {
					auto accessor = lockedNumber.access();
					auto& nb = accessor.value();
					if (nb < 5uz)
						++nb;
				}};
				threadLoop.start();
				expect([&lockedNumber] {
					return lockedNumber.access().value() >= 5uz;
				}) == eventually(500ms, 5ms);
			}
			auto accessor = lockedNumber.access();
			auto nb = accessor.value();
			expect(nb) == 5uz;
		};

		// Workaround on Windows (MSVC ABI)
		// https://github.com/llvm/llvm-project/issues/221609
#if defined(_WIN32)
		struct WorkaroundException final: std::exception
		{
			explicit WorkaroundException(const char* message) noexcept: m_message{message} {}
			[[nodiscard]] auto what() const noexcept -> const char* override
			{
				return m_message;
			}

		private:
			const char* m_message;
		};
		using TestException = WorkaroundException;
#else
		using TestException = std::runtime_error;
#endif

		suite.test("onError callback") = [&] {
			auto caughtMessage = CppUtils::Thread::UniqueLocker{""s};
			auto count = 0uz;

			auto threadLoop = CppUtils::Thread::ThreadLoop{[&count] {
				if (++count == 1)
					throw TestException{"Exception"}; // throw std::runtime_error{"Exception"};
				std::this_thread::sleep_for(10ms);
			}, nullptr, [&](std::exception_ptr exceptionPointer) {
				try
				{
					if (exceptionPointer)
						std::rethrow_exception(exceptionPointer);
				}
				catch (const std::exception& exception)
				{
					caughtMessage.access().value() = exception.what();
				}
			}};

			Logger::print<"detail">("Normal error message:");
			threadLoop.start();
			std::this_thread::sleep_for(50ms);

			expect(threadLoop.isRunning());
			threadLoop.stop();
			expect(not threadLoop.isRunning());

			expect(caughtMessage.access().value()) == "Exception";
		};
	};
}
