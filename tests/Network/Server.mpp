export module CppUtils.UnitTests.Network.Server;

import std;
import CppUtils;
import CppUtils.Network.Server;

namespace CppUtils::UnitTest::Network::Server
{
	auto _ = testSuite("Network/Server").dependsOn("Logger", "Network/Socket") = [](TestSuite& suite) {
		using Logger = TestSuite::Logger;

		suite.test("Server Creation") = [&] {
			auto server = CppUtils::Network::Server{};
		};

		suite.test("Bind IP") = [&] {
			auto server = CppUtils::Network::Server{};
			expect(server.setReuseAddress(true));
			expect(server.bind(8'080));
		};

		suite.test("Listening") = [&] {
			auto server = CppUtils::Network::Server{};
			expect(server.setReuseAddress(true));
			expect(server.bind(8'080));
			expect(server.listen());
			Logger::print("Server: Waiting for connections on port 8080...");
		};

		suite.test("Abort connection") = [&] {
			auto server = CppUtils::Network::Server{};
			expect(server.setReuseAddress(true));
			expect(server.bind(8'080));
			expect(server.listen());
			expect(server.setBlocking(false));
			Logger::print("Server: Waiting for connections on port 8080...");
			auto clientSocket = server.accept();
			expect(not clientSocket);
		};
	};
}
