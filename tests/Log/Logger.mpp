export module CppUtils.UnitTests.Logger;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Log::Logger
{
	auto _ = testSuite("Logger").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("In console") = [&] {
			Logger::print("Message");

			Logger::print<"info">("Information message");
			Logger::print<"important">("Important message");
			Logger::print<"success">("Success message");
			Logger::print<"debug">("Debug message");
			Logger::print<"detail">("Detail message");
			Logger::print<"warning">("Warning message");
			Logger::print<"error">("Error message");
		};

		suite.test("Subscribe and print") = [&] {
			using TestLogger = CppUtils::Logger<"TestLogger">;
			auto loggedMessages = std::vector<std::string>{};

			const TestLogger::SubscriptionIdentifier subscriptionIdentifier = TestLogger::subscribe([&loggedMessages](const std::string& message) {
				loggedMessages.push_back(message);
			});

			TestLogger::print("Hello {}", "world");
			TestLogger::waitUntilFinished();

			expect(std::ranges::size(loggedMessages)) == 1uz;
			if (not std::ranges::empty(loggedMessages))
				expect(loggedMessages.front()) == "Hello world";

			expect(TestLogger::unsubscribe(subscriptionIdentifier));
		};

		suite.test("Unsubscribe") = [&] {
			using TestLogger = CppUtils::Logger<"TestLogger">;
			auto count = 0;

			const auto subscriptionIdentifier = TestLogger::subscribe<"custom">([&count] {
				++count;
			});

			TestLogger::emit<"custom">();
			TestLogger::waitUntilFinished();
			expect(count) == 1;

			expect(TestLogger::unsubscribe(subscriptionIdentifier));

			TestLogger::emit<"custom">();
			TestLogger::waitUntilFinished();
			expect(count) == 1;

			expect(not TestLogger::unsubscribe(subscriptionIdentifier));
		};

		suite.test("Clear subscribers") = [&] {
			using TestLogger = CppUtils::Logger<"TestLogger">;
			auto countA = 0;
			auto countB = 0;

			TestLogger::subscribe<"typeA">([&countA] { ++countA; });
			TestLogger::subscribe<"typeB">([&countB] { ++countB; });

			TestLogger::emit<"typeA">();
			TestLogger::emit<"typeB">();
			TestLogger::waitUntilFinished();
			expect(countA) == 1;
			expect(countB) == 1;

			TestLogger::clearSubscribers();

			TestLogger::emit<"typeA">();
			TestLogger::emit<"typeB">();
			TestLogger::waitUntilFinished();
			expect(countA) == 1;
			expect(countB) == 1;
		};

		suite.test("Unsubscribe by log type") = [&] {
			using TestLogger = CppUtils::Logger<"TestLogger">;
			auto countA = 0;
			auto countB = 0;

			TestLogger::subscribe<"typeA">([&countA] { ++countA; });
			TestLogger::subscribe<"typeB">([&countB] { ++countB; });

			TestLogger::emit<"typeA">();
			TestLogger::emit<"typeB">();
			TestLogger::waitUntilFinished();
			expect(countA) == 1;
			expect(countB) == 1;

			expect(TestLogger::unsubscribe<"typeA">());

			TestLogger::emit<"typeA">();
			TestLogger::emit<"typeB">();
			TestLogger::waitUntilFinished();
			expect(countA) == 1;
			expect(countB) == 2;

			TestLogger::clearSubscribers();
		};
	};
}
