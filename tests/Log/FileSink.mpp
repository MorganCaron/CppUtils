export module CppUtils.UnitTests.Log.FileSink;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Log::FileSink
{
	auto _ = testSuite("Log/FileSink").dependsOn("Logger", "FileSystem/Directory") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("In file") = [&] {
			CppUtils::FileSystem::TemporaryDirectory{[](const auto& directory) -> void {
				const auto logPath = directory / "test.log";
				CppUtils::Log::addFileSink<"FileLogger">({.filePath = logPath});

				CppUtils::Logger<"FileLogger">::print("Message");
				CppUtils::Logger<"FileLogger">::waitUntilFinished();

				expect(std::filesystem::exists(logPath));
				expect(CppUtils::FileSystem::String::read(logPath)) == "Message";
			}};
		};
	};
}
