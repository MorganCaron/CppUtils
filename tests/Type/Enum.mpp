export module CppUtils.UnitTests.Type.Enum;

import std;
import CppUtils;

namespace
{
	enum class Enum1
	{
		A,
		B,
		C
	};
	enum class Enum2
	{
		A,
		B
	};
	enum class Enum3
	{
		A,
		B
	};
}

namespace CppUtils::Type::Enum
{
	template<>
	constexpr auto Values<Enum1> = std::make_tuple(Enum1::A, Enum1::B, Enum1::C);
	template<>
	constexpr auto Name<Enum1::A> = "A1"sv;
	template<>
	constexpr auto Name<Enum1::B> = "B1"sv;
	template<>
	constexpr auto Name<Enum1::C> = "C1"sv;

	template<>
	constexpr auto Values<Enum2> = std::make_tuple(Enum2::A, Enum2::B);
	template<>
	constexpr auto Name<Enum2::A> = "A2"sv;

	template<>
	constexpr auto Values<Enum3> = std::make_tuple(Enum3::A);
	template<>
	constexpr auto Name<Enum3::A> = "A3"sv;
	template<>
	constexpr auto Name<Enum3::B> = "B3"sv;
}

namespace CppUtils::UnitTest::Type::Enum
{
	auto _ = testSuite("Type/Enum").dependsOn("UnitTest") = [](TestSuite& suite) {
		suite.test("Basic") = [&] {
			expect(CppUtils::Type::Enum::toString(Enum1::A)) == "A1";
			expect(CppUtils::Type::Enum::toString(Enum1::B)) == "B1";
			expect(CppUtils::Type::Enum::toString(Enum1::C)) == "C1";
		};

		suite.test("Missing value") = [&] {
			expect(CppUtils::Type::Enum::toString(Enum2::A)) == "A2";
			expect(CppUtils::Type::Enum::toString(Enum2::B)) == "Unknown";
		};

		suite.test("Missing name") = [&] {
			expect(CppUtils::Type::Enum::toString(Enum3::A)) == "A3";
			expect(CppUtils::Type::Enum::toString(Enum3::B)) == "Unknown";
		};
	};
}
