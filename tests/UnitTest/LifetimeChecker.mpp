export module CppUtils.UnitTests.UnitTest.LifetimeChecker;

import std;
import CppUtils;

namespace CppUtils::UnitTest::LifetimeCheckerTest
{
	auto _ = testSuite("UnitTest/LifetimeChecker") = [](TestSuite& suite) {
		using Logger = TestSuite::Logger;

		suite.test("No Copy No Move") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			expect(object.getCopyCount()) == 0uz;
			expect(object.getMoveCount()) == 0uz;
		};

		suite.test("Copy Construction") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto copied = object;
			expect(copied.getCopyCount()) == 1uz;
			expect(copied.getMoveCount()) == 0uz;
		};

		suite.test("Move Construction") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto moved = std::move(object);
			expect(moved.getCopyCount()) == 0uz;
			expect(moved.getMoveCount()) == 1uz;
		};

		suite.test("Copy Assignment") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto target = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "Target"};
			target = object;
			expect(target.getCopyCount()) == 1uz;
			expect(target.getMoveCount()) == 0uz;
		};

		suite.test("Move Assignment") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto target = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "Target"};
			target = std::move(object);
			expect(target.getCopyCount()) == 0uz;
			expect(target.getMoveCount()) == 1uz;
		};

		suite.test("Two Copies") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto copy1 = object;
			auto copy2 = copy1;
			expect(copy2.getCopyCount()) == 2uz;
			expect(copy2.getMoveCount()) == 0uz;
		};

		suite.test("Two Moves") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto moved1 = std::move(object);
			auto moved2 = std::move(moved1);
			expect(moved2.getCopyCount()) == 0uz;
			expect(moved2.getMoveCount()) == 2uz;
		};

		suite.test("Copy then Move") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto copy = object;
			auto moved = std::move(copy);
			expect(moved.getCopyCount()) == 1uz;
			expect(moved.getMoveCount()) == 1uz;
		};

		suite.test("Move then Copy") = [&] {
			auto object = LifetimeChecker{[](std::string_view message) { Logger::print<"info">("{}", message); }, "LifetimeChecker"};
			auto moved = std::move(object);
			auto copy = moved;
			expect(copy.getCopyCount()) == 1uz;
			expect(copy.getMoveCount()) == 1uz;
		};
	};
}
