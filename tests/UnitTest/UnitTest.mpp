export module CppUtils.UnitTests.UnitTest;

import std;
import CppUtils;

namespace CppUtils::UnitTest::UnitTest
{
	auto _ = TestSuite{"UnitTest", [](TestSuite& suite) {
		suite.addTest("empty test", [] {});

		suite.addTest("expect", [&] {
			suite.expect(true);
		});

		suite.addTest("expectEqual", [&] {
			using namespace std::literals;

			suite.expectEqual(1, 1);
			suite.expectEqual("test"sv, "test"sv);
		});

		suite.addTest("expectWait", [&] {
			using namespace std::chrono_literals;

			suite.expectWait([] {
				return true;
			});

			auto counter = 0uz;
			suite.expectWait([&] {
				return ++counter >= 3uz;
			}, 200ms, 10ms);

			suite.expectThrow<CppUtils::UnitTest::TestException>([&] {
				suite.expectWait([] {
					return false;
				}, 30ms, 10ms);
			});
		});

		suite.addTest("Canary: LLVM #221609 std::throw_with_nested double-free", [&] {
#if defined(_WIN32)
			suite.skip("Waiting for LLVM issue #221609 fix: https://github.com/llvm/llvm-project/issues/221609");
#else
			using namespace std::literals;
			auto caughtMessage = std::string{};
			try
			{
				try
				{
					throw std::runtime_error{"Canary inner"};
				}
				catch (const std::exception&)
				{
					std::throw_with_nested(std::runtime_error{"Canary outer"});
				}
			}
			catch (const std::exception& exception)
			{
				caughtMessage = exception.what();
			}
			suite.expectEqual(caughtMessage, "Canary outer"s);
#endif
		});
	}};
}
