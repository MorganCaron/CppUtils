export module CppUtils.UnitTests.Math.BigInt;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Math
{
	auto _ = testSuite("Math/BigInt") = [](TestSuite& suite) {
		using namespace CppUtils::Math::Literals;
		using CppUtils::Math::BigUInt;
		using CppUtils::Math::BigInt;

		suite.test("BigUInt Construction & Equality") = [&] {
			const auto firstValue = 12'345_bigUInt;
			const auto secondValue = 0x30'39_bigUInt;

			expect(firstValue) == secondValue;

			const auto bytes = firstValue.toBytes();
			expect(std::ranges::size(bytes)) == 2uz;
			expect(bytes[0]) == 0x30;
			expect(bytes[1]) == 0x39;
		};

		suite.test("BigInt Signed Construction & Negation") = [&] {
			const auto positiveValue = 12'345_bigInt;
			const auto negativeValue = -positiveValue;

			not expect(positiveValue.isNegative());
			expect(negativeValue.isNegative());
			expect(negativeValue) < positiveValue;
			expect(positiveValue + negativeValue) == 0_bigInt;

			const auto parsedNegativeValue = "-12345"_bigInt;
			expect(parsedNegativeValue) == negativeValue;
		};

		suite.test("BigInt Signed Addition & Subtraction") = [&] {
			auto value = 10_bigInt;
			value += 20_bigInt;
			expect(value) == 30_bigInt;

			value -= 50_bigInt;
			expect(value) == -20_bigInt;
			expect(value.isNegative());

			value += 30_bigInt;
			expect(value) == 10_bigInt;
			not expect(value.isNegative());
		};

		suite.test("BigInt Signed Multiplication & Division") = [&] {
			const auto firstOperand = -10_bigInt;
			const auto secondOperand = 20_bigInt;

			const auto product = firstOperand * secondOperand;
			expect(product) == -200_bigInt;
			expect(product.isNegative());

			const auto quotient = product / firstOperand;
			expect(quotient) == 20_bigInt;
			not expect(quotient.isNegative());
		};

		suite.test("ModPow") = [&] {
			const auto base = 2_bigUInt;
			const auto exponent = 10_bigUInt;
			const auto modulus = 1'000_bigUInt;

			const auto result = base.modPow(exponent, modulus);
			expect(result) == 24_bigUInt;
		};

		suite.test("Large ModPow") = [&] {
			const auto base = 123_bigUInt;
			const auto exponent = 456_bigUInt;
			const auto modulus = 789_bigUInt;

			const auto result = base.modPow(exponent, modulus);
			expect(result) == 699_bigUInt;
		};

		suite.test("Decimal Literal (Large)") = [&] {
			const auto value = 12'345'678'901'234'567'890_bigUInt;

			const auto bytes = value.toBytes();
			expect(std::ranges::size(bytes)) == 8uz;
			expect(bytes[0]) == 0xAB;
			expect(bytes[7]) == 0xD2;
		};

		suite.test("Parsing (decimal)") = [&] {
			const auto validPositive = BigInt::parse("12345");
			expect(validPositive.has_value());
			expect(validPositive.value()) == 12345_bigInt;
		};

		suite.test("Parsing (negative decimal)") = [&] {
			const auto validSigned = BigInt::parse("-12345");
			expect(validSigned.has_value());
			expect(validSigned.value()) == -12345_bigInt;
		};

		suite.test("Parsing (invalid unsigned)") = [&] {
			const auto invalidUnsigned = BigUInt::parse("-10");
			expect(not invalidUnsigned.has_value());
		};

		suite.test("Parsing (hexadecimal)") = [&] {
			const auto validHex = BigInt::parse("0x3039");
			expect(validHex.has_value());
			expect(validHex.value()) == 12345_bigInt;
		};

		suite.test("Parsing (invalid hexadecimal)") = [&] {
			const auto invalidHex = BigInt::parse("0xGHI");
			expect(not invalidHex.has_value());
		};

		suite.test("divMod") = [&] {
			const auto numerator = 100_bigInt;
			const auto denominator = 7_bigInt;
			const auto divResult = numerator.divMod(denominator);
			expect(divResult.has_value());
			expect(divResult->quotient) == 14_bigInt;
			expect(divResult->remainder) == 2_bigInt;

			const auto divZeroResult = numerator.divMod(0_bigInt);
			expect(not divZeroResult.has_value());
		};

		suite.test("constexpr support") = [&] {
			const auto result = []() constexpr {
				auto leftOperand = 10_bigInt;
				auto rightOperand = -20_bigInt;
				return leftOperand + rightOperand == -10_bigInt;
			}();
			expect(result);
		};
	};
}
