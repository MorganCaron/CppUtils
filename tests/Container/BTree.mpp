export module CppUtils.UnitTests.Container.BTree;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::BTree
{
	auto _ = testSuite("Container/BTree").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("Empty") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			Logger::print("{}", bTree);
			expect(std::ranges::empty(bTree));
		};

		suite.test("1 element") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			Logger::print("{}", bTree);
			expect(not std::ranges::empty(bTree));
			expect(std::ranges::size(bTree)) == 1uz;
		};

		suite.test("2 elements") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			bTree.add(1, 'B');
			Logger::print("{}", bTree);
			expect(std::ranges::size(bTree)) == 2uz;
		};

		suite.test("5 elements (split self)") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			for (auto i = 0; i < 5; ++i)
				bTree.add(i, 'A' + static_cast<char>(i));
			Logger::print("{}", bTree);
			expect(std::ranges::size(bTree)) == 5uz;
		};

		suite.test("8 elements (split self & split child)") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			for (auto i = 0; i < 8; ++i)
				bTree.add(i, 'A' + static_cast<char>(i));
			Logger::print("{}", bTree);
			expect(std::ranges::size(bTree)) == 8uz;
		};

		suite.test("10 elements") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			for (auto i = 0; i < 10; ++i)
				bTree.add(i, 'A' + static_cast<char>(i));
			Logger::print("{}", bTree);
			expect(std::ranges::size(bTree)) == 10uz;
		};

		suite.test("Exists") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			Logger::print("{}", bTree);
			expect(bTree.exists(0));
			expect(not bTree.exists(1));
		};

		suite.test("Key hasher") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<std::string, int>{};
			bTree.add("test", 0);
			Logger::print("{}", bTree);
			expect(std::ranges::size(bTree)) == 1uz;
		};

		suite.test("Removing element") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			bTree.remove(0);
			Logger::print("{}", bTree);
			expect(std::ranges::empty(bTree));
		};

		suite.test("Removing nested element") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			Logger::print("{}", bTree);
			expect(std::ranges::empty(bTree));
		};

		suite.test("Clear") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			bTree.clear();
			Logger::print("{}", bTree);
			expect(std::ranges::empty(bTree));
		};

		suite.test("Search key") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			Logger::print("{}", bTree);
			expect(bTree.exists(0));
			expect(bTree.get(0)) == 'A';
		};

		suite.test("Set value") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree[0] = 'A';
			Logger::print("{}", bTree);
			expect(not std::ranges::empty(bTree));
			expect(bTree.exists(0));
			expect(bTree.get(0)) == 'A';
		};

		suite.test("Edit value") = [&] {
			auto bTree = CppUtils::Container::BTree::Node<int, char>{};
			bTree.add(0, 'A');
			bTree[0] = 'B';
			Logger::print("{}", bTree);
			expect(bTree.size()) == 1uz;
			expect(bTree.exists(0));
			expect(bTree.get(0)) == 'B';
		};
	};
}
