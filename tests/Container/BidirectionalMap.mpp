export module CppUtils.UnitTests.Container.BidirectionalMap;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::BidirectionalMap
{
	auto _ = testSuite("Container/BidirectionalMap").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("Empty Map") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, int>{};
			expect(std::ranges::empty(map));
			expect(std::ranges::size(map)) == 0uz;
		};

		suite.test("One value") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, std::string>{};
			map.insert({42, "Hello World!"s});
			expect(not std::ranges::empty(map));
			expect(std::ranges::size(map)) == 1uz;
			expect(map.left(42)) == "Hello World!";
			expect(map.right("Hello World!"s)) == 42;
		};

		suite.test("Erase value") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, std::string>{};
			map.insert({42, "Hello World!"s});
			map.eraseLeft(42);
			expect(std::ranges::empty(map));
		};

		suite.test("Direct insert with two arguments") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, std::string>{};
			expect(map.insert(1, "one"s));
			expect(map.insert(2, "two"s));
			expect(not map.insert(1, "another one"s)); // Collision on left
			expect(not map.insert(3, "two"s)); // Collision on right
			expect(std::ranges::size(map)) == 2uz;
			expect(map.containsLeft(1));
			expect(map.containsRight("two"s));
			expect(not map.containsLeft(99));
			expect(not map.containsRight("unknown"s));
		};

		suite.test("Variadic construction") = [&] {
			using BidiMap = CppUtils::Container::BidirectionalMap<int, std::string>;
			auto map = BidiMap{
				std::pair{1, "un"s},
				std::pair{2, "deux"s},
				std::pair{3, "trois"s}};
			expect(std::ranges::size(map)) == 3uz;
			expect(map.left(1)) == "un";
			expect(map.right("deux"s)) == 2;
		};

		suite.test("Iterator constructor") = [&] {
			using Pair = std::pair<int, std::string>;
			const auto source = std::vector<Pair>{
				{10, "ten"s},
				{20, "twenty"s}};
			const auto map = CppUtils::Container::BidirectionalMap<int, std::string>{std::ranges::begin(source), std::ranges::end(source)};
			expect(std::ranges::size(map)) == 2uz;
			expect(map.left(10)) == "ten";
			expect(map.right("twenty"s)) == 20;
		};

		suite.test("Erase right") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, std::string>{};
			map.insert(10, "ten"s);
			map.insert(20, "twenty"s);
			expect(map.eraseRight("ten"s));
			expect(std::ranges::size(map)) == 1uz;
			expect(not map.containsLeft(10));
			expect(map.containsLeft(20));
			expect(not map.eraseRight("unknown"s));
		};

		suite.test("Clear") = [&] {
			auto map = CppUtils::Container::BidirectionalMap<int, std::string>{};
			map.insert(1, "one"s);
			map.insert(2, "two"s);
			expect(not std::ranges::empty(map));
			map.clear();
			expect(std::ranges::empty(map));
			expect(std::ranges::size(map)) == 0uz;
		};
	};
}
