export module CppUtils.UnitTests.Container.MultiKeyMap;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::MultiKeyMap
{
	struct UserData final
	{
		int age;
		std::string role;

		[[nodiscard]] inline constexpr auto operator==(const UserData& other) const noexcept -> bool = default;
	};

	auto _ = testSuite("Container/MultiKeyMap").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;

		using UserMap = CppUtils::Container::MultiKeyMap<
			int,
			std::string,
			CppUtils::Container::NonUnique<std::string_view>,
			UserData>;

		static_assert(std::ranges::range<UserMap>);
		static_assert(std::ranges::sized_range<UserMap>);
		static_assert(std::ranges::common_range<UserMap>);
		static_assert(std::ranges::bidirectional_range<UserMap>);
		static_assert(std::ranges::random_access_range<UserMap>);

		suite.test("Insertion and emplace") = [&] {
			auto users = UserMap{};
			expect(std::ranges::empty(users));
			expect(std::ranges::size(users)) == 0uz;

			const auto [aliceIterator, insertedAlice] = users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			expect(insertedAlice);
			expect(aliceIterator) != std::ranges::end(users);
			expect(aliceIterator->value.age) == 30;

			const auto [bobIterator, insertedBob] = users.emplace(2, "Bob"s, "Design"sv, UserData{.age = 28, .role = "UI"});
			expect(insertedBob);
			expect(bobIterator) != std::ranges::end(users);

			expect(std::ranges::size(users)) == 2uz;
			expect(not std::ranges::empty(users));
		};

		suite.test("Direct construction with makeEntry") = [&] {
			const auto users = UserMap{
				UserMap::makeEntry(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"}),
				UserMap::makeEntry(2, "Bob"s, "Design"sv, UserData{.age = 28, .role = "UI"})};

			expect(std::ranges::size(users)) == 2uz;
			expect(users.contains(1));
			expect(users.contains("Alice"s));
			expect(users.contains(2));
			expect(users.contains("Bob"s));
			expect(users.at(1)) == UserData{.age = 30, .role = "Dev"};
			expect(users.at("Bob"s)) == UserData{.age = 28, .role = "UI"};
			expect(users.at(1).age) == 30;
			expect(users.at("Bob"s).role) == "UI";
		};

		suite.test("Variadic construction with move-only values") = [&] {
			using MoveOnlyMap = CppUtils::Container::MultiKeyMap<int, std::string, std::unique_ptr<int>>;

			auto map = MoveOnlyMap{
				MoveOnlyMap::makeEntry(1, "one"s, std::make_unique<int>(100)),
				MoveOnlyMap::makeEntry(2, "two"s, std::make_unique<int>(200))};

			expect(std::ranges::size(map)) == 2uz;
			expect(map.contains(1));
			expect(map.contains("two"s));
			expect(*map.at(1)) == 100;
			expect(*map.at("two"s)) == 200;
		};

		suite.test("Type-deduced lookup by key type") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Design"sv, UserData{.age = 28, .role = "UI"});

			// Automatic type-deduced find (int uniquely resolves to Key 0)
			const auto foundById = users.find(1);
			expect(foundById) != std::ranges::end(users);
			expect(foundById->value) == UserData{.age = 30, .role = "Dev"};

			// Automatic type-deduced find (std::string uniquely resolves to Key 1)
			const auto foundByName = users.find("Bob"s);
			expect(foundByName) != std::ranges::end(users);
			expect(foundByName->value) == UserData{.age = 28, .role = "UI"};

			// Missing key
			const auto notFound = users.find(999);
			expect(notFound) == std::ranges::end(users);
		};

		suite.test("Tagged key lookup and containment") = [&] {
			using TaggedMap = CppUtils::Container::MultiKeyMap<
				CppUtils::Container::TaggedKey<"Sender", int>,
				CppUtils::Container::TaggedKey<"Receiver", int>,
				std::string>;

			auto messages = TaggedMap{};
			messages.insert(100, 200, "Hello"s);
			messages.insert(300, 400, "World"s);

			expect(messages.contains<"Sender">(100));
			expect(messages.contains<"Receiver">(200));
			expect(not messages.contains<"Sender">(200));
			expect(not messages.contains<"Receiver">(100));

			const auto senderIterator = messages.find<"Sender">(100);
			expect(senderIterator) != std::ranges::end(messages);
			expect(senderIterator->value) == "Hello";

			const auto receiverIterator = messages.find<"Receiver">(400);
			expect(receiverIterator) != std::ranges::end(messages);
			expect(receiverIterator->value) == "World";
		};

		suite.test("Positional index lookup and containment") = [&] {
			using TaggedMap = CppUtils::Container::MultiKeyMap<
				CppUtils::Container::TaggedKey<"Sender", int>,
				CppUtils::Container::TaggedKey<"Receiver", int>,
				std::string>;

			auto messages = TaggedMap{};
			messages.insert(100, 200, "Hello"s);
			messages.insert(300, 400, "World"s);

			expect(messages.containsAt<0uz>(100));
			expect(messages.containsAt<1uz>(200));
			expect(not messages.containsAt<0uz>(200));
			expect(not messages.containsAt<1uz>(100));

			const auto senderIterator = messages.findAt<0uz>(100);
			expect(senderIterator) != std::ranges::end(messages);
			expect(senderIterator->value) == "Hello";

			const auto receiverIterator = messages.findAt<1uz>(400);
			expect(receiverIterator) != std::ranges::end(messages);
			expect(receiverIterator->value) == "World";
		};

		suite.test("Key containment and count queries") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});

			expect(users.contains(1));
			expect(users.contains("Alice"s));
			expect(not users.contains(999));
			expect(not users.contains("Unknown"s));

			expect(users.count(1)) == 1uz;
			expect(users.count("Alice"s)) == 1uz;
			expect(users.count(999)) == 0uz;
			expect(users.count("Unknown"s)) == 0uz;
		};

		suite.test("Element access with at() and operator[]") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Design"sv, UserData{.age = 28, .role = "UI"});

			// at() reading
			expect(users.at(1)) == UserData{.age = 30, .role = "Dev"};
			expect(users.at("Alice"s)) == UserData{.age = 30, .role = "Dev"};
			expect([&] { auto _ = users.at(999); }) == throws<std::out_of_range>;

			// operator[] reading and mutation
			users[1].age = 31;
			expect(users.at(1)) == UserData{.age = 31, .role = "Dev"};

			users["Bob"s].role = "Senior UI";
			expect(users.at(2)) == UserData{.age = 28, .role = "Senior UI"};
		};

		suite.test("Unique constraints across multiple keys") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});

			// Duplicate identifier (Key 0)
			const auto [duplicateIdentifierIterator, insertedDuplicateId] = users.insert(1, "Charlie"s, "Engineering"sv, UserData{.age = 22, .role = "Junior"});
			expect(not insertedDuplicateId);
			expect(duplicateIdentifierIterator) == std::ranges::end(users);

			// Duplicate name (Key 1)
			const auto [duplicateNameIterator, insertedDuplicateName] = users.insert(3, "Alice"s, "Marketing"sv, UserData{.age = 35, .role = "Lead"});
			expect(not insertedDuplicateName);
			expect(duplicateNameIterator) == std::ranges::end(users);

			expect(std::ranges::size(users)) == 1uz;
		};

		suite.test("Non-unique key range lookup") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Engineering"sv, UserData{.age = 28, .role = "Dev"});
			users.insert(3, "Charlie"s, "Design"sv, UserData{.age = 25, .role = "UI"});

			expect(users.count("Engineering"sv)) == 2uz;
			expect(users.count("Design"sv)) == 1uz;
			expect(users.count("HR"sv)) == 0uz;

			const auto engineers = users.find("Engineering"sv);
			static_assert(std::ranges::random_access_range<decltype(engineers)>);
			expect(std::ranges::size(engineers)) == 2uz;
			expect(not std::ranges::empty(engineers));

			const auto engineeringAges = engineers
				| std::views::transform([](const auto& engineer) { return engineer.value.age; })
				| std::ranges::to<std::vector>();

			expect(std::ranges::size(engineeringAges)) == 2uz;
			expect(std::ranges::contains(engineeringAges, 30));
			expect(std::ranges::contains(engineeringAges, 28));
		};

		suite.test("Erase by key and swap-and-pop integrity") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Engineering"sv, UserData{.age = 28, .role = "Dev"});
			users.insert(3, "Charlie"s, "Design"sv, UserData{.age = 25, .role = "UI"});

			// Erase by unique int key
			const auto erasedAlice = users.erase(1);
			expect(erasedAlice);
			expect(std::ranges::size(users)) == 2uz;
			expect(not users.contains(1));
			expect(not users.contains("Alice"s));

			// Bob and Charlie must still be accessible via all keys after swap-and-pop
			expect(users.contains(2));
			expect(users.contains("Bob"s));
			expect(users.contains(3));
			expect(users.contains("Charlie"s));
			expect(users.count("Engineering"sv)) == 1uz;

			// Erase by unique string key
			const auto erasedBob = users.erase("Bob"s);
			expect(erasedBob);
			expect(std::ranges::size(users)) == 1uz;
			expect(users.contains(3));
		};

		suite.test("Erase by iterator") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Engineering"sv, UserData{.age = 28, .role = "Dev"});

			const auto iterator = std::ranges::begin(users);
			const auto nextIterator = users.erase(iterator);
			expect(std::ranges::size(users)) == 1uz;
			expect(nextIterator) == std::ranges::begin(users);

			users.erase(nextIterator);
			expect(std::ranges::empty(users));
			expect(std::ranges::size(users)) == 0uz;
		};

		suite.test("Standard range algorithms and views pipeline") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Engineering"sv, UserData{.age = 28, .role = "Dev"});
			users.insert(3, "Charlie"s, "Design"sv, UserData{.age = 25, .role = "UI"});

			// std::ranges::for_each
			auto totalAge = 0;
			std::ranges::for_each(users, [&](const auto& entry) {
				totalAge += entry.value.age;
			});
			expect(totalAge) == 83;

			// std::ranges::max_element
			const auto oldest = std::ranges::max_element(users, {}, [](const auto& entry) {
				return entry.value.age;
			});
			expect(oldest) != std::ranges::end(users);
			expect(oldest->value.age) == 30;

			// Views pipeline
			const auto collectedRoles = users
				| std::views::filter([](const auto& entry) { return entry.value.age >= 28; })
				| std::views::transform([](const auto& entry) { return entry.value.role; })
				| std::ranges::to<std::vector>();

			expect(std::ranges::size(collectedRoles)) == 2uz;
		};

		suite.test("Structured binding on entries") = [&] {
			auto users = UserMap{};
			users.insert(1, "Alice"s, "Engineering"sv, UserData{.age = 30, .role = "Dev"});
			users.insert(2, "Bob"s, "Engineering"sv, UserData{.age = 28, .role = "Dev"});
			users.insert(3, "Charlie"s, "Design"sv, UserData{.age = 25, .role = "UI"});

			auto boundNames = std::vector<std::string>{};
			for (const auto& [id, name, department, data] : users)
			{
				expect(id) > 0;
				expect(not std::ranges::empty(name));
				boundNames.push_back(name);
			}
			expect(std::ranges::size(boundNames)) == 3uz;
		};

		suite.test("Single key map with value") = [&] {
			using SingleKeyMap = CppUtils::Container::MultiKeyMap<int, std::string>;

			auto map = SingleKeyMap{};
			const auto [firstIterator, insertedFirst] = map.insert(1, "one"s);
			expect(insertedFirst);
			expect(firstIterator) != std::ranges::end(map);
			expect(firstIterator->value) == "one";

			map.emplace(2, "two"s);
			expect(std::ranges::size(map)) == 2uz;

			// Duplicate key rejection
			const auto [duplicateIterator, insertedDuplicate] = map.insert(1, "duplicate"s);
			expect(not insertedDuplicate);
			expect(duplicateIterator) == std::ranges::end(map);

			// Lookup & access
			expect(map.contains(1));
			expect(not map.contains(99));
			expect(map.count(1)) == 1uz;
			expect(map.count(99)) == 0uz;

			const auto foundIterator = map.find(2);
			expect(foundIterator) != std::ranges::end(map);
			expect(foundIterator->value) == "two";

			expect(map.at(1)) == "one";
			map[1] = "uno"s;
			expect(map.at(1)) == "uno";

			map[3] = "three"s;
			expect(std::ranges::size(map)) == 3uz;
			expect(map.at(3)) == "three";

			// Erase
			const auto erased = map.erase(1);
			expect(erased);
			expect(std::ranges::size(map)) == 2uz;
			expect(not map.contains(1));
		};

		suite.test("Value=void bidirectional key container") = [&] {
			using BiKeyMap = CppUtils::Container::MultiKeyMap<int, std::string, void>;

			auto pairs = BiKeyMap{};
			pairs.insert(1, "one"s);
			pairs.insert(2, "two"s);

			expect(std::ranges::size(pairs)) == 2uz;
			expect(pairs.contains(1));
			expect(pairs.contains("one"s));

			// at() on void value returns the counterpart key
			expect(pairs.at(1)) == "one";
			expect(pairs.at("two"s)) == 2;

			// Structured binding
			for (const auto& [number, text] : pairs)
				expect(number > 0 and not std::ranges::empty(text));
		};

		suite.test("Three keys and void value container") = [&] {
			using TripleKeyMap = CppUtils::Container::MultiKeyMap<
				CppUtils::Container::TaggedKey<"Id", int>,
				CppUtils::Container::TaggedKey<"Name", std::string>,
				CppUtils::Container::TaggedKey<"Score", double>,
				void>;

			auto records = TripleKeyMap{};
			const auto [aliceIterator, insertedAlice] = records.insert(1, "Alice"s, 95.5);
			expect(insertedAlice);
			expect(aliceIterator) != std::ranges::end(records);

			records.insert(2, "Bob"s, 82.0);
			expect(std::ranges::size(records)) == 2uz;

			// Uniqueness collision on any of the three keys
			const auto [duplicateIdIterator, insertedDuplicateId] = records.insert(1, "Charlie"s, 70.0);
			expect(not insertedDuplicateId);
			expect(duplicateIdIterator) == std::ranges::end(records);

			const auto [duplicateNameIterator, insertedDuplicateName] = records.insert(3, "Alice"s, 60.0);
			expect(not insertedDuplicateName);
			expect(duplicateNameIterator) == std::ranges::end(records);

			const auto [duplicateScoreIterator, insertedDuplicateScore] = records.insert(4, "David"s, 95.5);
			expect(not insertedDuplicateScore);
			expect(duplicateScoreIterator) == std::ranges::end(records);

			// Lookups on each axis
			expect(records.contains(1));
			expect(records.contains("Bob"s));
			expect(records.contains(95.5));
			expect(not records.contains(999));

			const auto foundById = records.find<"Id">(1);
			expect(foundById) != std::ranges::end(records);
			expect(foundById->template key<1uz>()) == "Alice";
			expect(foundById->template key<double>()) == 95.5;

			const auto foundByName = records.find<"Name">("Bob"s);
			expect(foundByName) != std::ranges::end(records);
			expect(foundByName->template key<0uz>()) == 2;
			expect(foundByName->template key<double>()) == 82.0;

			// Structured binding
			for (const auto& [id, name, score] : records)
			{
				expect(id) > 0;
				expect(not std::ranges::empty(name));
				expect(score) > 0.0;
			}

			// Erase on any axis
			const auto erasedBob = records.erase("Bob"s);
			expect(erasedBob);
			expect(std::ranges::size(records)) == 1uz;
			expect(not records.contains(2));
			expect(not records.contains("Bob"s));
			expect(not records.contains(82.0));
		};
	};
}
