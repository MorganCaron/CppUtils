export module CppUtils.UnitTests.Container.MeshNetwork;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::MeshNetwork
{
	auto _ = testSuite("Container/MeshNetwork").dependsOn("Container/NetworkPtr") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;
		using StringMeshNodePtr = CppUtils::Container::MeshNodePtr<std::string, std::string>;

		suite.test("Initialization") = [&] {
			auto _ = StringMeshNodePtr::make("banana");
		};

		suite.test("Access value") = [&] {
			auto node = StringMeshNodePtr::make("apple");
			auto accessor = node.getValue();
			const auto& value = accessor.value();
			Logger::print("{}", value);
			expect(value) == "apple";
		};

		suite.test("Copy reference") = [&] {
			auto node2 = StringMeshNodePtr{};
			{
				auto node1 = StringMeshNodePtr::make("apple");
				node2 = node1;
			}
			auto accessor = node2.getValue();
			const auto& value = accessor.value();
			Logger::print("{}", value);
			expect(value) == "apple";
		};

		suite.test("Attach child") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			{
				auto apple = StringMeshNodePtr::make("apple");
				fruit["Elements"] >> apple;
			}

			auto fruitAccessor = fruit.getValue();
			const auto& fruitValue = fruitAccessor.value();
			expect(fruitValue) == "fruit";

			auto branches = fruit.at("Elements").value();
			expect(std::ranges::size(branches)) == 1uz;
			{
				auto appleAccessor = branches[0].value().getValue();
				const auto& appleValue = appleAccessor.value();
				Logger::print("{}", appleValue);
				expect(appleValue) == "apple";
			}
		};

		suite.test("Operator==: Equal nodes") = [&] {
			auto node1 = StringMeshNodePtr::make("test");
			auto node2 = node1;
			expect(node1) == node2;
		};

		suite.test("Operator==: Unequal nodes") = [&] {
			auto node1 = StringMeshNodePtr::make("test1");
			auto node2 = StringMeshNodePtr::make("test2");
			expect(node1) != node2;
		};

		suite.test("Operator==: Assigned nodes") = [&] {
			auto node1 = StringMeshNodePtr::make("test1");
			auto node2 = StringMeshNodePtr::make("test2");
			expect(node1) != node2;
			node2 = node1;
			expect(node1) == node2;
		};

		suite.test("Operator==: Node and null") = [&] {
			auto node1 = StringMeshNodePtr::make("test");
			auto node2 = StringMeshNodePtr{};
			expect(node1) != node2;
		};

		suite.test("Detach child") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			auto banana = StringMeshNodePtr::make("banana");
			fruit["Elements"] >> apple;
			fruit["Elements"] >> banana;

			{
				auto fruits = fruit.at("Elements").value();
				expect(std::ranges::size(fruits)) == 2uz;
				{
					auto appleAccessor = fruits[0].value().getValue();
					const auto& value = appleAccessor.value();
					Logger::print("{}", value);
					expect(value) == "apple";
				}
				{
					auto bananaAccessor = fruits[1].value().getValue();
					const auto& value = bananaAccessor.value();
					Logger::print("{}", value);
					expect(value) == "banana";
				}
			}

			{
				fruit["Elements"] - apple;
				auto fruits = fruit.at("Elements").value();
				expect(std::ranges::size(fruits)) == 1uz;
				{
					auto bananaAccessor = fruits[0].value().getValue();
					const auto& bananaValue = bananaAccessor.value();
					Logger::print("{}", bananaValue);
					expect(bananaValue) == "banana";
				}
			}

			{
				fruit["Elements"] - banana;
				auto fruits = fruit.at("Elements").value_or({});
				expect(std::ranges::size(fruits)) == 0uz;
			}
		};

		suite.test("Detach children") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			auto banana = StringMeshNodePtr::make("banana");
			fruit["Elements"] >> apple;
			fruit["Elements"] >> banana;

			expect(std::ranges::size(fruit.at("Elements").value_or({}))) == 2uz;

			fruit["Elements"].clear();
			expect(std::ranges::size(fruit.at("Elements").value_or({}))) == 0uz;
		};

		suite.test("Detach child with multiple links") = [&] {
			auto elements = StringMeshNodePtr::makeRoot("elements");
			auto orange = StringMeshNodePtr::make("orange");

			expect(orange.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();

			elements["Color"] >> orange;
			elements["Fruit"] >> orange;
			{
				expect(elements.count("Color")) == 1uz;
				expect(elements.count("Fruit")) == 1uz;
				expect(orange.getDistanceFromRoot()) == 1uz;
			}

			elements["Color"] - orange;
			{
				expect(elements.count("Color")) == 0uz;
				expect(elements.count("Fruit")) == 1uz;
				expect(std::ranges::size(elements.at("Fruit").value_or({}))) == 1uz;
				expect(orange.getDistanceFromRoot()) == 1uz;
			}

			elements["Fruit"] - orange;
			{
				expect(elements.count("Color")) == 0uz;
				expect(elements.count("Fruit")) == 0uz;
				expect(orange.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
			}
		};

		suite.test("Bidirectional link") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] & apple["Categories"];

			{
				auto elements = fruit.at("Elements").value();
				expect(std::ranges::size(elements)) == 1uz;
				{
					auto appleAccessor = elements[0].value().getValue();
					const auto& value = appleAccessor.value();
					Logger::print("fruit elements contains {}", value);
					expect(value) == "apple";
				}
			}
			{
				auto categories = apple.at("Categories").value();
				expect(std::ranges::size(categories)) == 1uz;
				{
					auto fruitAccessor = categories[0].value().getValue();
					const auto& value = fruitAccessor.value();
					Logger::print("apple category is {}", value);
					expect(value) == "fruit";
				}
			}
		};

		suite.test("Bidirectional link (reverse order)") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			apple["Categories"] & fruit["Elements"];

			{
				auto elements = fruit.at("Elements").value();
				expect(std::ranges::size(elements)) == 1uz;
				{
					auto appleAccessor = elements[0].value().getValue();
					const auto& value = appleAccessor.value();
					Logger::print("fruit elements contains {}", value);
					expect(value) == "apple";
				}
			}
			{
				auto categories = apple.at("Categories").value();
				expect(std::ranges::size(categories)) == 1uz;
				{
					auto fruitAccessor = categories[0].value().getValue();
					const auto& value = fruitAccessor.value();
					Logger::print("apple category is {}", value);
					expect(value) == "fruit";
				}
			}
		};

		suite.test("Duplicate attachment protection (operator>>)") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child = StringMeshNodePtr::make("child");

			root["Branch"] >> child;
			root["Branch"] >> child;

			const auto branch = root.at("Branch").value();
			expect(std::ranges::size(branch)) == 1uz;
		};

		suite.test("Duplicate attachment protection (operator&)") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");

			fruit["Elements"] & apple["Categories"];
			fruit["Elements"] & apple["Categories"];
			apple["Categories"] & fruit["Elements"];

			const auto elements = fruit.at("Elements").value();
			expect(std::ranges::size(elements)) == 1uz;

			const auto categories = apple.at("Categories").value();
			expect(std::ranges::size(categories)) == 1uz;
		};

		suite.test("Many") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto banana = StringMeshNodePtr::make("banana");
			auto orangeFruit = StringMeshNodePtr::make("orange");
			auto lemon = StringMeshNodePtr::make("lemon");

			fruit["Elements"] & banana["Categories"];
			fruit["Elements"] & orangeFruit["Categories"];
			fruit["Elements"] & lemon["Categories"];

			auto color = StringMeshNodePtr::makeRoot("color");
			auto orangeColor = StringMeshNodePtr::make("orange");
			auto yellow = StringMeshNodePtr::make("yellow");

			color["Elements"] & orangeColor["Categories"];
			color["Elements"] & yellow["Categories"];

			banana["Colors"] & yellow["Elements"];
			orangeFruit["Colors"] & orangeColor["Elements"];
			lemon["Colors"] & yellow["Elements"];

			{
				auto fruits = fruit.at("Elements").value();
				expect(std::ranges::size(fruits)) == 3uz;
				for (auto node : fruits)
				{
					expect(std::ranges::size(node.at("Categories").value_or({}))) == 1uz;
					auto categoryAccessor = node["Categories"][0].value().getValue();
					const auto& categoryValue = categoryAccessor.value();
					expect(categoryValue) == "fruit";

					expect(std::ranges::size(node.at("Colors").value_or({}))) == 1uz;
					auto colorAccessor = node["Colors"][0].value().getValue();
					auto fruitAccessor = node.getValue();
					const auto& colorValue = colorAccessor.value();
					const auto& fruitValue = fruitAccessor.value();

					Logger::print("{} is a {} {}", fruitValue, colorValue, categoryValue);
				}
			}
		};

		suite.test("Attach (operator>>)") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] >> apple;

			const auto& elements = fruit.at("Elements").value_or({});
			expect(std::ranges::size(elements)) == 1uz;
			expect(elements[0].value().getValue().value()) == "apple";
		};

		suite.test("Chaining (operator>>)") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child1 = StringMeshNodePtr::make("child1");
			auto child2 = StringMeshNodePtr::make("child2");

			root["Branch1"] >> child1["Branch2"] >> child2;

			const auto& branch1Children = root.at("Branch1").value_or({});
			expect(std::ranges::size(branch1Children)) == 1uz;
			expect(branch1Children[0].value().getValue().value()) == "child1";

			const auto& branch2Children = branch1Children[0].value().at("Branch2").value_or({});
			expect(std::ranges::size(branch2Children)) == 1uz;
			expect(branch2Children[0].value().getValue().value()) == "child2";
		};

		suite.test("Unlink (operator-)") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child = StringMeshNodePtr::make("child");
			root["Branch"] >> child;
			expect(std::ranges::size(root.at("Branch").value_or({}))) == 1uz;

			root["Branch"] - child;
			expect(std::ranges::size(root.at("Branch").value_or({}))) == 0uz;
		};

		suite.test("Bidirectional link (operator&)") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] & apple["Categories"];

			const auto& elements = fruit.at("Elements").value_or({});
			expect(std::ranges::size(elements)) == 1uz;
			expect(elements[0].value().getValue().value()) == "apple";

			const auto& categories = apple.at("Categories").value_or({});
			expect(std::ranges::size(categories)) == 1uz;
			expect(categories[0].value().getValue().value()) == "fruit";
		};

		suite.test("Bidirectional unlink (operator/)") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] & apple["Categories"];

			expect(std::ranges::size(fruit.at("Elements").value_or({}))) == 1uz;
			expect(std::ranges::size(apple.at("Categories").value_or({}))) == 1uz;

			fruit["Elements"] / apple["Categories"];

			expect(std::ranges::size(fruit.at("Elements").value_or({}))) == 0uz;
			expect(std::ranges::size(apple.at("Categories").value_or({}))) == 0uz;
		};

		suite.test("Get value") = [&] {
			auto node = StringMeshNodePtr::make("apple");
			auto accessor = node.getValue();
			expect(accessor.value()) == "apple";
		};

		suite.test("Set value") = [&] {
			auto node = StringMeshNodePtr::make("initial");
			node.setValue("updated");
			auto accessor = node.getValue();
			expect(accessor.value()) == "updated";
		};

		suite.test("Contains") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] >> apple;
			expect(fruit.contains("Elements"));
			fruit["Elements"] - apple;
			expect(not fruit.contains("Elements"));
		};

		suite.test("Count") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child = StringMeshNodePtr::make("child");
			expect(root.count("Branch")) == 0uz;
			root["Branch"] >> child;
			expect(root.count("Branch")) == 1uz;
			root["Branch"] - child;
			expect(root.count("Branch")) == 0uz;
		};

		suite.test("Branch size") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child1 = StringMeshNodePtr::make("child1");
			auto child2 = StringMeshNodePtr::make("child2");
			root["Branch"] >> child1;
			root["Branch"] >> child2;

			expect(std::ranges::size(root.at("Branch").value_or({}))) == 2uz;
		};

		suite.test("Branch stays live after construction") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			{
				auto apple = StringMeshNodePtr::make("apple");
				auto branch = fruit["Elements"];
				branch >> apple;
			}
			{
				const auto branch = fruit["Elements"];
				expect(std::ranges::size(branch)) == 1uz;
				expect(branch.front().value().getValue().value()) == "apple";
			}
		};

		suite.test("Clear branch") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child = StringMeshNodePtr::make("child");
			root["Branch"] >> child;
			expect(std::ranges::size(root.at("Branch").value_or({}))) == 1uz;

			root["Branch"].clear();
			expect(not root.contains("Branch"));
		};

		suite.test("Get node") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] >> apple;

			auto node = fruit["Elements"][0];
			expect(node.has_value());
			expect(node.value().getValue().value()) == "apple";
		};

		suite.test("Get node: Newly created branch") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");

			auto invalidKeyExpected = root["Branch"][0];

			expect(not invalidKeyExpected);
			expect(invalidKeyExpected.error()) == "Branch index out of bounds";
		};

		suite.test("Get node: Invalid index") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] >> apple;

			auto invalidIndexExpected = fruit["Elements"][1];

			expect(not invalidIndexExpected);
			expect(invalidIndexExpected.error()) == "Branch index out of bounds";
		};

		suite.test("Get node: Invalid node") = [&] {
			auto emptyNode = StringMeshNodePtr{};

			expect([&] {
				auto _ = emptyNode["Branch"];
			}) == throws<std::runtime_error>;
		};

		suite.test("Get nodes") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			auto banana = StringMeshNodePtr::make("banana");
			fruit["Elements"] >> apple;
			fruit["Elements"] >> banana;

			auto children = std::vector<StringMeshNodePtr>{};
			for (const auto& node : fruit["Elements"])
				children.push_back(node);

			expect(std::ranges::size(children)) == 2uz;
			expect(children[0].getValue().value()) == "apple";
			expect(children[1].getValue().value()) == "banana";
		};

		suite.test("Get nodes: Non-existent branch") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");

			auto children = std::vector<StringMeshNodePtr>{};
			for (const auto& child : root["NonExistentBranch"])
				children.push_back(child);

			expect(std::ranges::empty(children));
		};

		suite.test("Get nodes: Invalid node") = [&] {
			auto emptyNode = StringMeshNodePtr{};

			expect([&] {
				auto _ = emptyNode["Branch"];
			}) == throws<std::runtime_error>;
		};

		suite.test("at()") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			fruit["Elements"] >> apple;

			const auto branch = fruit.at("Elements");

			expect(branch.has_value());
			expect(std::ranges::size(branch.value())) == 1uz;
			expect(branch.value()[0].value().getValue().value()) == "apple";
		};

		suite.test("at(): Non-existent branch") = [&] {
			const auto root = StringMeshNodePtr::makeRoot("root");
			auto branch = root.at("NonExistentBranch");
			expect(not branch.has_value());
			expect(branch.error()) == "MeshNodePtr::at(): Key not found";
		};

		suite.test("at(): Invalid node") = [&] {
			auto node = StringMeshNodePtr{};
			auto branch = node.at("Branch");
			expect(not branch.has_value());
			expect(branch.error()) == "MeshNodePtr::at(): Invalid MeshNodePtr";
		};

		suite.test("Get first node") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			auto banana = StringMeshNodePtr::make("banana");
			fruit["Elements"] >> apple;
			fruit["Elements"] >> banana;

			auto node = fruit["Elements"].front();
			expect(node.has_value());
			expect(node.value().getValue().value()) == "apple";
		};

		suite.test("Get last node") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			auto apple = StringMeshNodePtr::make("apple");
			auto banana = StringMeshNodePtr::make("banana");
			fruit["Elements"] >> apple;
			fruit["Elements"] >> banana;

			auto node = fruit["Elements"].back();
			expect(node.has_value());
			expect(node.value().getValue().value()) == "banana";
		};

		suite.test("Random access iterator") = [&] {
			auto fruit = StringMeshNodePtr::makeRoot("fruit");
			{
				auto apple = StringMeshNodePtr::make("apple");
				auto banana = StringMeshNodePtr::make("banana");
				auto orange = StringMeshNodePtr::make("orange");
				fruit["Elements"] >> apple;
				fruit["Elements"] >> banana;
				fruit["Elements"] >> orange;
			}

			auto branch = fruit["Elements"];
			auto it = std::ranges::begin(branch);

			expect((*it).getValue().value()) == "apple";
			expect((*(it + 2)).getValue().value()) == "orange";
			expect((it[1]).getValue().value()) == "banana";

			it += 2;
			expect((*it).getValue().value()) == "orange";
			it -= 1;
			expect((*it).getValue().value()) == "banana";

			expect(it) < std::ranges::cend(branch);
			expect(std::ranges::cend(branch) - std::ranges::cbegin(branch)) == 3;
		};

		suite.test("Get branches") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto child1 = StringMeshNodePtr::make("child1");
			auto child2 = StringMeshNodePtr::make("child2");
			auto child3 = StringMeshNodePtr::make("child3");

			root["A"] >> child1;
			root["B"] >> child2;
			root["B"] >> child3;

			auto branchesAccessor = root.getBranches();
			const auto& branches = branchesAccessor.value();

			expect(std::ranges::size(branches)) == 2uz;
			expect(branches.contains("A"));
			expect(branches.contains("B"));

			auto aBranches = branches.at("A")->sharedAccess();
			expect(std::ranges::size(aBranches.value())) == 1uz;

			auto bBranches = branches.at("B")->sharedAccess();
			expect(std::ranges::size(bBranches.value())) == 2uz;
		};

		suite.test("Clear all branches") = [&] {
			auto root = StringMeshNodePtr::makeRoot("root");
			auto childA = StringMeshNodePtr::make("childA");
			auto childB = StringMeshNodePtr::make("childB");

			root["BranchA"] >> childA;
			root["BranchB"] >> childB;

			expect(std::ranges::size(root.getBranches().value())) == 2uz;

			root.clearBranches();

			expect(std::ranges::empty(root.getBranches().value()));
		};
	};
}
