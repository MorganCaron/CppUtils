export module CppUtils.UnitTests.Container.TypedStack;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::TypedStack
{
	auto _ = testSuite("Container/TypedStack").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("Empty Stack") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{};
			expect(std::ranges::empty(stack));
		};

		suite.test("One value") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{42};
			expect(!std::ranges::empty(stack));
			expect(std::ranges::size(stack)) == 1uz;
		};

		suite.test("One type, multiple values") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{1, 2, 3};
			expect(std::ranges::size(stack)) == 3uz;
		};

		suite.test("Multiple types") = [&] {
			auto stack = CppUtils::Container::TypedStack<bool, int, float, std::string_view>{true, 42, 3.14f, "Hello World!"sv};
			expect(std::ranges::size(stack)) == 4uz;

			stack.print();

			Logger::print("{}", stack.get<bool>(0));
			Logger::print("{}", stack.get<int>(1));
			Logger::print("{}", stack.get<float>(2));
			Logger::print("{}", stack.get<std::string_view>(3));
		};

		suite.test("push/top") = [&] {
			auto stack = CppUtils::Container::TypedStack<bool, int, float>{};
			stack.push(true);
			expect(stack.top<bool>());
			stack.push(42);
			expect(stack.top<int>()) == 42;
			stack.push(3.14f);
			expect(stack.top<float>()) == 3.14f;
		};

		suite.test("pushType") = [&] {
			auto stack = CppUtils::Container::TypedStack<bool, int, float>{};
			stack.pushType(1);
			expect(stack.top<int>()) == 0;
		};

		suite.test("get") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{42};
			expect(stack.get<int>(0)) == 42;
		};

		suite.test("pop") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{42};
			expect(stack.pop<int>()) == 42;
			expect(std::ranges::empty(stack));
		};

		suite.test("copy") = [&] {
			auto stack = CppUtils::Container::TypedStack<int>{0, 42};
			stack.copy(1, 0);
			stack.drop();
			expect(stack.get<int>(0)) == 42;
		};

		suite.test("visit") = [&] {
			auto stack = CppUtils::Container::TypedStack<bool, int, float, std::string_view>{true, 42, 3.14f, "Hello World!"sv};

			for (auto i = 0uz; i < std::ranges::size(stack); ++i)
				stack.visit(i, [&](auto&& value) -> void {
					stack.print(i);
					Logger::print("{}", value);
				});

			expect(std::ranges::size(stack)) == 4uz;
		};

		// Todo: tester les autres méthodes
	};
}
