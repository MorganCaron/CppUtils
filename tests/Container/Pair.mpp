export module CppUtils.UnitTests.Container.Pair;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::Pair
{
	auto _ = testSuite("Container/Pair").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("Swap pair") = [&] {
			auto pair = std::make_pair<int, const std::string>(42, "Hello World!");
			auto newPair = CppUtils::Container::swapPair(pair);
			expect(newPair.first) == "Hello World!";
			expect(newPair.second) == 42;
		};
	};
}
