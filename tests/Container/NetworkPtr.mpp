export module CppUtils.UnitTests.Container.NetworkPtr;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::NetworkPtr
{
	auto _ = testSuite("Container/NetworkPtr").dependsOn("Logger", "Thread/UniqueLocker", "Container/SafeShared") = [](TestSuite& suite) {
		using Logger = TestSuite::Logger;
		using LifetimeChecker = CppUtils::UnitTest::LifetimeChecker;
		using NetworkPtr = CppUtils::Container::NetworkPtr<LifetimeChecker>;
		using StringNetworkPtr = CppUtils::Container::NetworkPtr<std::string>;

		auto logger = [](std::string_view message) {
			Logger::print("{}", message);
		};

		suite.test("Create root") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto accessor = root->sharedAccess();
			expect(accessor->getDistanceFromRoot()) == 0uz;
		};

		suite.test("Create node") = [&] {
			auto node = NetworkPtr::make(logger, "Node");
			auto accessor = node->sharedAccess();
			expect(accessor->getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
		};

		suite.test("Read value") = [&] {
			auto node = StringNetworkPtr::make("Node");
			{
				auto accessor = node->sharedAccess();
				expect(accessor->getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
				expect(accessor->value) == "Node";
			}
		};

		suite.test("Write value") = [&] {
			auto node = StringNetworkPtr::make("Node");
			{
				auto accessor = node->uniqueAccess();
				accessor->value = "Changed";
			}
			{
				auto accessor = node->sharedAccess();
				expect(accessor->value) == "Changed";
			}
		};

		suite.test("Create branch") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			{
				auto branch = NetworkPtr::make(logger, "Branch", 1uz);
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
				auto& rootRef = std::get<0>(accessor.values);
				auto& branchRef = std::get<1>(accessor.values);
				expect(branchRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
				rootRef.attachChild(branchRef);
				expect(branchRef.getDistanceFromRoot()) == 1uz;
			}
			Logger::print("Persistance de Branch");
		};

		suite.test("Create leaf") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			{
				auto branch = NetworkPtr::make(logger, "Branch", 1uz);
				{
					auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
					auto& rootRef = std::get<0>(accessor.values);
					auto& branchRef = std::get<1>(accessor.values);
					rootRef.attachChild(branchRef);
					expect(rootRef.getDistanceFromRoot()) == 0uz;
					expect(branchRef.getDistanceFromRoot()) == 1uz;
				}
				{
					auto leaf = NetworkPtr::make(logger, "Leaf", 2uz);
					auto accessor = CppUtils::Thread::MultipleAccessor{*branch, *leaf};
					auto& branchRef = std::get<0>(accessor.values);
					auto& leafRef = std::get<1>(accessor.values);
					branchRef.attachChild(leafRef);
					expect(branchRef.getDistanceFromRoot()) == 1uz;
					expect(leafRef.getDistanceFromRoot()) == 2uz;
				}
				Logger::print("Persistance de Leaf");
			}
			Logger::print("Persistance de Branch");
		};

		suite.test("Cut leaf") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			{
				auto leaf = NetworkPtr::make(logger, "Leaf", 1uz);
				{
					auto accessor = CppUtils::Thread::MultipleAccessor{*root, *leaf};
					auto& rootRef = std::get<0>(accessor.values);
					auto& leafRef = std::get<1>(accessor.values);
					expect(leafRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
					rootRef.attachChild(leafRef);
					expect(leafRef.getDistanceFromRoot()) == 1uz;
				}
				Logger::print("Persistance de Leaf");
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *leaf};
				auto& rootRef = std::get<0>(accessor.values);
				auto& leafRef = std::get<1>(accessor.values);
				expect(leafRef.getDistanceFromRoot()) == 1uz;
				rootRef.detachChild(leafRef);
				expect(leafRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
			}
			Logger::print("Non-persistance de Leaf");
		};

		suite.test("Cut branch with leaf") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			{
				auto branch = NetworkPtr::make(logger, "Branch", 1uz);
				auto leaf = NetworkPtr::make(logger, "Leaf", 2uz);
				{
					auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
					auto& rootRef = std::get<0>(accessor.values);
					auto& branchRef = std::get<1>(accessor.values);
					rootRef.attachChild(branchRef);
				}
				{
					auto accessor = CppUtils::Thread::MultipleAccessor{*branch, *leaf};
					auto& branchRef = std::get<0>(accessor.values);
					auto& leafRef = std::get<1>(accessor.values);
					branchRef.attachChild(leafRef);
				}
				Logger::print("Persistance de Leaf");
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
				auto& rootRef = std::get<0>(accessor.values);
				auto& branchRef = std::get<1>(accessor.values);
				expect(branchRef.getDistanceFromRoot()) == 1uz;
				rootRef.detachChild(branchRef);
				expect(branchRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();

				{
					auto leafAccessor = leaf->sharedAccess();
					expect(leafAccessor->getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
				}
			}
			Logger::print("Non-persistance de Branch");
		};

		suite.test("Bidirectional link") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto branch = CppUtils::Container::SafeShared<NetworkPtr>{};
			{
				branch = NetworkPtr::make(logger, "Branch", 1uz);
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
				auto& rootRef = std::get<0>(accessor.values);
				auto& branchRef = std::get<1>(accessor.values);
				rootRef.attachChild(branchRef);
				expect(rootRef.getDistanceFromRoot()) == 0uz;
				expect(branchRef.getDistanceFromRoot()) == 1uz;
			}
			Logger::print("Persistance de Branch");
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *branch};
				auto& rootRef = std::get<0>(accessor.values);
				auto& branchRef = std::get<1>(accessor.values);
				Logger::print("Création d'une boucle");
				branchRef.attachChild(rootRef);
				expect(rootRef.getDistanceFromRoot()) == 0uz;
				expect(branchRef.getDistanceFromRoot()) == 1uz;
			}
			Logger::print("Libération de la boucle");
		};

		suite.test("Detach child with multiple links") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			{
				auto leaf = NetworkPtr::make(logger, "Leaf", 1uz);
				{
					auto accessor = CppUtils::Thread::MultipleAccessor{*root, *leaf};
					auto& rootRef = std::get<0>(accessor.values);
					auto& leafRef = std::get<1>(accessor.values);
					expect(leafRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();

					rootRef.attachChild(leafRef);
					expect(leafRef.getDistanceFromRoot()) == 1uz;

					rootRef.attachChild(leafRef);
					expect(leafRef.getDistanceFromRoot()) == 1uz;

					rootRef.detachChild(leafRef);
					expect(leafRef.getDistanceFromRoot()) == 1uz;

					rootRef.detachChild(leafRef);
					expect(leafRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
				}
				Logger::print("Non-persistance de Leaf");
			}
			Logger::print("Persistance de Branch");
		};

		suite.test("Attach and detach root on itself") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto accessor = root->uniqueAccess();
			accessor->attachChild(accessor.value());
			expect(accessor->getDistanceFromRoot()) == 0uz;
			accessor->detachChild(accessor.value());
			expect(accessor->getDistanceFromRoot()) == 0uz;
		};

		suite.test("Attach and detach node on itself") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto node = NetworkPtr::make(logger, "Node", 1uz);
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *node};
				auto& rootRef = std::get<0>(accessor.values);
				auto& nodeRef = std::get<1>(accessor.values);
				rootRef.attachChild(nodeRef);
				expect(nodeRef.getDistanceFromRoot()) == 1uz;
			}
			{
				auto accessor = node->uniqueAccess();
				accessor->attachChild(accessor.value());
				expect(accessor->getDistanceFromRoot()) == 1uz;
				accessor->detachChild(accessor.value());
				expect(accessor->getDistanceFromRoot()) == 1uz;
			}
			{
				auto accessor = CppUtils::Thread::MultipleAccessor{*root, *node};
				auto& rootRef = std::get<0>(accessor.values);
				auto& nodeRef = std::get<1>(accessor.values);
				rootRef.detachChild(nodeRef);
				expect(nodeRef.getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
			}
		};

		suite.test("Unidirectional link (operator>>)") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto child = NetworkPtr::make(logger, "Child", 1uz);

			root >> child;

			auto childAccessor = child->sharedAccess();
			expect(childAccessor->getDistanceFromRoot()) == 1uz;
		};

		suite.test("Unidirectional link chaining (operator>>)") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto branch = NetworkPtr::make(logger, "Branch", 1uz);
			auto leaf = NetworkPtr::make(logger, "Leaf", 2uz);

			root >> branch >> leaf;

			{
				auto branchAccessor = branch->sharedAccess();
				expect(branchAccessor->getDistanceFromRoot()) == 1uz;
			}
			{
				auto leafAccessor = leaf->sharedAccess();
				expect(leafAccessor->getDistanceFromRoot()) == 2uz;
			}
		};

		suite.test("Unlink (operator-)") = [&] {
			auto root = NetworkPtr::makeRoot(logger, "Root");
			auto child = NetworkPtr::make(logger, "Child");
			root >> child;
			{
				auto childAccessor = child->sharedAccess();
				expect(childAccessor->getDistanceFromRoot()) == 1uz;
			}

			root - child;

			auto childAccessor = child->sharedAccess();
			expect(childAccessor->getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
		};

		suite.test("Bidirectional link (operator&)") = [&] {
			auto node1 = NetworkPtr::makeRoot(logger, "Node1");
			auto node2 = NetworkPtr::make(logger, "Node2");

			node1 & node2;

			auto node1Accessor = node1->sharedAccess();
			auto node2Accessor = node2->sharedAccess();
			expect(node1Accessor->getDistanceFromRoot()) == 0uz;
			expect(node2Accessor->getDistanceFromRoot()) == 1uz;
		};

		suite.test("Bidirectional unlink (operator/)") = [&] {
			auto node1 = NetworkPtr::makeRoot(logger, "Node1");
			auto node2 = NetworkPtr::make(logger, "Node2");
			node1 & node2;

			node1 / node2;

			auto node2Accessor = node2->sharedAccess();
			expect(node2Accessor->getDistanceFromRoot()) == std::numeric_limits<std::size_t>::max();
		};
	};
}
