export module CppUtils.UnitTests.Container.Stack;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::Stack
{
	auto _ = testSuite("Container/Stack").dependsOn("Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("Empty Stack") = [&] {
			auto stack = CppUtils::Container::Stack{};
			expect(std::ranges::empty(stack));
		};

		suite.test("Push one value") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(42);
			expect(not std::ranges::empty(stack));
			expect(std::ranges::size(stack)) == sizeof(int);
		};

		suite.test("Pop") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(42);
			{
				auto result = stack.pop<int>();
				expect(result);
				expect(result.value()) == 42;
			}
			expect(std::ranges::empty(stack));
			{
				auto result = stack.pop<int>();
				expect(not result);
			}
		};

		suite.test("One type, multiple values") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(1);
			stack.push(2);
			stack.push(3);
			expect(std::ranges::size(stack)) == sizeof(int) * 3;
		};

		suite.test("Multiple types") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(true);
			stack.push(42);
			stack.push(3.14f);
			stack.push("Hello World!"sv);
			expect(std::ranges::size(stack)) == sizeof(bool) + sizeof(int) + sizeof(float) + sizeof(std::string_view);

			stack.dump();

			{
				auto result = stack.get<bool>(sizeof(int) + sizeof(float) + sizeof(std::string_view));
				expect(result);
				Logger::print("{}", result.value());
			}
			{
				auto result = stack.get<int>(sizeof(float) + sizeof(std::string_view));
				expect(result);
				Logger::print("{}", result.value());
			}
			{
				auto result = stack.get<float>(sizeof(std::string_view));
				expect(result);
				Logger::print("{}", result.value());
			}
			{
				auto result = stack.get<std::string_view>();
				expect(result);
				Logger::print("{}", result.value());
			}
		};

		suite.test("Call function: () -> std::size_t") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(0uz);
			auto getNumber = []() -> std::size_t {
				return 42uz;
			};
			expect(stack.call(+getNumber));
			{
				auto result = stack.pop<std::size_t>();
				expect(result);
				expect(result.value()) == 42uz;
			}
			expect(std::ranges::empty(stack));
		};

		suite.test("Call function: (std::size_t) -> void") = [&] {
			auto stack = CppUtils::Container::Stack{};
			auto print = [](std::size_t nb) -> void {
				std::println("{}", nb);
			};
			stack.push(42uz);
			expect(stack.call(print));
		};

		suite.test("Call function: (std::size_t, std::size_t) -> std::size_t") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(0uz);
			stack.push(30uz);
			stack.push(12uz);
			auto add = [](std::size_t lhs, std::size_t rhs) -> std::size_t {
				return lhs + rhs;
			};
			expect(stack.call(add));
			expect(stack.drop(sizeof(std::size_t) * 2));
			{
				auto result = stack.pop<std::size_t>();
				expect(result);
				expect(result.value()) == 42uz;
			}
			expect(std::ranges::empty(stack));
		};

		suite.test("Call functions") = [&] {
			auto stack = CppUtils::Container::Stack{};
			stack.push(0uz);
			stack.push(30uz);
			stack.push(12uz);
			auto add = [](std::size_t lhs, std::size_t rhs) -> std::size_t {
				return lhs + rhs;
			};
			auto print = [](std::size_t nb) -> void {
				std::println("{}", nb);
			};
			expect(stack.call(add));
			expect(stack.drop(sizeof(std::size_t) * 2));
			{
				auto result = stack.get<std::size_t>();
				expect(result);
				expect(result.value()) == 42uz;
			}
			expect(stack.call(print));
			expect(stack.drop(sizeof(std::size_t)));
			expect(std::ranges::empty(stack));
		};
	};
}
