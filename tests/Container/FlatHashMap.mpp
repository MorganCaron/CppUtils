export module CppUtils.UnitTests.Container.FlatHashMap;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::FlatHashMap
{
	auto _ = testSuite("Container/FlatHashMap").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace String::Literals;

		suite.test<[] {
			auto map = CppUtils::Container::FlatHashMap<int, int>{};
			map[1] = 100;
			map[2] = 200;
			map[3] = 300;
			if (std::ranges::size(map) != 3uz)
				return false;
			if (map.at(1) != 100)
				return false;
			if (not map.contains(2))
				return false;
			if (map.contains(4))
				return false;
			map.erase(2);
			if (map.contains(2))
				return false;
			return std::ranges::size(map) == 2uz;
		}>("Constexpr operator[] and erase");

		suite.test<[] {
			auto map = CppUtils::Container::FlatHashMap<int, int>{};
			auto [iteratorFirst, insertedFirst] = map.try_emplace(1, 10);
			if (not insertedFirst or iteratorFirst->second != 10)
				return false;

			auto [iteratorSecond, insertedSecond] = map.try_emplace(1, 99);
			if (insertedSecond or iteratorSecond->second != 10)
				return false;

			auto [iteratorThird, assignedFirst] = map.insert_or_assign(1, 50);
			if (assignedFirst or iteratorThird->second != 50)
				return false;

			auto [iteratorFourth, assignedSecond] = map.insert_or_assign(2, 60);
			if (not assignedSecond or iteratorFourth->second != 60)
				return false;

			return std::ranges::size(map) == 2uz;
		}>("Constexpr emplace and assign");

		suite.test<[] {
			auto map = CppUtils::Container::FlatHashMap<int, int>{{1, 10}, {2, 20}, {3, 30}};
			auto sum = 0;
			for (const auto& [key, value] : map)
				sum += key + value;
			return sum == (1 + 10 + 2 + 20 + 3 + 30);
		}>("Constexpr initializer list and iteration");

		suite.test<[] {
			using namespace String::Literals;

			auto tokenMap = CppUtils::Container::FlatHashMap<Type::Token, int>{};
			tokenMap["foo"_token] = 42;
			tokenMap["bar"_token] = 84;
			if (tokenMap["foo"_token] != 42 or tokenMap["bar"_token] != 84)
				return false;
			if (not tokenMap.contains("foo"_token))
				return false;
			tokenMap.erase("foo"_token);
			if (tokenMap.contains("foo"_token))
				return false;

			return true;
		}>("Constexpr token keys");

		suite.test("Basic insertion and lookup") = [&] {
			auto map = CppUtils::Container::FlatHashMap<std::string, int>{};
			expect(std::ranges::empty(map));
			expect(std::ranges::size(map)) == 0uz;

			map["alpha"] = 1;
			map["beta"] = 2;
			map["gamma"] = 3;

			expect(not std::ranges::empty(map));
			expect(std::ranges::size(map)) == 3uz;
			expect(map.contains("alpha"));
			expect(map.contains("beta"));
			expect(map.contains("gamma"));
			expect(not map.contains("delta"));

			expect(map.at("alpha")) == 1;
			expect(map.at("beta")) == 2;
			expect(map.at("gamma")) == 3;
		};

		suite.test("Operator[] modification and insertion") = [&] {
			auto map = CppUtils::Container::FlatHashMap<int, std::string>{};
			map[10] = "ten";
			expect(map[10]) == "ten";
			map[10] = "dix";
			expect(map[10]) == "dix";
			expect(std::ranges::size(map)) == 1uz;
		};

		suite.test("Erase and tombstone reuse") = [&] {
			auto map = CppUtils::Container::FlatHashMap<std::size_t, std::size_t>{};
			for (auto index = 0uz; index < 20uz; ++index)
				map[index] = index * 10uz;

			expect(std::ranges::size(map)) == 20uz;

			for (auto index = 0uz; index < 10uz; ++index)
				expect(map.erase(index)) == 1uz;

			expect(std::ranges::size(map)) == 10uz;

			for (auto index = 0uz; index < 10uz; ++index)
				expect(not map.contains(index));

			for (auto index = 10uz; index < 20uz; ++index)
				expect(map.contains(index));

			for (auto index = 0uz; index < 10uz; ++index)
				map[index] = index * 100uz;

			expect(std::ranges::size(map)) == 20uz;
			for (auto index = 0uz; index < 10uz; ++index)
				expect(map.at(index)) == index * 100;
		};

		suite.test("Growth and rehash") = [&] {
			auto map = CppUtils::Container::FlatHashMap<std::size_t, std::size_t>{};
			constexpr auto count = 1000uz;
			for (auto index = 0uz; index < count; ++index)
				map[index] = index * 2uz;

			expect(std::ranges::size(map)) == count;
			for (auto index = 0uz; index < count; ++index)
				expect(map.at(index)) == index * 2;
		};

		suite.test("Range-based for iteration") = [&] {
			auto map = CppUtils::Container::FlatHashMap<int, int>{};
			map[1] = 10;
			map[2] = 20;
			map[3] = 30;

			auto keySum = 0;
			auto valueSum = 0;
			for (const auto& [key, value] : map)
			{
				keySum += key;
				valueSum += value;
			}
			expect(keySum) == 6;
			expect(valueSum) == 60;
		};

		suite.test("Token keys") = [&] {
			auto map = CppUtils::Container::FlatHashMap<Type::Token, std::string>{};
			map["first"_token] = "one";
			map["second"_token] = "two";
			map["third"_token] = "three";

			expect(map.contains("first"_token));
			expect(map.contains("second"_token));
			expect(map.contains("third"_token));
			expect(not map.contains("fourth"_token));

			expect(map["first"_token]) == "one";
			expect(map["second"_token]) == "two";
			expect(map["third"_token]) == "three";
		};

		suite.test("Equality operator") = [&] {
			auto map1 = CppUtils::Container::FlatHashMap<int, int>{{1, 10}, {2, 20}};
			auto map2 = CppUtils::Container::FlatHashMap<int, int>{{2, 20}, {1, 10}};
			auto map3 = CppUtils::Container::FlatHashMap<int, int>{{1, 10}, {2, 25}};

			expect(map1) == map2;
			expect(not(map1 == map3));
		};

		suite.test("Runtime performance benchmark vs std::unordered_map") = [] {
			constexpr auto elementCount = 50'000uz;

			auto flatMap = CppUtils::Container::FlatHashMap<std::size_t, std::size_t>{};
			auto unorderedMap = std::unordered_map<std::size_t, std::size_t>{};

			const auto flatInsert = benchmark("FlatHashMap insert", [&] {
				for (auto index = 0uz; index < elementCount; ++index)
					flatMap[index] = index * 2uz;
			});

			const auto unorderedInsert = benchmark("std::unordered_map insert", [&] {
				for (auto index = 0uz; index < elementCount; ++index)
					unorderedMap[index] = index * 2uz;
			});

			auto flatReadSum = 0uz;
			const auto flatRead = benchmark("FlatHashMap read", [&] {
				for (auto index = 0uz; index < elementCount; ++index)
					flatReadSum += flatMap.at(index);
			});

			auto unorderedReadSum = 0uz;
			const auto unorderedRead = benchmark("std::unordered_map read", [&] {
				for (auto index = 0uz; index < elementCount; ++index)
					unorderedReadSum += unorderedMap.at(index);
			});

			expect(flatReadSum) == unorderedReadSum;
			expect(std::ranges::size(flatMap)) == std::ranges::size(unorderedMap);

			compareBenchmarks(flatInsert, unorderedInsert);
			compareBenchmarks(flatRead, unorderedRead);

			warnIfSlower(flatInsert, unorderedInsert);
			warnIfSlower(flatRead, unorderedRead);
		};

		suite.test("Differential fuzzing vs std::unordered_map") = [] {
			auto flatMap = CppUtils::Container::FlatHashMap<int, int>{};
			auto referenceMap = std::unordered_map<int, int>{};

			fuzz("Random operations on FlatHashMap", 2'000uz, [&](auto& fuzzer) {
				const auto operation = fuzzer.random(0uz, 2uz);
				const auto key = fuzzer.random(-100, 100);
				const auto randomValue = fuzzer.random(-1'000, 1'000);

				switch (operation)
				{
				case 0:
					flatMap[key] = randomValue;
					referenceMap[key] = randomValue;
					break;
				case 1:
					flatMap.erase(key);
					referenceMap.erase(key);
					break;
				case 2:
					expect(flatMap.contains(key)) == referenceMap.contains(key);
					if (referenceMap.contains(key))
						expect(flatMap.at(key)) == referenceMap.at(key);
					break;
				}

				expect(std::ranges::size(flatMap)) == std::ranges::size(referenceMap);
			});
		};
	};
}
