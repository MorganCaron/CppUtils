export module CppUtils.UnitTests.Container.Sequence;

import std;
import CppUtils;

namespace
{
	[[nodiscard]] auto generateDifferenceVector(std::string_view string) -> std::vector<CppUtils::Container::Sequence::Difference>
	{
		auto result = std::vector<CppUtils::Container::Sequence::Difference>{};
		result.reserve(std::ranges::size(string));
		for (const auto c : string)
		{
			switch (c)
			{
			case ' ': result.emplace_back(CppUtils::Container::Sequence::Difference::None); break;
			case '+': result.emplace_back(CppUtils::Container::Sequence::Difference::Added); break;
			case '-': result.emplace_back(CppUtils::Container::Sequence::Difference::Removed); break;
			case '*': result.emplace_back(CppUtils::Container::Sequence::Difference::Edited); break;
			default: throw std::runtime_error{"generateDifferenceVector(): Unknown character."};
			}
		}
		return result;
	}
}

namespace CppUtils::UnitTest::Container::Sequence
{
	auto _ = testSuite("Container/Sequence").dependsOn("UnitTest") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("string") = [] {
			const auto s0 = "azTESTerABCtyui99o9p"sv;
			const auto s1 = "000azWXYZerty123uiopHELLO"sv;
			const auto differences = generateDifferenceVector("+++  ----++++  ---  +++  -- - +++++"sv);
			const auto result = CppUtils::Container::Sequence::getDifferences(s0, s1);
			expect(result) == differences;
		};

		suite.test("vector") = [] {
			const auto s0 = "azTESTerABCtyui99o9p"sv;
			const auto s1 = "000azWXYZerty123uiopHELLO"sv;
			const auto vec0 = std::vector<char>{std::ranges::begin(s0), std::ranges::end(s0)};
			const auto vec1 = std::vector<char>{std::ranges::begin(s1), std::ranges::end(s1)};
			const auto differences = generateDifferenceVector("+++  ----++++  ---  +++  -- - +++++"sv);
			const auto result = CppUtils::Container::Sequence::getDifferences(vec0, vec1);
			expect(result) == differences;
		};

		suite.test("mixed range types") = [] {
			const auto s0 = "azTESTerABCtyui99o9p"sv;
			const auto s1 = "000azWXYZerty123uiopHELLO"sv;
			const auto vec1 = std::vector<char>{std::ranges::begin(s1), std::ranges::end(s1)};
			const auto differences = generateDifferenceVector("+++  ----++++  ---  +++  -- - +++++"sv);
			const auto result = CppUtils::Container::Sequence::getDifferences(s0, vec1);
			expect(result) == differences;
		};

		suite.test("custom comparator and projection") = [] {
			const auto left = std::vector<int>{1, -2, 3};
			const auto right = std::vector<int>{1, 2, 4};
			const auto result = CppUtils::Container::Sequence::getDifferences(
				left,
				right,
				std::ranges::equal_to{},
				[](int x) { return std::abs(x); },
				[](int x) { return std::abs(x); });
			expect(std::ranges::size(result)) == 4uz;
		};
	};
}
