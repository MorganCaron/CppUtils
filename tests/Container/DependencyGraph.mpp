export module CppUtils.UnitTests.Container.DependencyGraph;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Container::DependencyGraph
{
	auto _ = testSuite("Container/DependencyGraph").dependsOn("UnitTest", "Logger") = [](TestSuite& suite) {
		using namespace std::literals;
		using Logger = TestSuite::Logger;

		suite.test("Empty graph") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};

			expect(not graph.hasCycle());
		};

		suite.test("One element") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);

			expect(graph.contains('A'));
			expect(graph['A']) == 1;
		};

		suite.test("Remove element") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.remove('A');

			expect(not graph.contains('A'));
		};

		suite.test("Remove element with dependencies") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.addDependency('A', 'B');
			graph.addDependency('B', 'A');
			graph.remove('B');

			expect(not graph.contains('B'));
			expect(graph.contains('A'));
			const auto& aDeps = graph.getDependencies('A');
			expect(std::ranges::empty(aDeps));
		};

		suite.test("Change value") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph['A'] = 2;

			expect(graph['A']) == 2;
		};

		suite.test("Add dependency") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.addDependency('A', 'B');

			const auto& aDeps = graph.getDependencies('A');
			const auto& bDeps = graph.getDependencies('B');

			expect(std::ranges::size(aDeps)) == 1uz;
			expect(aDeps[0]) == 'B';
			expect(std::ranges::empty(bDeps));

			expect(not graph.hasCycle());
		};

		suite.test("Remove dependency") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.addDependency('A', 'B');
			graph.removeDependency('A', 'B');

			const auto& aDeps = graph.getDependencies('A');
			const auto& bDeps = graph.getDependencies('B');

			expect(std::ranges::empty(aDeps));
			expect(std::ranges::empty(bDeps));

			expect(not graph.hasCycle());
		};

		suite.test("Circular dependency (direct)") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.addDependency('A', 'B');
			graph.addDependency('B', 'A');

			const auto& aDeps = graph.getDependencies('A');
			const auto& bDeps = graph.getDependencies('B');

			expect(std::ranges::size(aDeps)) == 1uz;
			expect(std::ranges::size(bDeps)) == 1uz;
			expect(aDeps[0]) == 'B';
			expect(bDeps[0]) == 'A';

			expect(graph.hasCycle());
		};

		suite.test("Circular dependency (indirect)") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.insert('C', 3);
			graph.insert('D', 4);
			graph.addDependency('A', 'B');
			graph.addDependency('B', 'C');
			graph.addDependency('C', 'D');
			graph.addDependency('D', 'B');

			const auto& aDeps = graph.getDependencies('A');
			const auto& bDeps = graph.getDependencies('B');
			const auto& cDeps = graph.getDependencies('C');
			const auto& dDeps = graph.getDependencies('D');

			expect(std::ranges::size(aDeps)) == 1uz;
			expect(std::ranges::size(bDeps)) == 1uz;
			expect(std::ranges::size(cDeps)) == 1uz;
			expect(std::ranges::size(dDeps)) == 1uz;
			expect(aDeps[0]) == 'B';
			expect(bDeps[0]) == 'C';
			expect(cDeps[0]) == 'D';
			expect(dDeps[0]) == 'B';

			expect(graph.hasCycle());
		};

		suite.test("ForEach (without circular dependencies)") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.insert('C', 3);
			graph.addDependency('A', 'B');
			graph.addDependency('A', 'C');
			graph.addDependency('B', 'C');

			expect(not graph.hasCycle());

			expect(graph.forEach([](const auto& key, const auto& value, [[maybe_unused]] const auto& dependencies) -> void {
				Logger::print("{}: {}", key, value);
			}).has_value());
		};

		suite.test("ForEach (with circular dependencies)") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.insert('C', 3);
			graph.insert('D', 4);
			graph.addDependency('A', 'B');
			graph.addDependency('B', 'C');
			graph.addDependency('C', 'D');
			graph.addDependency('D', 'B');

			expect(graph.hasCycle());

			auto result = graph.forEach([](const auto& key, const auto& value, [[maybe_unused]] const auto& dependencies) -> void {
				Logger::print("{}: {}", key, value);
			});
			expect(not result);
			Logger::print("Error: {}", result.error());
		};

		suite.test("ForEach (interruption)") = [&] {
			auto graph = CppUtils::Container::DependencyGraph<char, int>{};
			graph.insert('A', 1);
			graph.insert('B', 2);
			graph.addDependency('A', 'B');

			auto count = 0uz;
			auto result = graph.forEach([&count](const auto& key, const auto& value, [[maybe_unused]] const auto& dependencies) -> bool {
				Logger::print("{}: {}", key, value);
				++count;
				return false;
			});

			expect(result);
			expect(not *result);
			expect(count) == 1uz;
		};
	};
}
