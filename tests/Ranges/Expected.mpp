export module CppUtils.UnitTests.Ranges.Expected;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Ranges::Expected
{
	auto _ = testSuite("Ranges/Expected") = [](TestSuite& suite) {
		using namespace std::literals;
		using Expected = std::expected<int, std::string>;

		suite.test("filterValues") = [&] {
			const auto inputs = std::array<Expected, 5>{
				10,
				std::unexpected{"error 1"s},
				20,
				std::unexpected{"error 2"s},
				30};

			const auto values = inputs
				| CppUtils::Ranges::filterValues()
				| std::ranges::to<std::vector<int>>();

			expect(std::ranges::size(values)) == 3uz;
			expect(values[0]) == 10;
			expect(values[1]) == 20;
			expect(values[2]) == 30;
		};

		suite.test("filterErrors") = [&] {
			const auto inputs = std::array<Expected, 5>{
				10,
				std::unexpected{"error 1"s},
				20,
				std::unexpected{"error 2"s},
				30};

			const auto errors = inputs
				| CppUtils::Ranges::filterErrors()
				| std::ranges::to<std::vector<std::string>>();

			expect(std::ranges::size(errors)) == 2uz;
			expect(errors[0]) == "error 1"s;
			expect(errors[1]) == "error 2"s;
		};

		suite.test("valueOr") = [&] {
			const auto inputs = std::array<Expected, 3>{
				10,
				std::unexpected{"error"s},
				30};

			const auto values = inputs
				| CppUtils::Ranges::valueOr(-1)
				| std::ranges::to<std::vector<int>>();

			expect(std::ranges::size(values)) == 3uz;
			expect(values[0]) == 10;
			expect(values[1]) == -1;
			expect(values[2]) == 30;
		};

		suite.test("recover") = [&] {
			const auto inputs = std::array<Expected, 3>{
				10,
				std::unexpected{"42"s},
				30};

			const auto values = inputs
				| CppUtils::Ranges::recover([](const std::string& error) {
				return std::stoi(error);
			})
				| std::ranges::to<std::vector<int>>();

			expect(std::ranges::size(values)) == 3uz;
			expect(values[0]) == 10;
			expect(values[1]) == 42;
			expect(values[2]) == 30;
		};

		suite.test("inspectError") = [&] {
			const auto inputs = std::array<Expected, 3>{
				10,
				std::unexpected{"error"s},
				30};

			auto capturedErrors = std::vector<std::string>{};

			auto count = 0uz;
			for ([[maybe_unused]] const auto& item : inputs | CppUtils::Ranges::inspectError([&](const std::string& error) {
				capturedErrors.push_back(error);
			}))
				++count;

			expect(count) == 3uz;
			expect(std::ranges::size(capturedErrors)) == 1uz;
			expect(capturedErrors[0]) == "error";
		};

		suite.test("routeErrors") = [&] {
			const auto inputs = std::array<Expected, 5>{
				10,
				std::unexpected{"error 1"s},
				20,
				std::unexpected{"error 2"s},
				30};

			auto capturedErrors = std::vector<std::string>{};

			const auto values = inputs
				| CppUtils::Ranges::routeErrors([&](const std::string& error) {
				capturedErrors.push_back(error);
			})
				| std::ranges::to<std::vector<int>>();

			expect(std::ranges::size(values)) == 3uz;
			expect(values[0]) == 10;
			expect(values[1]) == 20;
			expect(values[2]) == 30;

			expect(std::ranges::size(capturedErrors)) == 2uz;
			expect(capturedErrors[0]) == "error 1";
			expect(capturedErrors[1]) == "error 2";
		};
	};
}
