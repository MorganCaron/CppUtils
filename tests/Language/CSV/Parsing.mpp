export module CppUtils.UnitTests.Language.CSV.Parsing;

import CppUtils;

namespace CppUtils::UnitTest::Language::CSV::Parsing
{
	auto _ = testSuite("Language/CSV/Parsing") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::Language::CSV::Literals;

		suite.test("_csv literal") = [&] {
			const auto csv = "a;b\nc;d"_csv;

			expect(std::ranges::size(csv)) == 2uz;
			expect(csv[0]) == std::vector<std::string_view>{"a", "b"};
			expect(csv[1]) == std::vector<std::string_view>{"c", "d"};
		};

		suite.test("parseCSV with multiple lines and spaces") = [&] {
			const auto csv = CppUtils::Language::CSV::parseCSV(R"(
			header1 ; header2 
			value1 ; value2
		)");

			expect(std::ranges::size(csv)) == 2uz;
			expect(csv[0]) == std::vector<std::string_view>{"header1", "header2"};
			expect(csv[1]) == std::vector<std::string_view>{"value1", "value2"};
		};

		suite.test("splitLine") = [&] {
			const auto values = CppUtils::Language::CSV::splitLine(" foo ; bar ");

			expect(std::ranges::size(values)) == 2uz;
			expect(values[0]) == "foo";
			expect(values[1]) == "bar";
		};
	};
}
