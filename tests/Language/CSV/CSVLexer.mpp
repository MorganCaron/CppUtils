export module CppUtils.UnitTests.Language.CSV.CSVLexer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::CSV::CSVLexer
{
	auto _ = testSuite("Language/CSV/CSVLexer") = [](TestSuite& suite) {
		using namespace CppUtils::String::Literals;
		using namespace CppUtils::Language::CSV::Literals;

		suite.test("Empty CSV") = [&] {
			const auto tree = ""_csv_tree;
			expect(std::ranges::empty(tree.nodes));
		};

		suite.test("Simple rows and columns") = [&] {
			const auto tree = R"(a;b
c;d)"_csv_tree;

			expect(std::ranges::size(tree.nodes)) == 2uz;
			const auto& row0 = tree.nodes.at(0);
			const auto& row1 = tree.nodes.at(1);
			expect(std::get<Type::Token>(row0.value)) == "record"_token;
			expect(std::get<Type::Token>(row1.value)) == "record"_token;

			expect(std::ranges::size(row0.nodes)) == 2uz;
			expect(std::ranges::size(row1.nodes)) == 2uz;

			expect(std::get<std::string>(row0.nodes.at(0).nodes.at(0).value)) == "a";
			expect(std::get<std::string>(row0.nodes.at(1).nodes.at(0).value)) == "b";
			expect(std::get<std::string>(row1.nodes.at(0).nodes.at(0).value)) == "c";
			expect(std::get<std::string>(row1.nodes.at(1).nodes.at(0).value)) == "d";
		};

		suite.test("Quoted field with delimiter") = [&] {
			const auto tree = R"("a;b";c)"_csv_tree;

			expect(std::ranges::size(tree.nodes)) == 1uz;
			const auto& row = tree.nodes.front();
			expect(std::ranges::size(row.nodes)) == 2uz;
			expect(std::get<std::string>(row.nodes.at(0).nodes.at(0).value)) == "a;b";
			expect(std::get<std::string>(row.nodes.at(1).nodes.at(0).value)) == "c";
		};

		suite.test("Quoted field with escaped quote") = [&] {
			const auto tree = R"("foo""bar";baz)"_csv_tree;

			expect(std::ranges::size(tree.nodes)) == 1uz;
			const auto& row = tree.nodes.front();
			expect(std::ranges::size(row.nodes)) == 2uz;
			expect(std::get<std::string>(row.nodes.at(0).nodes.at(0).value)) == R"(foo"bar)";
			expect(std::get<std::string>(row.nodes.at(1).nodes.at(0).value)) == "baz";
		};

		suite.test("Quoted field with multiline newline") = [&] {
			const auto tree = "\"line1\nline2\";value"_csv_tree;

			expect(std::ranges::size(tree.nodes)) == 1uz;
			const auto& row = tree.nodes.front();
			expect(std::ranges::size(row.nodes)) == 2uz;
			expect(std::get<std::string>(row.nodes.at(0).nodes.at(0).value)) == "line1\nline2";
			expect(std::get<std::string>(row.nodes.at(1).nodes.at(0).value)) == "value";
		};

		suite.test("toTable method") = [&] {
			const auto lexer = CppUtils::Language::CSV::CSVLexer{';'};
			const auto table = lexer.toTable(R"(header1;header2
value1;value2)");

			expect(std::ranges::size(table)) == 2uz;
			expect(table[0]) == std::vector<std::string>{"header1", "header2"};
			expect(table[1]) == std::vector<std::string>{"value1", "value2"};
		};

		suite.test("Custom delimiter comma") = [&] {
			const auto table = CppUtils::Language::CSV::parseTable(R"(name,age,"city, country"
Alice,30,"Paris, France")",
				',');

			expect(std::ranges::size(table)) == 2uz;
			expect(table[0]) == std::vector<std::string>{"name", "age", "city, country"};
			expect(table[1]) == std::vector<std::string>{"Alice", "30", "Paris, France"};
		};
	};
}
