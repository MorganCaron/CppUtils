export module CppUtils.UnitTests.Language.ASTParser;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::ASTParser
{
	constexpr auto addStack = [](CppUtils::Language::ASTParser& interpreter) {
		using namespace CppUtils::String::Literals;
		using ASTNode = CppUtils::Language::ASTNode;

		auto& mainNode = interpreter.rootAst["main"_token];
		// clang-format off
		mainNode.nodes.insert(std::ranges::begin(mainNode.nodes), {
			ASTNode{"call"_token, {ASTNode{"new"_token, {ASTNode{"stack"_token}}}}},
			ASTNode{"call"_token, {ASTNode{"enterInLast"_token}}}
		});
		// clang-format on
	};
	auto _ = testSuite("Language/ASTParser").dependsOn("Logger", "Container/Tree", "Language/MetaCircularVirtualMachine") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::String::Literals;
		using Logger = TestSuite::Logger;

		suite.test<[] {
			using namespace std::literals;
			using namespace CppUtils::String::Literals;

			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = "token"sv;
			auto cursor = CppUtils::String::Cursor{source};
			auto result = interpreter(cursor);
			if (not result)
				return false;
			const auto& scopeNodes = interpreter.getScope().nodes;
			return std::ranges::size(scopeNodes) == 1uz and scopeNodes.front().value == "token"_token;
		}>("Constexpr token parsing");

		suite.test("Empty source") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = ""sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			expect(std::ranges::empty(interpreter.getScope().nodes));
		};

		suite.test("Whitespaces") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = R"(

			)"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			expect(std::ranges::empty(interpreter.getScope().nodes));
		};

		suite.test("Parse token") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = "token"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 1uz;
			expect(scopeNodes.front().value) == "token"_token;
			expect(std::ranges::size(scopeNodes.front().nodes)) == 0uz;
		};

		suite.test("Empty node") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = "parent{}"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 1uz;
			expect(scopeNodes.front().value) == "parent"_token;
			expect(std::ranges::size(scopeNodes.front().nodes)) == 0uz;
		};

		suite.test("Escaped char") = [&] {
			// Todo
			[[maybe_unused]] constexpr auto source = R"(Hello\ World{})"sv;
		};

		suite.test("Parse value") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = R"(
				'a'
			)"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 1uz;
			expect(scopeNodes.front().value) == static_cast<Type::Token>('a');
		};

		suite.test("Nested nodes") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = R"(
				parent {
					child1
					child2
				}
			)"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 1uz;
			expect(scopeNodes.front().value) == "parent"_token;
			expect(std::ranges::size(scopeNodes.front().nodes)) == 2uz;
			expect(scopeNodes.front().nodes.at(0).value) == "child1"_token;
			expect(scopeNodes.front().nodes.at(1).value) == "child2"_token;
		};

		suite.test("Run function") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = R"(
				run {
					call{new{createNode}}
				}
			)"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 2uz;
			expect(scopeNodes.at(0).value) == "run"_token;
			expect(scopeNodes.at(1).value) == "createNode"_token;
		};

		suite.test("Run temporary function") = [&] {
			auto interpreter = CppUtils::Language::ASTParser{};
			addStack(interpreter);
			constexpr auto source = R"(
				run {
					call{new{createNode}}
					call{delete{run}}
				}
			)"sv;
			auto cursor = CppUtils::String::Cursor{source};

			auto result = interpreter(cursor);
			if (not result)
				Logger::print<"error">("Error: {}\nPosition: {}\nChar: '{}'", result.error(), cursor.position, cursor.getCurrent());

			expect(result);
			Logger::print("{}", interpreter.getScope());
			const auto& scopeNodes = interpreter.getScope().nodes;
			expect(std::ranges::size(scopeNodes)) == 1uz;
			expect(scopeNodes.front().value) == "createNode"_token;
		};
	};
}
