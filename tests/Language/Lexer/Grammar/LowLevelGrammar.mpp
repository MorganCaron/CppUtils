export module CppUtils.UnitTests.Language.Lexer.Grammar.LowLevelGrammar;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::Lexer::Grammar::LowLevelGrammar
{
	using namespace CppUtils::String::Literals;

	auto _ = testSuite("Language/Lexer/Grammar/lowLevelGrammar") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("empty grammar") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);
			std::println("{}", lowLevelGrammarAst);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: ;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("end") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: end();
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("comment") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					# entry point
					main: ;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("char") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: 'c';
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("is char") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: is('c') 'c';
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("escaped chars") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: "\ \n\t\r\"";
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(" \n\t\r\""sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("add char") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: 'c' add('c');
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('c');
		};

		suite.test("read char") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('c');
		};

		suite.test("token") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: c;
					c: 'c';
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("string") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: word;
					word: "Hello World!";
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("Hello World!"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::empty(outputAst.root.nodes));
		};

		suite.test("recurrence") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: chars;
					chars: char chars; chars: char;
					char: read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAA"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 3uz;
			for (auto i = 0uz; i < 3uz; ++i)
				expect(outputAst.root.nodes[i].value) == static_cast<std::uint64_t>('A');
		};

		suite.test("optional") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: chars;
					chars: char ~chars;
					char: read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAA"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 3uz;
			for (auto i = 0uz; i < 3uz; ++i)
				expect(outputAst.root.nodes[i].value) == static_cast<std::uint64_t>('A');
		};

		suite.test("or") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: or('A', 'B') read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("BC"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('C');
		};

		suite.test("parenthesis") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: ('A' 'B') read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('C');
		};

		suite.test("comparison") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: char;
					char: or(min, maj);
					min: ['a', 'z']+ add(min);
					maj: ['A', 'Z']+ add(maj);
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("C"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == "maj"_token;
		};

		suite.test("hash") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: hash(keyword);
					keyword: read()+ ~keyword;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("variable"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == "variable"_token;
		};

		suite.test("not") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: quote;
					quote: '"' ~quoteContent '"';
					quoteContent: !'"' read()+ ~quoteContent;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(R"("Hello")"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 5uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('H');
			expect(outputAst.root.nodes[1].value) == static_cast<std::uint64_t>('e');
			expect(outputAst.root.nodes[2].value) == static_cast<std::uint64_t>('l');
			expect(outputAst.root.nodes[3].value) == static_cast<std::uint64_t>('l');
			expect(outputAst.root.nodes[4].value) == static_cast<std::uint64_t>('o');
		};

		suite.test("sub") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: node add(';');
					node: read()+ ~sub(node);
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 2uz;
			const auto& aNode = outputAst.root.nodes[0];
			expect(aNode.value) == static_cast<std::uint64_t>('A');
			expect(std::ranges::size(aNode.nodes)) == 1uz;
			const auto& bNode = aNode.nodes[0];
			expect(bNode.value) == static_cast<std::uint64_t>('B');
			expect(std::ranges::size(bNode.nodes)) == 1uz;
			const auto& cNode = bNode.nodes[0];
			expect(cNode.value) == static_cast<std::uint64_t>('C');
			expect(std::ranges::empty(cNode.nodes));
			expect(outputAst.root.nodes[1].value) == static_cast<std::uint64_t>(';');
		};

		suite.test("repeat") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: repeat('A') repeat('B', ',') read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAAB,B,BC"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == static_cast<std::uint64_t>('C');
		};

		suite.test("push-pop") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: push(hash(keyword)) pop();
					keyword: read()+ ~keyword;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == "ABC"_token;
		};

		suite.test("unsigned int") = [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);

			const auto grammarAst = CppUtils::Language::Lexer::parse(R"(
					main: uint;
					uint: add('\0') repeat(digit);
					digit: ['0', '9'] read()+;
				)"sv,
				lowLevelGrammarAst);
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("42"sv, grammarAst);
			std::println("{}", outputAst);

			expect(std::ranges::size(outputAst.root.nodes)) == 1uz;
			expect(outputAst.root.nodes[0].value) == 42uz;
		};
	};
}
