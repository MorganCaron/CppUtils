export module CppUtils.UnitTests.Language.Lexer.Grammar.HighLevelGrammar;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::Lexer::Grammar::HighLevelGrammar
{
	using namespace CppUtils::String::Literals;
	using namespace CppUtils::Language::Lexer::Grammar::Literals;

	auto _ = TestSuite{"Language/Lexer/Grammar/highLevelGrammar", {}, [](TestSuite& suite) {
		using namespace std::literals;

		suite.addTest("empty grammar", [&] {
			const auto lowLevelGrammarAst = CppUtils::Language::Parser::parseAst(CppUtils::Language::Lexer::Grammar::lowLevelGrammarSrc);
			const auto highLevelGrammarAst = CppUtils::Language::Lexer::parse(CppUtils::Language::Lexer::Grammar::highLevelGrammarSrc, lowLevelGrammarAst);
			std::println("{}", highLevelGrammarAst);

			const auto grammarAst = R"(
				main: ;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("end", [&] {
			const auto grammarAst = R"(
				main: end();
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("comment", [&] {
			const auto grammarAst = R"(
				# entry point
				main: ;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(""sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("char", [&] {
			const auto grammarAst = R"(
				main: 'c';
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("is char", [&] {
			const auto grammarAst = R"(
				main: is('c') 'c';
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("escaped chars", [&] {
			const auto grammarAst = R"(
				main: "\ \n\t\r\"";
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(" \n\t\r\""sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("add char", [&] {
			const auto grammarAst = R"(
				main: 'c' add('c');
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('c'));
		});

		suite.addTest("read char", [&] {
			const auto grammarAst = R"(
				main: read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('c'));
		});

		suite.addTest("token", [&] {
			const auto grammarAst = R"(
				main: c;
				c: 'c';
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("c"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("string", [&] {
			const auto grammarAst = R"(
				main: word;
				word: "Hello World!";
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("Hello World!"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expect(std::ranges::empty(outputAst.root.nodes));
		});

		suite.addTest("recurrence", [&] {
			const auto grammarAst = R"(
				main: chars;
				chars: char chars; chars: char;
				char: read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAA"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 3uz);
			for (auto i = 0uz; i < 3uz; ++i)
				suite.expectEqual(outputAst.root.nodes[i].value, static_cast<std::uint64_t>('A'));
		});

		suite.addTest("optional", [&] {
			const auto grammarAst = R"(
				main: chars;
				chars: char ~chars;
				char: read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAA"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 3uz);
			for (auto i = 0uz; i < 3uz; ++i)
				suite.expectEqual(outputAst.root.nodes[i].value, static_cast<std::uint64_t>('A'));
		});

		suite.addTest("or", [&] {
			const auto grammarAst = R"(
				main: or('A', 'B') read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("BC"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('C'));
		});

		suite.addTest("parenthesis", [&] {
			const auto grammarAst = R"(
				main: ('A' 'B') read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('C'));
		});

		suite.addTest("comparison", [&] {
			const auto grammarAst = R"(
				main: char;
				char: or(min, maj);
				min: ['a', 'z']+ add(min);
				maj: ['A', 'Z']+ add(maj);
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("C"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, "maj"_token);
		});

		suite.addTest("hash", [&] {
			const auto grammarAst = R"(
				main: hash(keyword);
				keyword: read()+ ~keyword;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("variable"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, "variable"_token);
		});

		suite.addTest("not", [&] {
			const auto grammarAst = R"(
				main: quote;
				quote: '"' ~quoteContent '"';
				quoteContent: !'"' read()+ ~quoteContent;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse(R"("Hello")"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 5uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('H'));
			suite.expectEqual(outputAst.root.nodes[1].value, static_cast<std::uint64_t>('e'));
			suite.expectEqual(outputAst.root.nodes[2].value, static_cast<std::uint64_t>('l'));
			suite.expectEqual(outputAst.root.nodes[3].value, static_cast<std::uint64_t>('l'));
			suite.expectEqual(outputAst.root.nodes[4].value, static_cast<std::uint64_t>('o'));
		});

		suite.addTest("sub", [&] {
			const auto grammarAst = R"(
				main: node add(';');
				node: read()+ ~sub(node);
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 2uz);
			const auto& aNode = outputAst.root.nodes[0];
			suite.expectEqual(aNode.value, static_cast<std::uint64_t>('A'));
			suite.expectEqual(std::ranges::size(aNode.nodes), 1uz);
			const auto& bNode = aNode.nodes[0];
			suite.expectEqual(bNode.value, static_cast<std::uint64_t>('B'));
			suite.expectEqual(std::ranges::size(bNode.nodes), 1uz);
			const auto& cNode = bNode.nodes[0];
			suite.expectEqual(cNode.value, static_cast<std::uint64_t>('C'));
			suite.expect(std::ranges::empty(cNode.nodes));
			suite.expectEqual(outputAst.root.nodes[1].value, static_cast<std::uint64_t>(';'));
		});

		suite.addTest("repeat", [&] {
			const auto grammarAst = R"(
				main: repeat('A') repeat('B', ',') read()+;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("AAAB,B,BC"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, static_cast<std::uint64_t>('C'));
		});

		suite.addTest("push-pop", [&] {
			const auto grammarAst = R"(
				main: push(hash(keyword)) pop();
				keyword: read()+ ~keyword;
			)"_grammar;
			std::println("{}", grammarAst);
			const auto outputAst = CppUtils::Language::Lexer::parse("ABC"sv, grammarAst);
			std::println("{}", outputAst);

			suite.expectEqual(std::ranges::size(outputAst.root.nodes), 1uz);
			suite.expectEqual(outputAst.root.nodes[0].value, "ABC"_token);
		});
	}};
}
