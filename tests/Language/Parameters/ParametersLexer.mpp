export module CppUtils.UnitTests.Language.Parameters.ParametersLexer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::Parameters::ParametersLexer
{
	struct ProgramSettings final
	{
		bool verbose = false;
		std::string parameter;
	};

	auto _ = testSuite("Language/Parameters/ParametersLexer") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("parseParameters") = [&] {
			const char* const argv[] = {"executable", "--key1=value1", R"(--key2="hello world")", "--key3", "-k=shortValue", "-f"};
			const auto parametersLexer = CppUtils::Language::Parameters::ParametersLexer{};
			const auto parameters = parametersLexer.parseParameters(6, argv);

			expect(std::ranges::size(parameters)) == 5uz;
			expect(parameters.at("key1")) == "value1";
			expect(parameters.at("key2")) == "hello world";
			expect(parameters.at("key3")) == "";
			expect(parameters.at("k")) == "shortValue";
			expect(parameters.at("f")) == "";
		};

		suite.test("parseParameters with CLI flags") = [&] {
			const char* const argv[] = {"executable", "--filter=Network", "--report=junit:build/report.xml", "--fail-fast", "-v"};
			const auto parametersLexer = CppUtils::Language::Parameters::ParametersLexer{};
			const auto parameters = parametersLexer.parseParameters(5, argv);

			expect(std::ranges::size(parameters)) == 4uz;
			expect(parameters.at("filter")) == "Network";
			expect(parameters.at("report")) == "junit:build/report.xml";
			expect(parameters.at("fail-fast")) == "";
			expect(parameters.at("v")) == "";
		};

		suite.test("executeCommands") = [&] {
			const char* const argv[] = {"executable", "--info", "--verbose", "--parameter=value"};
			auto settings = ProgramSettings{};
			const auto parametersLexer = CppUtils::Language::Parameters::ParametersLexer{};
			const auto abort = parametersLexer.executeCommands(4, argv, {{"info", []([[maybe_unused]] auto value) -> bool {
				return false;
			}},
																			{"verbose", [&settings]([[maybe_unused]] auto value) -> bool {
				settings.verbose = true;
				return false;
			}},
																			{"parameter", [&settings]([[maybe_unused]] auto value) -> bool {
				settings.parameter = value;
				return false;
			}}});
			not expect(abort);
			expect(settings.verbose);
			expect(settings.parameter) == "value";
		};
	};
}
