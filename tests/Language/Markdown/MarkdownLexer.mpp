export module CppUtils.UnitTests.Language.Markdown.MarkdownLexer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::Markdown::MarkdownLexer
{
	using namespace CppUtils::String::Literals;
	using namespace CppUtils::Language::Markdown::Literals;

	auto _ = testSuite("Language/Markdown/MarkdownLexer") = [](TestSuite& suite) {
		using namespace std::literals;

		suite.test("Minimalist") = [&] {
			const auto markdownAst = R"(
			# Hello World!
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("h1"_token));
			expect(markdownAst["h1"_token].exists("content"_token));
			expect(std::get<std::string>(markdownAst["h1"_token]["content"_token].nodes.at(0).value)) == "Hello World!";
		};

		suite.test("Format") = [&] {
			const auto markdownAst = R"(
			*italic*
			_italic_
			**bold**
			__bold__
			*__italic and bold__*
			_**italic and bold**_
			__*italic and bold*__
			**_italic and bold_**
			___italic and bold___
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(std::ranges::size(markdownAst.nodes)) == 9uz;
			expect(std::ranges::size(markdownAst.nodes.at(0).nodes)) == 1uz;
			expect(std::get<Type::Token>(markdownAst.nodes.at(0).value)) == "italic"_token;
		};

		suite.test("Title") = [&] {
			const auto markdownAst = R"(
			# H1
			## H2
			### H3
			#### H4
			##### H5
			###### H6
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("h1"_token));
			expect(markdownAst.exists("h2"_token));
			expect(markdownAst.exists("h3"_token));
			expect(markdownAst.exists("h4"_token));
			expect(markdownAst.exists("h5"_token));
			expect(markdownAst.exists("h6"_token));
		};

		suite.test("Checkbox") = [&] {
			const auto markdownAst = R"(
			[ ]
			[x]
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(std::get<Type::Token>(markdownAst.nodes.at(0).value)) == "checkbox"_token;
			expect(std::get<Type::Token>(markdownAst.nodes.at(1).value)) == "checkbox"_token;
			expect(markdownAst.nodes.at(0).nodes.empty());
			expect(markdownAst.nodes.at(1).exists("attributes"_token));
			expect(std::get<Type::Token>(markdownAst.nodes.at(1)["attributes"_token].nodes.at(0).value)) == "checked"_token;
		};

		suite.test("Image") = [&] {
			const auto markdownAst = R"(
			![title](url)
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("image"_token));
			expect(markdownAst["image"_token].exists("attributes"_token));
			const auto& attributes = markdownAst["image"_token]["attributes"_token];
			expect(std::get<std::string>(attributes["alt"_token].nodes.at(0).value)) == "title";
			expect(std::get<std::string>(attributes["src"_token].nodes.at(0).value)) == "url";
		};

		suite.test("Link") = [&] {
			const auto markdownAst = R"(
			[title](url)
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("link"_token));
			expect(markdownAst["link"_token].exists("attributes"_token));
			const auto& attributes = markdownAst["link"_token]["attributes"_token];
			expect(std::get<std::string>(attributes["alt"_token].nodes.at(0).value)) == "title";
			expect(std::get<std::string>(attributes["src"_token].nodes.at(0).value)) == "url";
		};

		suite.test("Code") = [&] {
			const auto markdownAst = R"(
			`const variable = 42;`
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("code"_token));
			expect(markdownAst["code"_token].exists("content"_token));
			expect(std::get<std::string>(markdownAst["code"_token]["content"_token].nodes.at(0).value)) == "const variable = 42;";
		};

		suite.test("Blockcode") = [&] {
			const auto markdownAst = R"(
			```js
			const variable = 42;
			```
			)"_markdown;
			CppUtils::Log::TreeNodeLogger::log(markdownAst);

			expect(markdownAst.exists("blockcode"_token));
			const auto& blockcode = markdownAst["blockcode"_token];
			expect(blockcode.exists("attributes"_token));
			expect(blockcode["attributes"_token].exists("lang"_token));
			expect(std::get<Type::Token>(blockcode["attributes"_token]["lang"_token].nodes.at(0).value)) == "js"_token;
			expect(blockcode.exists("content"_token));
			expect(std::get<std::string>(blockcode["content"_token].nodes.at(0).value)) == "const variable = 42;";
		};
	};
}
