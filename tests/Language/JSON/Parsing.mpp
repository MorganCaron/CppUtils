export module CppUtils.UnitTests.Language.JSON.Parsing;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::JSON::Parsing
{
	auto _ = testSuite("Language/JSON/Parsing").dependsOn("Language/JSON/JsonLexer") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::Language::JSON::Literals;

		suite.test("Simple Parse") = [&] {
			const auto result = "{}"_json;
			expect(result);
			expect(result->isObject());
			expect(std::ranges::empty(result->as<CppUtils::Language::JSON::Object>()));
		};

		suite.test("Parse Values") = [&] {
			const auto result = R"({
				"a": "hello",
				"b": 42,
				"c": 3.14,
				"d": true,
				"e": null
			})"_json;

			expect(result);
			const auto& value = result.value();
			expect(value.isObject());
			expect(value["a"].template as<std::string>()) == "hello";
			expect(value["b"].template as<double>()) == 42.0;
			expect(value["c"].template as<double>()) == 3.14;
			expect(value["d"].template as<bool>());
			expect(value["e"].isNull());
		};

		suite.test("Parse Array") = [&] {
			const auto result = "[1, 2, 3]"_json;

			expect(result);
			const auto& value = result.value();
			expect(value.isArray());
			expect(std::ranges::size(value.as<CppUtils::Language::JSON::Array>())) == 3uz;
			expect(value[0].as<double>()) == 1.0;
		};

		suite.test("Error Reporting") = [&] {
			const auto result = R"({"a": 1, "b"})"_json;
			expect(not result);
			const auto& error = result.error();
			expect(error.message) == "Expected ':' after key";
			expect(error.position) == 12uz;
		};

		suite.test("Stringify") = [&] {
			auto object = CppUtils::Language::JSON::Object{};
			object["a"] = CppUtils::Language::JSON::Value{"hello"};
			object["b"] = CppUtils::Language::JSON::Value{42.0};
			const auto json = static_cast<std::string>(CppUtils::Language::JSON::Value{object});
			expect(json) == R"({"a":"hello","b":42})";
		};

		suite.test("Robustness fuzzing against random input") = [] {
			fuzz("Random string parsing should never crash", 1'000uz, [](auto& fuzzer) {
				const auto randomInput = fuzzer.randomString(0uz, 64uz, "{}[]\":,0123456789truefalsenull \t\n\\/abczABCZ!@#$%^&*()");
				const auto result = CppUtils::Language::JSON::parseJSON(randomInput);
				if (result)
				{
					const auto& value = result.value();
					expect(value.isObject() or value.isArray() or value.isString() or value.isNumber() or value.isBool() or value.isNull());
				}
				else
					expect(not std::ranges::empty(result.error().message));
			});
		};
	};
}
