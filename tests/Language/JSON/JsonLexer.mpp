export module CppUtils.UnitTests.Language.JSON.JsonLexer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::JSON::JsonLexer
{
	using namespace CppUtils::String::Literals;

	auto _ = testSuite("Language/JSON/JsonLexer") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::Language::JSON::Literals;

		suite.test("Empty json") = [&] {
			const auto jsonTree = R"(
			{}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::empty(jsonTree.nodes));
		};

		suite.test("Null") = [&] {
			const auto jsonTree = R"(
			{
				"key": null
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 1uz;
			expect(jsonTree.exists("key"_token));
			const auto& keyNode = jsonTree["key"_token];
			expect(keyNode.exists("null"_token));
		};

		suite.test("Boolean") = [&] {
			const auto jsonTree = R"(
			{
				"bool0": true,
				"bool1": false
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 2uz;
			expect(jsonTree.exists("bool0"_token));
			expect(jsonTree.exists("bool1"_token));
			const auto& bool0Node = jsonTree["bool0"_token];
			const auto& bool1Node = jsonTree["bool1"_token];
			expect(bool0Node.exists("boolean"_token));
			expect(bool1Node.exists("boolean"_token));
			expect(std::get<bool>(bool0Node["boolean"_token].nodes.at(0).value));
			expect(std::get<bool>(bool1Node["boolean"_token].nodes.at(0).value)) == false;
		};

		suite.test("Number") = [&] {
			const auto jsonTree = R"(
			{
				"number0": 42,
				"number1": -21,
				"number2": 3.141592
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 3uz;
			expect(jsonTree.exists("number0"_token));
			expect(jsonTree.exists("number1"_token));
			expect(jsonTree.exists("number2"_token));
			const auto& n0 = jsonTree["number0"_token];
			const auto& n1 = jsonTree["number1"_token];
			const auto& n2 = jsonTree["number2"_token];
			expect(n0.exists("float"_token));
			expect(n1.exists("float"_token));
			expect(n2.exists("float"_token));
			expect(std::get<float>(n0["float"_token].nodes.at(0).value)) == 42.0f;
			expect(std::get<float>(n1["float"_token].nodes.at(0).value)) == -21.0f;
			expect(std::get<float>(n2["float"_token].nodes.at(0).value)) == 3.141592f;
		};

		suite.test("String") = [&] {
			const auto jsonTree = R"(
			{
				"key": "hello"
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 1uz;
			expect(jsonTree.exists("key"_token));
			const auto& keyNode = jsonTree["key"_token];
			expect(keyNode.exists("string"_token));
			expect(std::get<Type::Token>(keyNode["string"_token].nodes.at(0).value)) == "hello"_token;
		};

		suite.test("Array") = [&] {
			const auto jsonTree = R"(
			{
				"key": [1, "abc", true]
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 1uz;
			expect(jsonTree.exists("key"_token));
			const auto& keyNode = jsonTree["key"_token];
			expect(keyNode.exists("array"_token));
			const auto& arrayNode = keyNode["array"_token];
			expect(std::ranges::size(arrayNode.nodes)) == 3uz;
			expect(std::get<Type::Token>(arrayNode.nodes.at(0).value)) == "float"_token;
			expect(std::get<float>(arrayNode.nodes.at(0).nodes.at(0).value)) == 1.0f;
			expect(std::get<Type::Token>(arrayNode.nodes.at(1).value)) == "string"_token;
			expect(std::get<Type::Token>(arrayNode.nodes.at(1).nodes.at(0).value)) == "abc"_token;
			expect(std::get<Type::Token>(arrayNode.nodes.at(2).value)) == "boolean"_token;
			expect(std::get<bool>(arrayNode.nodes.at(2).nodes.at(0).value));
		};

		suite.test("Object") = [&] {
			const auto jsonTree = R"(
			{
				"key": {
					"number0": 0,
					"number1": 1
				}
			}
			)"_json_tree;
			CppUtils::Log::TreeNodeLogger::log(jsonTree);

			expect(std::ranges::size(jsonTree.nodes)) == 1uz;
			expect(jsonTree.exists("key"_token));
			const auto& keyNode = jsonTree["key"_token];
			expect(keyNode.exists("number0"_token));
			expect(keyNode.exists("number1"_token));
		};
	};
}
