export module CppUtils.UnitTests.Language.Ini.IniLexer;

import std;
import CppUtils;

namespace CppUtils::UnitTest::Language::Ini::IniLexer
{
	using namespace CppUtils::String::Literals;

	auto _ = testSuite("Language/Ini/IniLexer").dependsOn("Language/JSON/JsonLexer") = [](TestSuite& suite) {
		using namespace std::literals;
		using namespace CppUtils::Language::Ini::Literals;
		using namespace CppUtils::Language::JSON::Literals;

		suite.test("Minimalist") = [&] {
			const auto iniTree = R"(
			[Section 1]
			key=value
			)"_ini;
			CppUtils::Log::TreeNodeLogger::log(iniTree);

			const auto jsonTree = R"(
			{
				"section": {
					"Section 1": {
						"key": "value"
					}
				}
			}
			)"_json_tree;

			expect(iniTree) == jsonTree;
		};

		suite.test("Number") = [&] {
			const auto iniTree = R"(
			[Numbers]
			pi=3.14
			)"_ini;
			CppUtils::Log::TreeNodeLogger::log(iniTree);

			const auto jsonTree = R"(
			{
				"section": {
					"Numbers": {
						"pi": 3.14
					}
				}
			}
			)"_json_tree;

			expect(iniTree) == jsonTree;
		};

		suite.test("Comments") = [&] {
			const auto iniTree = R"(
			;comment
			[Section 1];comment
			key=value     ;comment
			;comment
			)"_ini;
			CppUtils::Log::TreeNodeLogger::log(iniTree);

			const auto jsonTree = R"(
			{
				"section": {
					"Section 1": {
						"key": "value"
					}
				}
			}
			)"_json_tree;

			expect(iniTree) == jsonTree;
		};

		suite.test("Full") = [&] {
			const auto iniTree = R"(
			[Section 1]
			; comment
			Option 1 = value1 ; option 'Option 1' has value 'value1'
			oPtion 1 = value 2 ; option 'oPtion 1' has value ' value 2'

			[Numbers]
			num = -1285
			num_hex = 0x12ae

			float1 = -124.45667356
			float2 = +4.123E+4
			float3 = 412.3e4
			float4 = -1.1245864E-6

			inf1 = inf
			inf2 = -INFINITY

			[Booleans]
			bool1 = true
			bool2 = false
			)"_ini;
			CppUtils::Log::TreeNodeLogger::log(iniTree);

			const auto jsonTree = R"(
			{
				"section": {
					"Section 1": {
						"Option 1": "value1",
						"oPtion 1": "value 2"
					}
				}
			}
			)"_json_tree;

			expect(std::ranges::size(iniTree.nodes)) == 3uz;
			expect(iniTree.nodes.at(0)) == jsonTree.nodes.at(0);
			expect(std::ranges::size(iniTree.nodes.at(1)["Numbers"_token].nodes)) == 8uz;
			expect(std::ranges::size(iniTree.nodes.at(2)["Booleans"_token].nodes)) == 2uz;
		};
	};
}
