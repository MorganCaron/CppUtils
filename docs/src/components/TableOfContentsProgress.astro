<script>
	function setupTableOfContentsProgress() {
		const tableOfContentsElements =
			document.querySelectorAll("starlight-toc");
		if (tableOfContentsElements.length === 0) {
			return;
		}

		tableOfContentsElements.forEach((tableOfContentsElement) => {
			let progressContainer =
				tableOfContentsElement.querySelector<HTMLElement>(
					".toc-progress",
				);
			const headingElement = tableOfContentsElement.querySelector("h2");
			if (!progressContainer) {
				if (headingElement) {
					progressContainer = document.createElement("div");
					progressContainer.className = "toc-progress";
					progressContainer.setAttribute("aria-hidden", "true");

					const progressBar = document.createElement("span");
					progressBar.className = "toc-progress-bar";
					progressContainer.appendChild(progressBar);

					headingElement.insertAdjacentElement(
						"afterend",
						progressContainer,
					);
				}
			}

			const scrollContainer = tableOfContentsElement.querySelector(
				"nav > ul",
			) as HTMLElement | null;
			const forwardWheel = (event: WheelEvent) => {
				if (scrollContainer) {
					scrollContainer.scrollTop += event.deltaY;
				}
			};
			headingElement?.addEventListener("wheel", forwardWheel, {
				passive: true,
			});
			progressContainer?.addEventListener("wheel", forwardWheel, {
				passive: true,
			});
		});

		let isAutoScrollScheduled = false;
		const autoScrollActiveHeading = (
			tableOfContentsElement: Element,
			activeLinkElement: HTMLElement,
		) => {
			if (isAutoScrollScheduled) return;
			isAutoScrollScheduled = true;
			requestAnimationFrame(() => {
				isAutoScrollScheduled = false;
				const scrollContainer = (tableOfContentsElement.querySelector(
					"nav > ul",
				) ||
					tableOfContentsElement.querySelector("nav") ||
					tableOfContentsElement.closest(
						".right-sidebar",
					)) as HTMLElement | null;
				if (!scrollContainer || !activeLinkElement) return;
				const sidebar = tableOfContentsElement.closest(
					".right-sidebar",
				) as HTMLElement | null;
				if (sidebar?.matches(":hover")) {
					return;
				}

				const containerRect = scrollContainer.getBoundingClientRect();
				const linkRect = activeLinkElement.getBoundingClientRect();

				const topMargin = 40;
				const bottomMargin = 40;

				const linkTop = linkRect.top - containerRect.top;
				const linkBottom = linkRect.bottom - containerRect.top;

				if (linkTop < topMargin) {
					scrollContainer.scrollTo({
						top: Math.max(
							0,
							scrollContainer.scrollTop + linkTop - topMargin,
						),
						behavior: "smooth",
					});
				} else if (linkBottom > containerRect.height - bottomMargin) {
					scrollContainer.scrollTo({
						top:
							scrollContainer.scrollTop +
							linkBottom -
							(containerRect.height - bottomMargin),
						behavior: "smooth",
					});
				}
			});
		};

		const updateActivePaths = () => {
			tableOfContentsElements.forEach((tableOfContentsElement) => {
				const activeLinkElement = tableOfContentsElement.querySelector(
					'a[aria-current="true"]',
				) as HTMLElement | null;
				tableOfContentsElement
					.querySelectorAll("li.active-path")
					.forEach((element) => {
						element.classList.remove("active-path");
					});
				if (activeLinkElement) {
					let parentElement = activeLinkElement.parentElement;
					while (
						parentElement &&
						parentElement !== tableOfContentsElement
					) {
						if (parentElement.tagName === "LI") {
							parentElement.classList.add("active-path");
						}
						parentElement = parentElement.parentElement;
					}
					autoScrollActiveHeading(
						tableOfContentsElement,
						activeLinkElement,
					);
				}
			});
		};

		const updateScrollProgress = () => {
			const scrollableDistance =
				document.documentElement.scrollHeight - window.innerHeight;
			const scrollFraction =
				scrollableDistance > 0
					? Math.max(
							0,
							Math.min(1, window.scrollY / scrollableDistance),
						)
					: 0;
			const progressBars = document.querySelectorAll<HTMLElement>(
				"starlight-toc .toc-progress-bar",
			);
			progressBars.forEach((progressBar) => {
				progressBar.style.transform = `scaleX(${scrollFraction})`;
			});
		};

		let isProgressUpdateScheduled = false;
		const handleScrollOrResize = () => {
			if (isProgressUpdateScheduled) {
				return;
			}
			isProgressUpdateScheduled = true;
			requestAnimationFrame(() => {
				isProgressUpdateScheduled = false;
				updateScrollProgress();
			});
		};

		const existingCleanupFunction = (
			window as unknown as { _tableOfContentsCleanup?: () => void }
		)._tableOfContentsCleanup;
		if (existingCleanupFunction) {
			existingCleanupFunction();
		}

		window.addEventListener("scroll", handleScrollOrResize, {
			passive: true,
		});
		window.addEventListener("resize", handleScrollOrResize, {
			passive: true,
		});
		window.addEventListener("load", updateScrollProgress);

		const mutationObservers: MutationObserver[] = [];
		tableOfContentsElements.forEach((tableOfContentsElement) => {
			const mutationObserver = new MutationObserver(() => {
				updateActivePaths();
			});
			mutationObserver.observe(tableOfContentsElement, {
				attributes: true,
				subtree: true,
				attributeFilter: ["aria-current"],
			});
			mutationObservers.push(mutationObserver);
		});

		(
			window as unknown as { _tableOfContentsCleanup?: () => void }
		)._tableOfContentsCleanup = () => {
			window.removeEventListener("scroll", handleScrollOrResize);
			window.removeEventListener("resize", handleScrollOrResize);
			window.removeEventListener("load", updateScrollProgress);
			mutationObservers.forEach((observer) => observer.disconnect());
		};

		updateScrollProgress();
		updateActivePaths();
	}

	if (document.readyState === "loading") {
		document.addEventListener(
			"DOMContentLoaded",
			setupTableOfContentsProgress,
		);
	} else {
		setupTableOfContentsProgress();
	}
	document.addEventListener("astro:page-load", setupTableOfContentsProgress);
</script>
