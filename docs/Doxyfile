PROJECT_NAME = "CppUtils"
INPUT = ../modules ../include
RECURSIVE = YES
FILE_PATTERNS = *.mpp *.hpp
EXTENSION_MAPPING = mpp=C++
EXCLUDE_PATTERNS = */tests/* */old/*
GENERATE_XML = YES
XML_OUTPUT = doxygen_xml
GENERATE_HTML = NO
GENERATE_LATEX = NO
JAVADOC_AUTOBRIEF = YES
EXTRACT_ALL = YES
EXTRACT_STATIC = YES
EXTRACT_PRIVATE = NO
QUIET = YES
WARNINGS = NO
